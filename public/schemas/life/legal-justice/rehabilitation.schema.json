{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rehabilitation",
  "description": "A rehabilitation record — programmes, interventions, and progress toward reintegration into society.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^rehabilitation_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "sentence_id": { "type": "string" },
    "probation_id": { "type": "string" },
    "programme_name": { "type": "string" },
    "programme_type": {
      "type": "string",
      "enum": ["offending_behaviour", "substance_misuse", "mental_health", "education_skills", "employment_support", "housing_support", "domestic_violence_perpetrator", "sex_offender_treatment", "thinking_skills", "other"]
    },
    "provider": { "type": "string" },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "completion_status": { "type": "string", "enum": ["not_started", "in_progress", "completed", "incomplete", "did_not_engage"] },
    "outcome_assessment": { "type": "string" },
    "risk_reduction_noted": { "type": "boolean" },
    "sensitivity_level": { "type": "string", "const": "highly_restricted" },
    "sensitivity_id": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "programme_name", "programme_type"],
  "_phase1_todo": [
    "Define accredited programme register",
    "Define rehabilitation progress reporting",
    "Define parole board report integration",
    "Define employment/housing post-release coordination"
  ]
}
