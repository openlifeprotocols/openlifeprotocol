{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sentence",
  "description": "A criminal sentence — the punishment imposed following a conviction.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^sentence_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "conviction_id": { "type": "string" },
    "court_case_id": { "type": "string" },
    "sentence_date": { "type": "string", "format": "date" },
    "sentence_type": { "type": "string", "enum": ["absolute_discharge", "conditional_discharge", "fine", "community_order", "suspended_sentence", "youth_sentence", "custodial_sentence", "extended_sentence", "life_sentence", "other"] },
    "custodial": { "type": "boolean" },
    "custodial_length_months": { "type": "integer" },
    "custodial_facility": { "type": "string" },
    "release_date": { "type": "string", "format": "date" },
    "licence_expiry": { "type": "string", "format": "date" },
    "community_requirements": { "type": "array", "items": { "type": "string" } },
    "unpaid_work_hours": { "type": "integer" },
    "fine_amount": { "type": "number" },
    "currency": { "type": "string" },
    "ancillary_orders": {
      "type": "array",
      "items": { "type": "string", "enum": ["restraining_order", "sex_offender_register", "disqualification_driving", "asbo", "scpo", "deprivation", "other"] }
    },
    "sensitivity_level": { "type": "string", "const": "highly_restricted" },
    "sensitivity_id": { "type": "string" },
    "access_control_id": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "completed", "appealing", "reduced_on_appeal", "suspended"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "conviction_id", "sentence_date", "sentence_type"],
  "_phase1_todo": [
    "Define half-time release calculation",
    "Define licence conditions tracking",
    "Define tag/curfew monitoring",
    "Define rehabilitation programme linkage"
  ]
}
