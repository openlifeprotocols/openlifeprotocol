{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product",
  "description": "A physical or digital product offered for sale or used in production.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^product_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "external_ids": {
      "type": "array",
      "items": { "type": "object", "properties": { "system": { "type": "string" }, "id": { "type": "string" } }, "required": ["system", "id"] }
    },
    "owner_id": { "type": "string" },
    "name": { "type": "string" },
    "sku": { "type": "string" },
    "barcode": { "type": "string" },
    "description": { "type": "string" },
    "product_type": { "type": "string", "enum": ["physical", "digital", "consumable", "component", "finished_good", "raw_material"] },
    "category": { "type": "string" },
    "unit_of_measure": { "type": "string", "examples": ["each", "kg", "litre", "metre", "m2", "m3"] },
    "unit_cost": { "type": "number" },
    "unit_price": { "type": "number" },
    "currency": { "type": "string" },
    "weight_kg": { "type": "number" },
    "dimensions": {
      "type": "object",
      "properties": {
        "length_mm": { "type": "number" },
        "width_mm": { "type": "number" },
        "height_mm": { "type": "number" }
      }
    },
    "supplier_ids": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["active", "discontinued", "draft"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "name", "product_type", "unit_of_measure"],
  "_phase1_todo": [
    "Define product variants",
    "Define product BOM linking",
    "Define product lifecycle stages",
    "Define product compliance and certifications"
  ]
}
