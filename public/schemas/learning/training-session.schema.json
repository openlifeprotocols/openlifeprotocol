{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Training Session",
  "description": "A single training session — workshop, seminar, lecture — discrete learning event with instructor.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^training_session_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "instructor": { "type": "string" },
    "instructor_organization": { "type": "string" },
    "session_date": { "type": "string", "format": "date" },
    "start_time": { "type": "string", "format": "time" },
    "end_time": { "type": "string", "format": "time" },
    "duration_minutes": { "type": "integer" },
    "format": { "type": "string", "enum": ["in_person", "online", "hybrid", "recorded"] },
    "location": { "type": "string" },
    "attendance_status": { "type": "string", "enum": ["attended", "no_show", "partial", "remote"] },
    "session_type": { "type": "string", "enum": ["workshop", "seminar", "lecture", "webinar", "retreat", "conference", "meetup"] },
    "topics_covered": { "type": "array", "items": { "type": "string" } },
    "certification_url": { "type": "string", "format": "uri" },
    "key_takeaways": { "type": "string" },
    "network_contacts": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "title", "session_date"],
  "_phase1_todo": [
    "Define training session outcome tracking",
    "Define networking graph from co-attendees",
    "Define skill application post-training"
  ]
}
