{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vault Entry",
  "description": "Secure vault entry for passwords, keys, or secrets.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^vault_entry_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "entry_name": { "type": "string" },
    "entry_type": { "type": "string", "enum": ["password", "api_key", "private_key", "certificate", "token", "secret", "other"] },
    "username": { "type": "string" },
    "email": { "type": "string" },
    "url": { "type": "string", "format": "uri" },
    "encrypted_value": { "type": "string" },
    "encryption_algorithm": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "last_modified": { "type": "string", "format": "date-time" },
    "last_used": { "type": "string", "format": "date-time" },
    "expiration_date": { "type": "string", "format": "date" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "favorite": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define password generation", "Define strength testing", "Define breach monitoring"]
}
