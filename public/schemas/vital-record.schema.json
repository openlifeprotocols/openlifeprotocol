{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vital Record",
  "description": "Generic vital record document (death certificate, marriage certificate, etc).",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^vital_record_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "record_type": { "type": "string", "enum": ["death_certificate", "marriage_certificate", "divorce_decree", "adoption_record", "certificate_of_naturalization", "other"] },
    "record_number": { "type": "string" },
    "issuance_date": { "type": "string", "format": "date" },
    "issuance_jurisdiction": { "type": "string" },
    "related_person_id": { "type": "string" },
    "related_person_name": { "type": "string" },
    "event_date": { "type": "string", "format": "date" },
    "event_location": { "type": "string" },
    "certified_copy": { "type": "boolean" },
    "certification_date": { "type": "string", "format": "date" },
    "document_id": { "type": "string" },
    "verification_status": { "type": "string", "enum": ["not_verified", "pending", "verified", "expired"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "record_type"],
  "_phase1_todo": ["Define vital record verification", "Define relationship linking", "Define genealogy integration"]
}
