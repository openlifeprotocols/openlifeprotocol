{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Appliance",
  "description": "Household appliance inventory and warranty.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^appliance_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "household_id": { "type": "string" },
    "appliance_name": { "type": "string" },
    "appliance_type": { "type": "string", "enum": ["refrigerator", "washing_machine", "dryer", "dishwasher", "oven", "microwave", "air_conditioner", "heater", "water_heater", "television", "other"] },
    "brand": { "type": "string" },
    "model": { "type": "string" },
    "serial_number": { "type": "string" },
    "purchase_date": { "type": "string", "format": "date" },
    "purchase_price": { "type": "number" },
    "currency": { "type": "string" },
    "location_in_home": { "type": "string" },
    "warranty_expiration": { "type": "string", "format": "date" },
    "warranty_document_id": { "type": "string" },
    "manual_document_id": { "type": "string" },
    "last_serviced": { "type": "string", "format": "date" },
    "condition": { "type": "string", "enum": ["excellent", "good", "fair", "poor", "needs_repair"] },
    "is_covered_by_home_insurance": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "household_id"],
  "_phase1_todo": ["Define maintenance scheduling", "Define warranty claims", "Define depreciation tracking"]
}
