{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "License",
  "description": "Licensing agreement for intellectual property.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^license_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "intellectual_property_id": { "type": "string" },
    "licensee_name": { "type": "string" },
    "license_type": { "type": "string", "enum": ["exclusive", "non_exclusive", "sole", "limited", "worldwide", "territorial"] },
    "territory": { "type": "string" },
    "grant_date": { "type": "string", "format": "date" },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "term_length_years": { "type": "integer" },
    "renewable": { "type": "boolean" },
    "renewal_terms": { "type": "string" },
    "license_fee": { "type": "number" },
    "currency": { "type": "string" },
    "royalty_percentage": { "type": "number" },
    "minimum_royalty": { "type": "number" },
    "upfront_payment": { "type": "number" },
    "milestone_payments": { "type": "object", "additionalProperties": { "type": "number" } },
    "field_of_use": { "type": "string" },
    "sublicense_allowed": { "type": "boolean" },
    "quality_control_required": { "type": "boolean" },
    "status": { "type": "string", "enum": ["active", "expired", "terminated", "suspended"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "intellectual_property_id", "licensee_name"],
  "_phase1_todo": [
    "Define license compliance tracking",
    "Define sublicense approval workflow",
    "Define license renewal management"
  ]
}
