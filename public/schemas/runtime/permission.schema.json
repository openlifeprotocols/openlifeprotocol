{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Permission",
  "description": "Access permission or role granted to an actor for a resource or action. Manages access control and authorization.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^permission_[a-zA-Z0-9_-]+$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "external_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "system": { "type": "string" },
          "id": { "type": "string" },
          "type": { "type": "string" }
        },
        "required": ["system", "id"]
      }
    },
    "actor_id": { "type": "string" },
    "resource_type": {
      "type": "string",
      "enum": ["case", "workflow", "document", "communication", "payment", "report"],
      "description": "Type of resource"
    },
    "resource_id": {
      "type": "string",
      "description": "Specific resource (or * for all)"
    },
    "action": {
      "type": "string",
      "enum": ["read", "write", "delete", "approve", "execute", "admin"],
      "description": "Permitted action"
    },
    "scope": {
      "type": "string",
      "enum": ["own", "team", "organisation", "global"],
      "description": "Scope of permission"
    },
    "granted_by_actor_id": { "type": "string" },
    "granted_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time",
      "description": "When permission expires"
    },
    "conditions": {
      "type": "array",
      "description": "Additional conditions (e.g., only during business hours)",
      "items": { "type": "string" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["id", "uuid", "actor_id", "resource_type", "action"],
  "_phase1_todo": [
    "Define role-based access control (RBAC)",
    "Define attribute-based access control (ABAC)",
    "Define permission inheritance and delegation",
    "Define permission revocation and audit",
    "Define permission conflict resolution",
    "Define least privilege principles"
  ]
}
