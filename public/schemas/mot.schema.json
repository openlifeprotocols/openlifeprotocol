{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MOT",
  "description": "Ministry of Transport (MOT) test certificate.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^mot_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "vehicle_id": { "type": "string" },
    "registration_number": { "type": "string" },
    "vin": { "type": "string" },
    "test_date": { "type": "string", "format": "date" },
    "expiration_date": { "type": "string", "format": "date" },
    "mot_status": { "type": "string", "enum": ["passed", "failed", "not_applicable"] },
    "test_type": { "type": "string", "enum": ["first_test", "annual_test", "retake"] },
    "mileage_at_test": { "type": "integer" },
    "testing_station": { "type": "string" },
    "test_certificate_number": { "type": "string" },
    "test_class": { "type": "string" },
    "defects_found": { "type": "array", "items": { "type": "object", "properties": { "defect_type": { "type": "string" }, "description": { "type": "string" }, "severity": { "type": "string" } } } },
    "emissions_test": { "type": "boolean" },
    "emissions_result": { "type": "string" },
    "certificate_document_id": { "type": "string" },
    "is_current": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "vehicle_id"],
  "_phase1_todo": ["Define MOT renewal alerts", "Define defect tracking", "Define emissions compliance"]
}
