{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brand Deal",
  "description": "A brand partnership or collaboration on social media.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^brand_deal_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "social_account_id": { "type": "string" },
    "brand_name": { "type": "string" },
    "deal_type": { "type": "string", "enum": ["sponsored_post", "brand_ambassador", "affiliate", "co_creation", "product_placement"] },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "compensation": { "type": "number" },
    "compensation_currency": { "type": "string" },
    "content_requirements": { "type": "string" },
    "minimum_engagement": { "type": "number" },
    "exclusivity_clause": { "type": "boolean" },
    "content_approval_required": { "type": "boolean" },
    "disclosure_required": { "type": "boolean" },
    "status": { "type": "string", "enum": ["negotiating", "active", "completed", "cancelled"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "social_account_id", "brand_name", "deal_type"],
  "_phase1_todo": [
    "Define brand deal compliance tracking",
    "Define brand deal performance measurement",
    "Define brand deal negotiation support"
  ]
}
