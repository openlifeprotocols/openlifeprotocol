{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Favorite Film",
  "description": "Personal favorite film or TV show.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^favorite_film_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "content_id": { "type": "string" },
    "content_type": { "type": "string", "enum": ["movie", "tv_show"] },
    "title": { "type": "string" },
    "rank": { "type": "integer" },
    "reason_favorite": { "type": "string" },
    "discovery_year": { "type": "integer" },
    "discovery_method": { "type": "string" },
    "times_watched": { "type": "integer" },
    "last_watched_date": { "type": "string", "format": "date" },
    "iconic_scenes": { "type": "array", "items": { "type": "string" } },
    "favorite_quotes": { "type": "array", "items": { "type": "string" } },
    "soundtrack_score": { "type": "number", "minimum": 1, "maximum": 5 },
    "cinematography_score": { "type": "number", "minimum": 1, "maximum": 5 },
    "story_score": { "type": "number", "minimum": 1, "maximum": 5 },
    "acting_score": { "type": "number", "minimum": 1, "maximum": 5 },
    "merchandise_owned": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "title"],
  "_phase1_todo": ["Define ranking system", "Define impact tracking", "Define discovery insights"]
}
