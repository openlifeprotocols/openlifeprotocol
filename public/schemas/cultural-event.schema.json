{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cultural Event",
  "description": "Cultural event or festival.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^cultural_event_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "event_name": { "type": "string" },
    "event_type": { "type": "string", "enum": ["festival", "exhibition", "performance", "parade", "celebration", "conference", "other"] },
    "culture_represented": { "type": "string" },
    "event_date": { "type": "string", "format": "date" },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "location": { "type": "string" },
    "location_coordinates": { "type": "object", "properties": { "latitude": { "type": "number" }, "longitude": { "type": "number" } } },
    "admission_price": { "type": "number" },
    "attended": { "type": "boolean" },
    "visit_date": { "type": "string", "format": "date" },
    "duration_hours": { "type": "number" },
    "companions": { "type": "array", "items": { "type": "string" } },
    "highlights": { "type": "array", "items": { "type": "string" } },
    "food_tasted": { "type": "array", "items": { "type": "string" } },
    "performances_seen": { "type": "array", "items": { "type": "string" } },
    "cultural_insights": { "type": "string" },
    "overall_rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "would_attend_again": { "type": "boolean" },
    "merchandise_purchased": { "type": "array", "items": { "type": "string" } },
    "photos_taken": { "type": "boolean" },
    "notes": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "event_name"],
  "_phase1_todo": ["Define event calendar", "Define cultural discovery", "Define tourism tracking"]
}
