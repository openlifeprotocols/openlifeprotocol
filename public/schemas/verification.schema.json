{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification",
  "description": "Record of verification or validation performed on an entity (identity, document, claim, etc.). Tracks who verified it, when, and result.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^verification_[a-zA-Z0-9_-]+$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "external_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "system": { "type": "string" },
          "id": { "type": "string" },
          "type": { "type": "string" }
        },
        "required": ["system", "id"]
      }
    },
    "entity_id": { "type": "string" },
    "entity_type": {
      "type": "string",
      "enum": ["identity", "document", "address", "claim", "data_point", "actor"],
      "description": "What was verified"
    },
    "verification_type": {
      "type": "string",
      "enum": ["manual_review", "automated_check", "third_party", "document_scan", "biometric", "interview"],
      "description": "Method of verification"
    },
    "result": {
      "type": "string",
      "enum": ["verified", "not_verified", "partially_verified", "requires_review", "failed"],
      "description": "Verification result"
    },
    "verified_by_actor_id": { "type": "string" },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verification_source": {
      "type": "string",
      "description": "Where verification was done (external service, manual review, etc.)"
    },
    "notes": {
      "type": "string"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "When verification expires (if applicable)"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["id", "uuid", "entity_id", "entity_type", "verification_type", "result"],
  "_phase1_todo": [
    "Define verification provider integrations",
    "Define verification confidence scoring",
    "Define verification fraud detection",
    "Define verification caching and TTL",
    "Define verification exception handling",
    "Define verification audit requirements"
  ]
}
