{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reading Session",
  "description": "Record of a reading session.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^reading_session_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "book_id": { "type": "string" },
    "book_title": { "type": "string" },
    "author_name": { "type": "string" },
    "reading_date": { "type": "string", "format": "date" },
    "start_time": { "type": "string", "format": "time" },
    "duration_minutes": { "type": "integer" },
    "pages_read": { "type": "integer" },
    "current_page": { "type": "integer" },
    "total_pages": { "type": "integer" },
    "progress_percentage": { "type": "number", "minimum": 0, "maximum": 100 },
    "location": { "type": "string" },
    "format": { "type": "string", "enum": ["physical_book", "ebook", "audiobook", "other"] },
    "mood_before": { "type": "string" },
    "mood_after": { "type": "string" },
    "engagement_level": { "type": "integer", "minimum": 1, "maximum": 10 },
    "distractions": { "type": "string" },
    "favorite_quotes": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "book_title"],
  "_phase1_todo": ["Define reading stats", "Define progress tracking", "Define engagement analysis"]
}
