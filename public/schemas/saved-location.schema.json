{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Saved Location",
  "description": "Saved map locations and waypoints.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^saved_location_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "location_label": { "type": "string" },
    "latitude": { "type": "number" },
    "longitude": { "type": "number" },
    "accuracy_meters": { "type": "number" },
    "map_service": { "type": "string", "enum": ["google_maps", "apple_maps", "openstreetmap", "other"] },
    "map_url": { "type": "string", "format": "uri" },
    "address_components": { "type": "object", "properties": { "street": { "type": "string" }, "city": { "type": "string" }, "state": { "type": "string" }, "zip": { "type": "string" }, "country": { "type": "string" } } },
    "place_type": { "type": "string" },
    "display_address": { "type": "string" },
    "is_home": { "type": "boolean" },
    "is_work": { "type": "boolean" },
    "is_favorite": { "type": "boolean" },
    "visit_count": { "type": "integer" },
    "last_visited_date": { "type": "string", "format": "date-time" },
    "average_stay_minutes": { "type": "integer" },
    "category_tags": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "latitude", "longitude"],
  "_phase1_todo": ["Define location clustering", "Define routine detection", "Define location recommendations"]
}
