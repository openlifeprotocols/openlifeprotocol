{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Book Collection",
  "description": "Personal book collection or library.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^book_collection_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "collection_name": { "type": "string" },
    "description": { "type": "string" },
    "total_books": { "type": "integer" },
    "physical_books": { "type": "integer" },
    "ebook_count": { "type": "integer" },
    "audiobook_count": { "type": "integer" },
    "total_pages": { "type": "integer" },
    "genres_represented": { "type": "array", "items": { "type": "string" } },
    "authors_count": { "type": "integer" },
    "estimated_value": { "type": "number" },
    "currency": { "type": "string" },
    "storage_locations": { "type": "array", "items": { "type": "string" } },
    "collection_status": { "type": "string", "enum": ["active", "dormant", "archived"] },
    "acquisition_period_start": { "type": "string", "format": "date" },
    "acquisition_period_end": { "type": "string", "format": "date" },
    "insurance_value": { "type": "number" },
    "rare_books": { "type": "array", "items": { "type": "string" } },
    "signed_editions": { "type": "integer" },
    "first_editions": { "type": "integer" },
    "reading_goal_books_per_year": { "type": "integer" },
    "books_read_this_year": { "type": "integer" },
    "notes": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "collection_name"],
  "_phase1_todo": ["Define collection inventory", "Define reading goals", "Define collection analytics"]
}
