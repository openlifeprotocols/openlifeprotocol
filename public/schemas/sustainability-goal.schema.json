{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sustainability Goal",
  "description": "Personal sustainability or environmental goal.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^sustainability_goal_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "goal_name": { "type": "string" },
    "goal_category": { "type": "string", "enum": ["energy_reduction", "waste_reduction", "water_conservation", "transportation", "diet_change", "consumption", "other"] },
    "description": { "type": "string" },
    "target_date": { "type": "string", "format": "date" },
    "baseline_measurement": { "type": "string" },
    "target_measurement": { "type": "string" },
    "progress_to_date": { "type": "string" },
    "percentage_complete": { "type": "number", "minimum": 0, "maximum": 100 },
    "actions_being_taken": { "type": "array", "items": { "type": "string" } },
    "resources_needed": { "type": "array", "items": { "type": "string" } },
    "estimated_impact": { "type": "string" },
    "co2_equivalent_reduction": { "type": "number" },
    "cost_of_implementation": { "type": "number" },
    "financial_savings_expected": { "type": "number" },
    "difficulty_level": { "type": "string", "enum": ["easy", "moderate", "challenging", "very_challenging"] },
    "accountability_partner": { "type": "string" },
    "challenges": { "type": "array", "items": { "type": "string" } },
    "motivations": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "goal_name"],
  "_phase1_todo": ["Define goal tracking", "Define impact measurement", "Define progress alerts"]
}
