{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inspection",
  "description": "A formal inspection of a property, building, or construction — structural, regulatory, insurance, or quality.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^inspection_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "property_id": { "type": "string" },
    "construction_project_id": { "type": "string" },
    "inspector_id": { "type": "string" },
    "inspection_type": { "type": "string", "enum": ["building_control", "structural", "homebuyer_survey", "full_structural_survey", "fire_risk", "gas_safety", "electrical", "epc", "asbestos", "snagging", "insurance", "cqc", "other"] },
    "scheduled_date": { "type": "string", "format": "date" },
    "completed_date": { "type": "string", "format": "date" },
    "result": { "type": "string", "enum": ["pass", "fail", "conditional_pass", "advisory", "not_completed"] },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": { "type": "string", "enum": ["urgent", "major", "minor", "advisory"] },
          "description": { "type": "string" },
          "location": { "type": "string" },
          "remediation_required": { "type": "boolean" }
        }
      }
    },
    "certificate_id": { "type": "string" },
    "certificate_expiry": { "type": "string", "format": "date" },
    "next_inspection_due": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["scheduled", "in_progress", "complete", "overdue", "cancelled"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "inspection_type", "scheduled_date"],
  "_phase1_todo": [
    "Define mandatory inspection schedules",
    "Define inspection certificate tracking",
    "Define overdue inspection escalation",
    "Define inspection defect remediation workflow"
  ]
}
