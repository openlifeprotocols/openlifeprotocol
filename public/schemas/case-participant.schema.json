{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Case Participant",
  "description": "Represents an actor's participation in a case with their role, permissions, and responsibilities.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^participant_[a-zA-Z0-9_-]+$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "external_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "system": { "type": "string" },
          "id": { "type": "string" },
          "type": { "type": "string" }
        },
        "required": ["system", "id"]
      }
    },
    "case_id": { "type": "string" },
    "actor_id": { "type": "string" },
    "role": {
      "type": "string",
      "enum": ["principal", "executor", "beneficiary", "representative", "solicitor", "manager", "approver", "observer", "other"],
      "description": "Actor's role in the case"
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive", "removed", "pending_approval"],
      "description": "Participation status"
    },
    "joined_date": {
      "type": "string",
      "format": "date-time"
    },
    "left_date": {
      "type": "string",
      "format": "date-time"
    },
    "permissions": {
      "type": "array",
      "description": "Specific permissions for this participant",
      "items": { "type": "string" }
    },
    "notifications_enabled": {
      "type": "boolean"
    },
    "access_level": {
      "type": "string",
      "enum": ["read", "read_write", "full_access"],
      "description": "Level of access to case"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["id", "uuid", "case_id", "actor_id", "role"],
  "_phase1_todo": [
    "Define participant invitation and acceptance workflow",
    "Define participant permission scopes",
    "Define participant conflict of interest detection",
    "Define participant succession planning",
    "Define participant activity audit trail",
    "Define participant removal procedures"
  ]
}
