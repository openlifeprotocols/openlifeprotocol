{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theatre Show",
  "description": "Theatre or stage show.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^theatre_show_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "show_title": { "type": "string" },
    "theatrical_production": { "type": "string" },
    "playwright": { "type": "string" },
    "director": { "type": "string" },
    "cast_members": { "type": "array", "items": { "type": "string" } },
    "theatre_name": { "type": "string" },
    "location": { "type": "string" },
    "genre": { "type": "string", "enum": ["comedy", "drama", "tragedy", "musical", "experimental", "classic", "contemporary", "other"] },
    "premiere_date": { "type": "string", "format": "date" },
    "run_end_date": { "type": "string", "format": "date" },
    "performance_count": { "type": "integer" },
    "rating": { "type": "number", "minimum": 0, "maximum": 10 },
    "user_rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "description": { "type": "string" },
    "theme": { "type": "string" },
    "runtime_minutes": { "type": "integer" },
    "language": { "type": "string" },
    "content_warning": { "type": "string" },
    "favorite": { "type": "boolean" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "show_title"],
  "_phase1_todo": ["Define show attendance", "Define ticket tracking", "Define theatre favorites"]
}
