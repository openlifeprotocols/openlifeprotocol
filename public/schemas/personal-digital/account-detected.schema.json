{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Account Detected",
  "description": "An online account detected from email history, password manager export, or app store — automatically discovered to build a complete digital inventory.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^account_detected_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "detection_source": { "type": "string", "enum": ["email_scan", "password_manager_export", "app_store_ios", "app_store_android", "browser_history", "manual"] },
    "service_name": { "type": "string" },
    "service_url": { "type": "string", "format": "uri" },
    "email_used": { "type": "string", "format": "email" },
    "service_category": { "type": "string", "enum": ["email", "social_media", "banking", "shopping", "streaming", "government_portal", "cloud_storage", "communication", "work", "gaming", "health", "travel", "news", "other"] },
    "first_seen_date": { "type": "string", "format": "date" },
    "last_seen_date": { "type": "string", "format": "date" },
    "signup_email_detected": { "type": "boolean" },
    "has_active_subscription": { "type": "boolean" },
    "has_personal_data": { "type": "boolean", "description": "Likely holds personal data (photos, messages, financial history)" },
    "has_financial_value": { "type": "boolean" },
    "linked_online_account_id": { "type": "string", "description": "Confirmed link to digital-life/online-account.schema.json" },
    "linked_subscription_detected_id": { "type": "string" },
    "is_confirmed": { "type": "boolean" },
    "death_action": { "type": "string", "enum": ["delete", "memorialize", "transfer", "download_data", "unknown"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "detection_source", "service_name"],
  "_phase1_todo": [
    "Define account deduplication across sources",
    "Define Right to Erasure (GDPR Art 17) request automation",
    "Define data download request workflow",
    "Define estate digital inventory report"
  ]
}
