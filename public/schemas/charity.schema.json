{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Charity",
  "description": "Charitable organization record.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^charity_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "charity_name": { "type": "string" },
    "charity_registration_number": { "type": "string" },
    "charity_type": { "type": "string", "enum": ["health", "education", "poverty", "environment", "animal_welfare", "arts", "research", "other"] },
    "website": { "type": "string", "format": "uri" },
    "contact_email": { "type": "string", "format": "email" },
    "contact_phone": { "type": "string" },
    "mission_statement": { "type": "string" },
    "annual_donation_amount": { "type": "number" },
    "total_donated": { "type": "number" },
    "currency": { "type": "string" },
    "donation_frequency": { "type": "string" },
    "gift_aid_available": { "type": "boolean" },
    "accounting_charity": { "type": "string" },
    "charity_rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "impact_areas": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "is_favorite": { "type": "boolean" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "charity_name"],
  "_phase1_todo": ["Define charity verification", "Define impact reports", "Define recommendation system"]
}
