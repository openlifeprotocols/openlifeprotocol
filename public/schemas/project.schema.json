{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project",
  "description": "A time-bounded endeavour with defined scope, budget, and outcomes. The container that links budget, resources, tasks, costs, and deliverables.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^project_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "external_ids": {
      "type": "array",
      "items": { "type": "object", "properties": { "system": { "type": "string" }, "id": { "type": "string" } }, "required": ["system", "id"] }
    },
    "owner_id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "project_type": { "type": "string", "enum": ["construction", "renovation", "it", "business_change", "personal", "event", "research", "product_development", "other"] },
    "case_id": { "type": "string", "description": "OLP case that triggered this project" },
    "start_date": { "type": "string", "format": "date" },
    "target_end_date": { "type": "string", "format": "date" },
    "actual_end_date": { "type": "string", "format": "date" },
    "project_manager_id": { "type": "string" },
    "team_member_ids": { "type": "array", "items": { "type": "string" } },
    "budget_id": { "type": "string" },
    "total_budget": { "type": "number" },
    "actual_cost": { "type": "number" },
    "currency": { "type": "string" },
    "scope_id": { "type": "string" },
    "milestone_ids": { "type": "array", "items": { "type": "string" } },
    "deliverable_ids": { "type": "array", "items": { "type": "string" } },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "rag_status": { "type": "string", "enum": ["green", "amber", "red"] },
    "status": { "type": "string", "enum": ["planning", "approved", "active", "on_hold", "completed", "cancelled"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "owner_id", "name", "project_type", "start_date"],
  "_phase1_todo": [
    "Define project dependency graph",
    "Define critical path calculation",
    "Define earned value management",
    "Define project closure procedure"
  ]
}
