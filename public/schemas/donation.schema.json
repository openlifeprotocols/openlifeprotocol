{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Donation",
  "description": "Record of charitable donation.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^donation_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "charity_id": { "type": "string" },
    "charity_name": { "type": "string" },
    "donation_date": { "type": "string", "format": "date" },
    "donation_type": { "type": "string", "enum": ["monetary", "in_kind", "time", "volunteering"] },
    "amount": { "type": "number" },
    "currency": { "type": "string" },
    "donation_method": { "type": "string", "enum": ["online", "bank_transfer", "cheque", "cash", "direct_debit", "credit_card"] },
    "tax_deductible": { "type": "boolean" },
    "tax_reference": { "type": "string" },
    "cause_area": { "type": "string", "enum": ["health", "education", "poverty", "environment", "animal_welfare", "arts", "other"] },
    "receipt_document_id": { "type": "string" },
    "impact_description": { "type": "string" },
    "recurring": { "type": "boolean" },
    "recurring_frequency": { "type": "string", "enum": ["monthly", "quarterly", "annually", "one_time"] },
    "campaign_name": { "type": "string" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "charity_name"],
  "_phase1_todo": ["Define tax reporting", "Define recurring scheduling", "Define impact tracking"]
}
