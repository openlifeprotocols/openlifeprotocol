{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Step",
  "description": "A single step within a workflow definition. Steps can be tasks, decisions, communications, or other actions.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^step_[a-zA-Z0-9_-]+$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "external_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "system": { "type": "string" },
          "id": { "type": "string" },
          "type": { "type": "string" }
        },
        "required": ["system", "id"]
      }
    },
    "workflow_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "step_type": {
      "type": "string",
      "enum": ["task", "decision", "communication", "document_collection", "data_entry", "notification", "wait", "parallel", "fork", "join"],
      "description": "Type of step"
    },
    "order": {
      "type": "integer",
      "description": "Sequence number"
    },
    "depends_on": {
      "type": "array",
      "description": "Steps that must complete before this one",
      "items": { "type": "string" }
    },
    "parallel_with": {
      "type": "array",
      "description": "Steps that can run in parallel with this one",
      "items": { "type": "string" }
    },
    "required": {
      "type": "boolean",
      "description": "Whether this step is mandatory"
    },
    "conditional": {
      "type": "string",
      "description": "Condition for executing this step"
    },
    "assignment_actor_id": {
      "type": "string",
      "description": "Actor assigned to this step (if applicable)"
    },
    "estimated_hours": {
      "type": "number"
    },
    "timeout_hours": {
      "type": "number",
      "description": "Maximum time before auto-escalation"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["id", "uuid", "workflow_id", "name", "step_type", "order"],
  "_phase1_todo": [
    "Define step completion criteria",
    "Define step error handling and retry logic",
    "Define step routing and branching rules",
    "Define step performance monitoring",
    "Define step rollback procedures",
    "Define step notifications and alerts"
  ]
}
