{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Notification",
  "description": "User notification or alert.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^notification_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "notification_type": { "type": "string", "enum": ["alert", "reminder", "message", "update", "action_required", "congratulations", "system", "other"] },
    "title": { "type": "string" },
    "message": { "type": "string" },
    "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "related_entity_id": { "type": "string" },
    "related_entity_type": { "type": "string" },
    "action_url": { "type": "string", "format": "uri" },
    "action_title": { "type": "string" },
    "is_read": { "type": "boolean" },
    "read_date": { "type": "string", "format": "date-time" },
    "is_archived": { "type": "boolean" },
    "is_dismissed": { "type": "boolean" },
    "created_date": { "type": "string", "format": "date-time" },
    "expires_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define notification scheduling", "Define delivery methods", "Define do-not-disturb rules"]
}
