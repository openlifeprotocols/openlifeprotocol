{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relationship",
  "description": "Represents relationships between actors (family, employment, organizational, legal, etc.). Tracks context, duration, and relationship-specific properties.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^relationship_[a-zA-Z0-9_-]+$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "external_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "system": { "type": "string" },
          "id": { "type": "string" },
          "type": { "type": "string" }
        },
        "required": ["system", "id"]
      }
    },
    "actor_1_id": {
      "type": "string",
      "description": "First actor in relationship"
    },
    "actor_2_id": {
      "type": "string",
      "description": "Second actor in relationship"
    },
    "relationship_type": {
      "type": "string",
      "enum": ["family", "employment", "legal_representative", "power_of_attorney", "beneficiary", "guardian", "spouse", "parent", "child", "sibling", "business_partner", "colleague", "other"],
      "description": "Type of relationship"
    },
    "relationship_detail": {
      "type": "string",
      "description": "More specific relationship (e.g., 'mother', 'employer', 'executor')"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "When relationship began"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "When relationship ended (if applicable)"
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive", "terminated", "suspended"],
      "description": "Current status"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Context-specific properties"
    }
  },
  "required": ["id", "uuid", "actor_1_id", "actor_2_id", "relationship_type"],
  "_phase1_todo": [
    "Define relationship hierarchy and transitive properties",
    "Define conflict of interest detection",
    "Define relationship termination procedures",
    "Define relationship documentation requirements",
    "Define privacy and disclosure rules for relationships",
    "Define relationship impact on case eligibility"
  ]
}
