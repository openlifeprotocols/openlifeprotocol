{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Message Thread",
  "description": "A thread of communications (emails, messages, comments) on a case or topic. Groups related communications together.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^thread_[a-zA-Z0-9_-]+$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "external_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "system": { "type": "string" },
          "id": { "type": "string" },
          "type": { "type": "string" }
        },
        "required": ["system", "id"]
      }
    },
    "case_id": { "type": "string" },
    "subject": { "type": "string" },
    "created_by_actor_id": { "type": "string" },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "participants": {
      "type": "array",
      "description": "Actors involved in thread",
      "items": { "type": "string" }
    },
    "messages": {
      "type": "array",
      "description": "Messages in thread",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "from_actor_id": { "type": "string" },
          "content": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "attachments": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["open", "closed", "resolved"],
      "description": "Thread status"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["id", "uuid", "case_id", "subject", "created_by_actor_id"],
  "_phase1_todo": [
    "Define message threading and conversation logic",
    "Define message search and indexing",
    "Define message archival and retention",
    "Define message encryption and security",
    "Define thread notification settings",
    "Define thread permission boundaries"
  ]
}
