{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fear",
  "description": "A personal fear — specific phobia, anxiety trigger, source of dread, thing that frightens.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^fear_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "fear_name": { "type": "string" },
    "description": { "type": "string" },
    "fear_type": { "type": "string", "enum": ["specific_phobia", "social_anxiety", "existential_fear", "fear_of_failure", "fear_of_rejection", "fear_of_loss", "fear_of_unknown", "other"] },
    "intensity": { "type": "integer", "minimum": 1, "maximum": 10 },
    "frequency_triggered": { "type": "string", "enum": ["rarely", "occasionally", "frequently", "constantly"] },
    "triggers": { "type": "array", "items": { "type": "string" } },
    "origin": { "type": "string" },
    "when_developed": { "type": "string", "format": "date" },
    "past_traumatic_event": { "type": "boolean" },
    "physical_symptoms": { "type": "array", "items": { "type": "string" } },
    "emotional_symptoms": { "type": "array", "items": { "type": "string" } },
    "avoidance_behaviors": { "type": "array", "items": { "type": "string" } },
    "impact_on_life": { "type": "string", "enum": ["minimal", "moderate", "significant", "life_limiting"] },
    "areas_limited": { "type": "array", "items": { "type": "string" } },
    "coping_mechanisms": { "type": "array", "items": { "type": "string" } },
    "exposure_attempts": { "type": "integer" },
    "progress_made": { "type": "string", "enum": ["none", "minimal", "moderate", "significant", "overcome"] },
    "support_sought": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "fear_name", "fear_type"],
  "_phase1_todo": [
    "Define fear severity tracking",
    "Define exposure therapy progress",
    "Define fear-behavior-outcome analysis"
  ]
}
