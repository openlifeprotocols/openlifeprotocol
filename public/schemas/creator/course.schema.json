{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Course",
  "description": "An online course created and distributed by a creator.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^course_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "creator_profile_id": { "type": "string" },
    "course_name": { "type": "string" },
    "course_description": { "type": "string" },
    "subject": { "type": "string" },
    "difficulty_level": { "type": "string", "enum": ["beginner", "intermediate", "advanced", "expert"] },
    "total_modules": { "type": "integer" },
    "total_lessons": { "type": "integer" },
    "total_duration_hours": { "type": "number" },
    "price": { "type": "number" },
    "currency": { "type": "string" },
    "pricing_model": { "type": "string", "enum": ["one_time", "subscription", "free", "donation"] },
    "enrollment_count": { "type": "integer" },
    "completion_rate": { "type": "number" },
    "average_rating": { "type": "number" },
    "platform": { "type": "string", "enum": ["udemy", "teachable", "thinkific", "kajabi", "own_platform"] },
    "launch_date": { "type": "string", "format": "date" },
    "revenue": { "type": "number" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "creator_profile_id", "course_name"],
  "_phase1_todo": [
    "Define course curriculum design",
    "Define student progress tracking",
    "Define course performance analytics"
  ]
}
