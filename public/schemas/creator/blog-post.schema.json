{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blog Post",
  "description": "A blog post written by a creator.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^blog_post_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "creative_project_id": { "type": "string" },
    "post_title": { "type": "string" },
    "post_slug": { "type": "string" },
    "post_content": { "type": "string" },
    "excerpt": { "type": "string" },
    "author_id": { "type": "string" },
    "published_date": { "type": "string", "format": "date" },
    "updated_date": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["draft", "scheduled", "published", "archived"] },
    "category": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "featured_image": { "type": "string", "format": "uri" },
    "word_count": { "type": "integer" },
    "estimated_read_time": { "type": "integer" },
    "views": { "type": "integer" },
    "comments_count": { "type": "integer" },
    "seo_optimized": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "creative_project_id", "post_title"],
  "_phase1_todo": [
    "Define SEO optimization suggestions",
    "Define blog post scheduling",
    "Define reader engagement tracking"
  ]
}
