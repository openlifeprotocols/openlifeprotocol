{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document",
  "description": "Generic document file with metadata.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^document_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "owner_id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "document_type": { "type": "string", "enum": ["pdf", "word", "spreadsheet", "image", "video", "audio", "archive", "other"] },
    "file_format": { "type": "string" },
    "file_size_bytes": { "type": "integer" },
    "mime_type": { "type": "string" },
    "creation_date": { "type": "string", "format": "date-time" },
    "modification_date": { "type": "string", "format": "date-time" },
    "upload_date": { "type": "string", "format": "date-time" },
    "storage_location": { "type": "string" },
    "document_url": { "type": "string", "format": "uri" },
    "is_public": { "type": "boolean" },
    "is_archived": { "type": "boolean" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "related_person_ids": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "owner_id"],
  "_phase1_todo": ["Define document OCR", "Define full-text search", "Define access control"]
}
