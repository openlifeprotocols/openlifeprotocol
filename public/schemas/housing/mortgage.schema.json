{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mortgage",
  "description": "A mortgage or home loan secured against a property.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^mortgage_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "external_ids": {
      "type": "array",
      "items": { "type": "object", "properties": { "system": { "type": "string" }, "id": { "type": "string" } }, "required": ["system", "id"] }
    },
    "property_id": { "type": "string" },
    "lender_id": { "type": "string" },
    "borrower_ids": { "type": "array", "items": { "type": "string" } },
    "mortgage_type": { "type": "string", "enum": ["repayment", "interest_only", "part_and_part", "offset", "buy_to_let", "shared_ownership", "equity_release"] },
    "rate_type": { "type": "string", "enum": ["fixed", "variable", "tracker", "discount", "standard_variable"] },
    "original_amount": { "type": "number" },
    "currency": { "type": "string" },
    "outstanding_balance": { "type": "number" },
    "interest_rate": { "type": "number" },
    "term_years": { "type": "integer" },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "monthly_payment": { "type": "number" },
    "account_number": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "in_arrears", "redeemed", "foreclosed", "ported"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "property_id", "lender_id", "borrower_ids", "mortgage_type", "original_amount"],
  "_phase1_todo": [
    "Define remortgage workflow",
    "Define porting procedures",
    "Define arrears management",
    "Define redemption statement procedures"
  ]
}
