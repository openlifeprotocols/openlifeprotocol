{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OCR Text",
  "description": "Optical Character Recognition extracted text from document.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^ocr_text_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "document_id": { "type": "string" },
    "extracted_text": { "type": "string" },
    "language_detected": { "type": "string" },
    "confidence_score": { "type": "number" },
    "page_number": { "type": "integer" },
    "extraction_date": { "type": "string", "format": "date-time" },
    "extraction_method": { "type": "string", "enum": ["tesseract", "aws_textract", "google_vision", "azure_cv", "other"] },
    "is_searchable": { "type": "boolean" },
    "entities_extracted": { "type": "array", "items": { "type": "object", "properties": { "entity_type": { "type": "string" }, "entity_value": { "type": "string" }, "confidence": { "type": "number" } } } },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "document_id"],
  "_phase1_todo": ["Define entity recognition", "Define text indexing", "Define layout analysis"]
}
