{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Escalation",
  "description": "Escalation rules and procedures for tasks and cases that exceed timeouts or thresholds.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^escalation_[a-zA-Z0-9_-]+$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "name": { "type": "string" },
    "entity_type": {
      "type": "string",
      "enum": ["task", "case", "approval", "review"],
      "description": "What type of entity escalates"
    },
    "trigger_condition": {
      "type": "string",
      "description": "Condition triggering escalation (e.g., 'overdue', 'high_priority')"
    },
    "escalation_path": {
      "type": "array",
      "description": "Steps in escalation process",
      "items": {
        "type": "object",
        "properties": {
          "step": { "type": "integer" },
          "escalate_to_actor_id": { "type": "string" },
          "delay_hours": { "type": "integer" },
          "notification_template": { "type": "string" }
        }
      }
    },
    "max_escalations": {
      "type": "integer",
      "description": "Maximum escalation steps"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["id", "uuid", "name", "entity_type"],
  "_phase1_todo": [
    "Define escalation cost/impact",
    "Define escalation notification preferences",
    "Define escalation tracking and analytics",
    "Define escalation resolution procedures"
  ]
}
