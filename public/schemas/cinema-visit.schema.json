{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cinema Visit",
  "description": "Visit to a cinema/theater.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^cinema_visit_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "movie_id": { "type": "string" },
    "movie_title": { "type": "string" },
    "cinema_name": { "type": "string" },
    "cinema_location": { "type": "string" },
    "visit_date": { "type": "string", "format": "date" },
    "showtime": { "type": "string", "format": "time" },
    "screen_type": { "type": "string", "enum": ["standard_2d", "imax", "3d", "dolby", "premium_large_format"] },
    "ticket_price": { "type": "number" },
    "seating_section": { "type": "string" },
    "seat_number": { "type": "string" },
    "companions": { "type": "array", "items": { "type": "string" } },
    "snacks_purchased": { "type": "array", "items": { "type": "string" } },
    "snack_cost": { "type": "number" },
    "rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "cinema_experience_rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "memorable_moment": { "type": "string" },
    "would_return_cinema": { "type": "boolean" },
    "notes": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "movie_title"],
  "_phase1_todo": ["Define cinema favorites", "Define visit frequency tracking", "Define social integration"]
}
