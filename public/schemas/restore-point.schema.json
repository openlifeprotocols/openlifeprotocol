{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Restore Point",
  "description": "Point for system restore or recovery.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^restore_point_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "backup_snapshot_id": { "type": "string" },
    "restore_point_name": { "type": "string" },
    "restore_point_description": { "type": "string" },
    "restore_point_timestamp": { "type": "string", "format": "date-time" },
    "creation_reason": { "type": "string", "enum": ["scheduled_backup", "pre_maintenance", "pre_upgrade", "manual_checkpoint", "emergency"] },
    "restore_scope": { "type": "string", "enum": ["full_system", "partial", "custom"] },
    "entities_included": { "type": "array", "items": { "type": "object", "properties": { "entity_type": { "type": "string" }, "entity_count": { "type": "integer" } } } },
    "data_integrity_check": { "type": "boolean" },
    "is_tested": { "type": "boolean" },
    "test_date": { "type": "string", "format": "date-time" },
    "test_result": { "type": "string", "enum": ["success", "partial_success", "failed"] },
    "estimated_recovery_time_minutes": { "type": "integer" },
    "is_available_for_restore": { "type": "boolean" },
    "restore_history": { "type": "array", "items": { "type": "object", "properties": { "restore_date": { "type": "string" }, "restored_by": { "type": "string" }, "result": { "type": "string" } } } },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "backup_snapshot_id"],
  "_phase1_todo": ["Define restore testing", "Define restore procedures", "Define RTO/RPO tracking"]
}
