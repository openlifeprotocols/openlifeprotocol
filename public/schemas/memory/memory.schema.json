{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Memory",
  "description": "A personal memory — subjective recollection of an event, person, or experience with emotional and personal significance.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^memory_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "memory_type": { "type": "string", "enum": ["autobiographical", "semantic", "procedural", "emotional", "episodic", "collective"] },
    "event_date": { "type": "string", "format": "date" },
    "approximate_date": { "type": "boolean" },
    "date_range": { "type": "string" },
    "vividness": { "type": "string", "enum": ["dim", "clear", "very_clear", "photographic"] },
    "emotional_tone": { "type": "string", "enum": ["positive", "negative", "neutral", "mixed", "bittersweet"] },
    "people_involved": { "type": "array", "items": { "type": "string" } },
    "location": { "type": "string" },
    "significance": { "type": "string", "enum": ["trivial", "minor", "significant", "life_changing", "formative"] },
    "why_significant": { "type": "string" },
    "sensory_details": { "type": "string" },
    "linked_event_id": { "type": "string" },
    "linked_media": { "type": "array", "items": { "type": "string" } },
    "lessons_from_memory": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "title"],
  "_phase1_todo": [
    "Define memory decay and reconstruction",
    "Define memory-to-event fact linking",
    "Define memory significance scoring"
  ]
}
