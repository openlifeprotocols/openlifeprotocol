{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recycling Record",
  "description": "Recycling and waste management record.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^recycling_record_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "household_id": { "type": "string" },
    "record_date": { "type": "string", "format": "date" },
    "item_type": { "type": "string", "enum": ["plastic", "paper", "metal", "glass", "organic", "electronics", "textiles", "other"] },
    "weight_kg": { "type": "number" },
    "quantity": { "type": "integer" },
    "disposal_method": { "type": "string", "enum": ["curbside_recycling", "donation", "refurbishment", "composting", "special_collection", "landfill", "other"] },
    "facility_or_service": { "type": "string" },
    "co2_saved_kg": { "type": "number" },
    "water_saved_liters": { "type": "number" },
    "material_saved_from_landfill": { "type": "boolean" },
    "reuse_potential": { "type": "string" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define waste analytics", "Define impact calculation", "Define household comparison"]
}
