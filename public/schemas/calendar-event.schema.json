{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Calendar Event",
  "description": "A calendar event — an appointment, meeting, deadline, or reminder from any calendar source. The temporal anchor for OLP cases and tasks.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^cal_event_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "calendar_id": { "type": "string" },
    "provider_event_id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "location": { "type": "string" },
    "start_datetime": { "type": "string", "format": "date-time" },
    "end_datetime": { "type": "string", "format": "date-time" },
    "all_day": { "type": "boolean" },
    "timezone": { "type": "string", "description": "IANA timezone, e.g. Europe/London" },
    "recurrence": { "type": "string", "description": "RRULE string" },
    "attendees": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" },
          "name": { "type": "string" },
          "rsvp": { "type": "string", "enum": ["accepted", "declined", "tentative", "needs_action"] }
        }
      }
    },
    "organiser_email": { "type": "string", "format": "email" },
    "conference_link": { "type": "string", "format": "uri" },
    "classification": {
      "type": "string",
      "enum": ["appointment", "meeting", "deadline", "birthday", "travel", "medical", "legal", "financial", "personal", "work", "reminder", "other"]
    },
    "linked_case_id": { "type": "string" },
    "linked_task_id": { "type": "string" },
    "reminder_minutes": { "type": "array", "items": { "type": "integer" } },
    "status": { "type": "string", "enum": ["confirmed", "tentative", "cancelled"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "title", "start_datetime"],
  "_phase1_todo": [
    "Define multi-calendar merge and deduplication",
    "Define deadline extraction from email",
    "Define OLP case milestone auto-linking to calendar",
    "Define travel time calculation"
  ]
}
