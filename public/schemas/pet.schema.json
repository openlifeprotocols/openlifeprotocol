{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pet",
  "description": "A pet animal — the central record linking species, breed, owner, medical history, insurance, and lifecycle events.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^pet_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "external_ids": {
      "type": "array",
      "items": { "type": "object", "properties": { "system": { "type": "string" }, "id": { "type": "string" } }, "required": ["system", "id"] }
    },
    "name": { "type": "string" },
    "species_id": { "type": "string" },
    "breed_id": { "type": "string" },
    "mixed_breed": { "type": "boolean" },
    "sex": { "type": "string", "enum": ["male", "female", "unknown"] },
    "neutered": { "type": "boolean" },
    "date_of_birth": { "type": "string", "format": "date" },
    "estimated_dob": { "type": "boolean" },
    "colour": { "type": "string" },
    "distinguishing_features": { "type": "string" },
    "microchip_number": { "type": "string" },
    "microchip_date": { "type": "string", "format": "date" },
    "passport_number": { "type": "string" },
    "owner_ids": { "type": "array", "items": { "type": "string" } },
    "household_id": { "type": "string" },
    "registered_vet_id": { "type": "string" },
    "insurance_policy_ids": { "type": "array", "items": { "type": "string" } },
    "medical_record_id": { "type": "string" },
    "care_plan_id": { "type": "string" },
    "status": { "type": "string", "enum": ["alive", "deceased", "missing", "rehomed"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "name", "species_id", "sex"],
  "_phase1_todo": [
    "Define microchip registration integration (Petlog, Identibase)",
    "Define pet passport digital format",
    "Define missing pet alert workflow",
    "Define multi-pet household management"
  ]
}
