{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Estate",
  "description": "The total estate of a person at a given point — all assets, liabilities, and net worth — used in life planning, probate, and inheritance.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^estate_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "external_ids": {
      "type": "array",
      "items": { "type": "object", "properties": { "system": { "type": "string" }, "id": { "type": "string" } }, "required": ["system", "id"] }
    },
    "person_id": { "type": "string" },
    "valuation_date": { "type": "string", "format": "date" },
    "estate_type": { "type": "string", "enum": ["living", "deceased"] },
    "assets": {
      "type": "array",
      "description": "Asset IDs contributing to estate",
      "items": { "type": "string" }
    },
    "liabilities": {
      "type": "array",
      "description": "Liability IDs against the estate",
      "items": { "type": "string" }
    },
    "gross_value": { "type": "number" },
    "total_liabilities": { "type": "number" },
    "net_value": { "type": "number" },
    "currency": { "type": "string" },
    "inheritance_tax_threshold": { "type": "number" },
    "inheritance_tax_due": { "type": "number" },
    "will_id": { "type": "string" },
    "executor_ids": { "type": "array", "items": { "type": "string" } },
    "probate_case_id": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "valuation_date", "estate_type"],
  "_phase1_todo": [
    "Define automatic valuation triggers on death",
    "Define estate freeze on death",
    "Define estate distribution workflow",
    "Define estate tax minimisation strategies"
  ]
}
