{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Identity",
  "description": "Identity verification and proof records. Tracks verified identity attributes, credentials, and verification status.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^identity_[a-zA-Z0-9_-]+$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "external_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "system": { "type": "string" },
          "id": { "type": "string" },
          "type": { "type": "string" }
        },
        "required": ["system", "id"]
      }
    },
    "actor_id": { "type": "string" },
    "identity_type": {
      "type": "string",
      "enum": ["national_id", "passport", "driving_license", "birth_certificate", "corporate_registration", "tax_id"],
      "description": "Type of identity document"
    },
    "identifier": {
      "type": "string",
      "description": "The actual identifier value (SSN, passport number, etc.)"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "issuing_authority": {
      "type": "string",
      "description": "Government or authority that issued it"
    },
    "jurisdiction": {
      "type": "string",
      "description": "Jurisdiction of issuance"
    },
    "verification_status": {
      "type": "string",
      "enum": ["unverified", "verified", "expired", "revoked", "disputed"],
      "description": "Current verification status"
    },
    "verified_by": {
      "type": "string",
      "description": "Actor or system that verified"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verification_method": {
      "type": "string",
      "enum": ["manual_review", "automated_check", "third_party_verification", "document_scan", "biometric"],
      "description": "How it was verified"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["id", "uuid", "actor_id", "identity_type", "identifier"],
  "_phase1_todo": [
    "Define identity verification standards by jurisdiction",
    "Define biometric verification requirements",
    "Define identity fraud detection",
    "Define identity data retention and deletion",
    "Define identity linking for matching systems",
    "Define privacy protection for sensitive identity data"
  ]
}
