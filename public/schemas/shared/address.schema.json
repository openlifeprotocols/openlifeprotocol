{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Address",
  "description": "Physical address information for actors, institutions, or assets. Supports multiple address types and formats.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^address_[a-zA-Z0-9_-]+$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "external_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "system": { "type": "string" },
          "id": { "type": "string" },
          "type": { "type": "string" }
        },
        "required": ["system", "id"]
      }
    },
    "entity_id": {
      "type": "string",
      "description": "Actor, institution, or asset this address belongs to"
    },
    "address_type": {
      "type": "string",
      "enum": ["residential", "business", "postal", "billing", "shipping", "registered_office", "service"],
      "description": "Type of address"
    },
    "full_address": {
      "type": "string",
      "description": "Complete address as single string"
    },
    "street": { "type": "string" },
    "street_2": { "type": "string" },
    "city": { "type": "string" },
    "state_province": { "type": "string" },
    "postal_code": { "type": "string" },
    "country": { "type": "string" },
    "country_code": {
      "type": "string",
      "description": "ISO 3166-1 alpha-2 country code"
    },
    "jurisdiction": { "type": "string" },
    "latitude": { "type": "number" },
    "longitude": { "type": "number" },
    "verified": {
      "type": "boolean",
      "description": "Whether address has been verified"
    },
    "verified_date": {
      "type": "string",
      "format": "date"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "When address became current"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "When address is no longer current"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["id", "uuid", "entity_id", "address_type", "country"],
  "_phase1_todo": [
    "Define address validation against postal registries",
    "Define address standardization and geocoding",
    "Define address privacy/redaction rules",
    "Define address lookup and matching",
    "Define international address format support",
    "Define address change notification procedures"
  ]
}
