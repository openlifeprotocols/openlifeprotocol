{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Community Representation",
  "description": "Service in community representation or leadership.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^community_representation_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "position_title": { "type": "string" },
    "organization_or_body": { "type": "string" },
    "representation_type": { "type": "string", "enum": ["elected", "appointed", "volunteer", "committee_member", "board_member", "delegate"] },
    "constituency_or_group": { "type": "string" },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "term_length_months": { "type": "integer" },
    "term_number": { "type": "integer" },
    "responsibilities": { "type": "array", "items": { "type": "string" } },
    "decisions_influenced": { "type": "array", "items": { "type": "string" } },
    "votes_cast": { "type": "integer" },
    "committees_served": { "type": "array", "items": { "type": "string" } },
    "key_accomplishments": { "type": "array", "items": { "type": "string" } },
    "challenges_faced": { "type": "array", "items": { "type": "string" } },
    "advocacy_priorities": { "type": "array", "items": { "type": "string" } },
    "constituent_feedback": { "type": "string" },
    "satisfaction_with_service": { "type": "number", "minimum": 1, "maximum": 5 },
    "would_serve_again": { "type": "boolean" },
    "impact_on_community": { "type": "string" },
    "personal_growth": { "type": "string" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "position_title"],
  "_phase1_todo": ["Define service record", "Define impact tracking", "Define constituent management"]
}
