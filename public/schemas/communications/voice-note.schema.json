{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Voice Note",
  "description": "A voice note or memo — audio recording of thoughts, reminders, voice journaling.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^voice_note_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "title": { "type": "string" },
    "audio_url": { "type": "string", "format": "uri" },
    "duration_seconds": { "type": "integer" },
    "created_date": { "type": "string", "format": "date-time" },
    "note_type": { "type": "string", "enum": ["voice_memo", "voice_journal", "thought_capture", "reminder", "message_to_self", "idea_recording"] },
    "subject": { "type": "string" },
    "transcription": { "type": "string" },
    "transcription_language": { "type": "string" },
    "transcription_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "key_topics": { "type": "array", "items": { "type": "string" } },
    "action_items": { "type": "array", "items": { "type": "string" } },
    "audio_quality": { "type": "string", "enum": ["poor", "fair", "good", "excellent"] },
    "mood_during_recording": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "audio_url", "created_date"],
  "_phase1_todo": [
    "Define voice-to-text transcription automation",
    "Define voice note summarization and extraction",
    "Define voice emotion analysis"
  ]
}
