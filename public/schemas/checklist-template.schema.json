{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Checklist Template",
  "description": "Reusable checklist template.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^checklist_template_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "checklist_name": { "type": "string" },
    "checklist_description": { "type": "string" },
    "purpose": { "type": "string", "enum": ["project_planning", "document_assembly", "task_management", "compliance", "onboarding", "other"] },
    "items": { "type": "array", "items": { "type": "object", "properties": { "item_id": { "type": "string" }, "item_text": { "type": "string" }, "order": { "type": "integer" }, "is_required": { "type": "boolean" }, "estimated_hours": { "type": "number" }, "dependencies": { "type": "array", "items": { "type": "string" } }, "notes": { "type": "string" } } } },
    "total_items": { "type": "integer" },
    "estimated_completion_hours": { "type": "number" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "is_public": { "type": "boolean" },
    "usage_count": { "type": "integer" },
    "version_number": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "last_updated_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define checklist instantiation", "Define progress tracking", "Define item automation"]
}
