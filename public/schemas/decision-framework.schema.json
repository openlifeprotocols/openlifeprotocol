{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision Framework",
  "description": "Personal decision-making framework or methodology.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^decision_framework_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "framework_name": { "type": "string" },
    "framework_type": { "type": "string", "enum": ["heuristic", "analytical", "intuitive", "hybrid", "organizational"] },
    "description": { "type": "string" },
    "developed_date": { "type": "string", "format": "date" },
    "applicable_domains": { "type": "array", "items": { "type": "string" } },
    "key_principles": { "type": "array", "items": { "type": "string" } },
    "decision_steps": { "type": "array", "items": { "type": "object", "properties": { "step": { "type": "integer" }, "description": { "type": "string" }, "instructions": { "type": "array" } } } },
    "criteria_considered": { "type": "array", "items": { "type": "string" } },
    "weighting_method": { "type": "string" },
    "bias_mitigation_strategies": { "type": "array", "items": { "type": "string" } },
    "decision_tools_used": { "type": "array", "items": { "type": "string" } },
    "time_estimation": { "type": "string" },
    "group_vs_individual": { "type": "string", "enum": ["individual", "group", "combination"] },
    "effectiveness_rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "times_successfully_applied": { "type": "integer" },
    "times_failed": { "type": "integer" },
    "success_rate_percentage": { "type": "number", "minimum": 0, "maximum": 100 },
    "framework_evolution": { "type": "array", "items": { "type": "string" } },
    "influenced_by": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "framework_name"],
  "_phase1_todo": ["Define framework testing", "Define effectiveness tracking", "Define framework refinement"]
}
