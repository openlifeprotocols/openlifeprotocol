{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prospect",
  "description": "A qualified prospect — has budget, authority, need, timeline (BANT). Further down funnel than a lead.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^prospect_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "business_id": { "type": "string" },
    "lead_id": { "type": "string" },
    "company_name": { "type": "string" },
    "contact_ids": { "type": "array", "items": { "type": "string" } },
    "owner_id": { "type": "string" },
    "budget": { "type": "number" },
    "currency": { "type": "string" },
    "decision_maker_id": { "type": "string" },
    "pain_points": { "type": "array", "items": { "type": "string" } },
    "timeline": { "type": "string" },
    "opportunity_ids": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["active", "won", "lost", "paused"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "business_id"],
  "_phase1_todo": ["Define BANT qualification criteria", "Define prospect discovery workflow", "Define multi-stakeholder mapping"]
}
