{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Account (Customer)",
  "description": "A customer account — the B2B relationship between our business and a client organisation, with all contacts, deals, and activity.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^account_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "business_id": { "type": "string" },
    "customer_id": { "type": "string" },
    "company_name": { "type": "string" },
    "industry": { "type": "string" },
    "employee_count": { "type": "integer" },
    "annual_revenue": { "type": "number" },
    "currency": { "type": "string" },
    "owner_id": { "type": "string" },
    "contact_ids": { "type": "array", "items": { "type": "string" } },
    "tier": { "type": "string", "enum": ["strategic", "enterprise", "mid_market", "smb", "self_serve"] },
    "arr": { "type": "number" },
    "contract_value": { "type": "number" },
    "renewal_date": { "type": "string", "format": "date" },
    "health_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "status": { "type": "string", "enum": ["active", "at_risk", "churned"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "business_id", "company_name"],
  "_phase1_todo": ["Define account planning framework", "Define executive sponsor tracking", "Define whitespace analysis"]
}
