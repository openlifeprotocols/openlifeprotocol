{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standard Operating Procedure",
  "description": "An SOP — a formal, step-by-step procedure defining how a specific task must be performed to ensure consistency and compliance.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^sop_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "business_id": { "type": "string" },
    "process_id": { "type": "string" },
    "title": { "type": "string" },
    "sop_number": { "type": "string" },
    "version": { "type": "string" },
    "department_id": { "type": "string" },
    "author_id": { "type": "string" },
    "approved_by_id": { "type": "string" },
    "approved_date": { "type": "string", "format": "date" },
    "review_date": { "type": "string", "format": "date" },
    "purpose": { "type": "string" },
    "scope": { "type": "string" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": { "type": "integer" },
          "action": { "type": "string" },
          "responsible": { "type": "string" },
          "expected_output": { "type": "string" },
          "tools_required": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "document_id": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "approved", "under_review", "retired"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "business_id", "title", "version"],
  "_phase1_todo": ["Define SOP training tracking", "Define SOP compliance checking", "Define SOP version control"]
}
