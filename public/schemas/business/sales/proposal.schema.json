{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposal",
  "description": "A sales proposal — a narrative document presenting a solution, value proposition, and commercial offer to a prospect.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^proposal_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "business_id": { "type": "string" },
    "opportunity_id": { "type": "string" },
    "prospect_id": { "type": "string" },
    "title": { "type": "string" },
    "prepared_by_id": { "type": "string" },
    "issued_date": { "type": "string", "format": "date" },
    "valid_until": { "type": "string", "format": "date" },
    "executive_summary": { "type": "string" },
    "problem_statement": { "type": "string" },
    "proposed_solution": { "type": "string" },
    "investment": { "type": "number" },
    "currency": { "type": "string" },
    "roi_estimate": { "type": "string" },
    "document_id": { "type": "string" },
    "viewed_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["draft", "sent", "viewed", "accepted", "rejected", "expired"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "business_id", "title", "issued_date", "investment", "currency"],
  "_phase1_todo": ["Define proposal template library", "Define proposal analytics (open/view tracking)", "Define e-signature integration"]
}
