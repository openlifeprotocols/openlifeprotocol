{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "compliance pack (Business Registry)",
  "description": "Business registry schema for compliance-pack — reusable templates and reference data.",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "uuid": { "type": "string", "format": "uuid" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "draft", "archived"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "name"],
  "_phase1_todo": ["Define compliance-pack publish workflow", "Define compliance-pack versioning", "Define compliance-pack deployment"]
}
