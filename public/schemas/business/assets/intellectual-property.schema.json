{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "intellectual property (Business Assets)",
  "description": "Business asset schema for intellectual-property. References resources/asset.schema.json where applicable.",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "uuid": { "type": "string", "format": "uuid" },
    "business_id": { "type": "string" },
    "name": { "type": "string" },
    "asset_value": { "type": "number" },
    "currency": { "type": "string" },
    "acquired_date": { "type": "string", "format": "date" },
    "status": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "business_id", "name"],
  "_phase1_todo": ["Define intellectual-property asset register", "Define intellectual-property depreciation schedule", "Define intellectual-property disposal workflow"]
}
