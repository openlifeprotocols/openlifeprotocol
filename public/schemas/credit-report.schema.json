{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Credit Report",
  "description": "Credit bureau report or credit score.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^credit_report_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "report_date": { "type": "string", "format": "date" },
    "credit_bureau": { "type": "string", "enum": ["equifax", "experian", "transunion", "other"] },
    "credit_score": { "type": "integer" },
    "credit_range_start": { "type": "integer" },
    "credit_range_end": { "type": "integer" },
    "credit_rating": { "type": "string", "enum": ["poor", "fair", "good", "very_good", "excellent"] },
    "accounts_open": { "type": "integer" },
    "accounts_closed": { "type": "integer" },
    "accounts_delinquent": { "type": "integer" },
    "accounts_in_good_standing": { "type": "integer" },
    "total_debt": { "type": "number" },
    "available_credit": { "type": "number" },
    "credit_utilization_ratio": { "type": "number" },
    "hard_inquiries": { "type": "integer" },
    "document_id": { "type": "string" },
    "upload_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define score tracking", "Define credit monitoring", "Define dispute management"]
}
