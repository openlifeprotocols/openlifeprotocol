{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Email Template",
  "description": "Reusable email template.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^email_template_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "template_name": { "type": "string" },
    "template_description": { "type": "string" },
    "email_type": { "type": "string", "enum": ["notification", "reminder", "request", "follow_up", "status_update", "confirmation", "decline", "other"] },
    "subject_line": { "type": "string" },
    "subject_variables": { "type": "array", "items": { "type": "string" } },
    "email_body": { "type": "string" },
    "body_format": { "type": "string", "enum": ["plain_text", "html", "markdown"] },
    "variables": { "type": "array", "items": { "type": "object", "properties": { "variable_name": { "type": "string" }, "placeholder": { "type": "string" }, "data_type": { "type": "string" } } } },
    "recipient_type": { "type": "string", "enum": ["individual", "group", "role", "dynamic"] },
    "recipient_list": { "type": "array", "items": { "type": "string" } },
    "cc_recipients": { "type": "array", "items": { "type": "string" } },
    "bcc_recipients": { "type": "array", "items": { "type": "string" } },
    "attachments_template": { "type": "array", "items": { "type": "string" } },
    "signature": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "is_public": { "type": "boolean" },
    "usage_count": { "type": "integer" },
    "last_used_date": { "type": "string", "format": "date-time" },
    "version_number": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define template rendering", "Define variable injection", "Define send tracking"]
}
