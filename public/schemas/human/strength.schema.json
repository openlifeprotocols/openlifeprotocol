{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Strength",
  "description": "A personal strength — capability, aptitude, area of excellence, what I do well.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^strength_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "strength_name": { "type": "string" },
    "description": { "type": "string" },
    "strength_type": { "type": "string", "enum": ["natural_talent", "developed_skill", "strength_finder", "proven_capability"] },
    "domain": { "type": "string" },
    "proficiency_level": { "type": "string", "enum": ["good", "very_good", "excellent", "world_class"] },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "recognized_by": { "type": "array", "items": { "type": "string" } },
    "when_discovered": { "type": "string", "format": "date" },
    "how_developed": { "type": "string" },
    "time_investment": { "type": "string" },
    "continued_development": { "type": "boolean" },
    "application_areas": { "type": "array", "items": { "type": "string" } },
    "impact_potential": { "type": "string", "enum": ["personal", "local", "professional", "societal", "global"] },
    "leveraged_in_career": { "type": "boolean" },
    "could_monetize": { "type": "boolean" },
    "brings_joy": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "strength_name"],
  "_phase1_todo": [
    "Define strength-opportunity matching",
    "Define strength complementarity in teams",
    "Define strength-based goal setting"
  ]
}
