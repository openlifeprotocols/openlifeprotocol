{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Utility Bill",
  "description": "Electricity, gas, water, or other utility bill.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^utility_bill_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "bill_id": { "type": "string" },
    "utility_type": { "type": "string", "enum": ["electricity", "gas", "water", "sewage", "waste", "other"] },
    "account_number": { "type": "string" },
    "property_address": { "type": "string" },
    "billing_period_start": { "type": "string", "format": "date" },
    "billing_period_end": { "type": "string", "format": "date" },
    "meter_reading_start": { "type": "number" },
    "meter_reading_end": { "type": "number" },
    "units_used": { "type": "number" },
    "unit_type": { "type": "string", "enum": ["kwh", "m3", "cubic_meters", "gallons", "other"] },
    "unit_rate": { "type": "number" },
    "base_charge": { "type": "number" },
    "consumption_charge": { "type": "number" },
    "tax": { "type": "number" },
    "total_amount": { "type": "number" },
    "currency": { "type": "string" },
    "due_date": { "type": "string", "format": "date" },
    "document_id": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "bill_id"],
  "_phase1_todo": ["Define consumption tracking", "Define bill trend analysis", "Define overpayment detection"]
}
