{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jurisdiction",
  "description": "Geographic and legal jurisdiction context. Defines rules, requirements, and regulations that apply in a jurisdiction.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^jurisdiction_[a-zA-Z0-9_-]+$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "external_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "system": { "type": "string" },
          "id": { "type": "string" },
          "type": { "type": "string" }
        },
        "required": ["system", "id"]
      }
    },
    "code": {
      "type": "string",
      "description": "ISO 3166-1 or similar code",
      "examples": ["GB", "US", "US-CA", "US-NY"]
    },
    "name": {
      "type": "string",
      "description": "Name of jurisdiction",
      "examples": ["United Kingdom", "United States", "California", "New York"]
    },
    "jurisdiction_type": {
      "type": "string",
      "enum": ["country", "state", "province", "county", "city", "region"],
      "description": "Type of jurisdiction"
    },
    "parent_jurisdiction": {
      "type": "string",
      "description": "Parent jurisdiction (e.g., 'US' for 'US-CA')"
    },
    "legal_system": {
      "type": "string",
      "enum": ["common_law", "civil_law", "religious_law", "customary_law", "mixed"],
      "description": "Legal system type"
    },
    "language": { "type": "string" },
    "currency": { "type": "string" },
    "regulations": {
      "type": "array",
      "description": "Key regulations and laws",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "date_effective": { "type": "string", "format": "date" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["id", "uuid", "code", "name", "jurisdiction_type"],
  "_phase1_todo": [
    "Define jurisdiction-specific workflow rules",
    "Define jurisdiction-specific document requirements",
    "Define jurisdiction-specific timeframes and deadlines",
    "Define tax and fee rules by jurisdiction",
    "Define regulatory compliance by jurisdiction",
    "Define jurisdiction hierarchy and authority"
  ]
}
