{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rule",
  "description": "Business rules and logic that govern workflows, decisions, and case eligibility. Rules are executable conditions and actions.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^rule_[a-zA-Z0-9_-]+$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "external_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "system": { "type": "string" },
          "id": { "type": "string" },
          "type": { "type": "string" }
        },
        "required": ["system", "id"]
      }
    },
    "name": {
      "type": "string",
      "description": "Human-readable rule name"
    },
    "description": {
      "type": "string"
    },
    "rule_type": {
      "type": "string",
      "enum": ["eligibility", "validation", "calculation", "decision", "workflow_routing", "notification", "constraint"],
      "description": "Type of rule"
    },
    "condition": {
      "type": "string",
      "description": "Condition to evaluate (JSON, DSL, or reference)"
    },
    "action": {
      "type": "string",
      "description": "Action to take when rule fires"
    },
    "jurisdiction": {
      "type": "string",
      "description": "Jurisdiction this rule applies to"
    },
    "applicable_cases": {
      "type": "array",
      "description": "Case types this rule applies to",
      "items": { "type": "string" }
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "priority": {
      "type": "integer",
      "description": "Rule execution priority (higher = first)"
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive", "deprecated"],
      "description": "Whether rule is active"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["id", "uuid", "name", "rule_type"],
  "_phase1_todo": [
    "Define rule engine architecture and execution",
    "Define rule version control and rollback",
    "Define rule testing and validation",
    "Define rule conflict detection",
    "Define rule performance optimization",
    "Define rule audit trail and decision tracing"
  ]
}
