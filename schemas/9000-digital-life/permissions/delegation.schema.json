{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delegation",
  "description": "Delegated authority or power of attorney.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^delegation_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "principal_id": { "type": "string" },
    "agent_id": { "type": "string" },
    "delegation_type": { "type": "string", "enum": ["financial", "healthcare", "legal", "property", "limited_power", "general_power"] },
    "authority_granted": { "type": "array", "items": { "type": "string" } },
    "authority_restrictions": { "type": "array", "items": { "type": "string" } },
    "effective_date": { "type": "string", "format": "date" },
    "termination_date": { "type": "string", "format": "date" },
    "is_durable": { "type": "boolean" },
    "springing_trigger": { "type": "string" },
    "document_id": { "type": "string" },
    "is_notarized": { "type": "boolean" },
    "notarization_date": { "type": "string", "format": "date" },
    "is_registered": { "type": "boolean" },
    "registration_location": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "principal_id", "agent_id"],
  "_phase1_todo": ["Define authority verification", "Define scope enforcement", "Define revocation process"]
}
