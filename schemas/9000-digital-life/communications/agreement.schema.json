{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agreement",
  "description": "A documented agreement — commitment, promise, contract, pact between parties.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^agreement_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "agreement_type": { "type": "string", "enum": ["verbal_commitment", "written_contract", "handshake_deal", "mutual_understanding", "promise", "covenant"] },
    "parties_involved": { "type": "array", "items": { "type": "string" } },
    "date_agreed": { "type": "string", "format": "date" },
    "agreement_text": { "type": "string" },
    "terms": { "type": "array", "items": { "type": "string" } },
    "obligations": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
    "duration": { "type": "string" },
    "expiry_date": { "type": "string", "format": "date" },
    "renewal_terms": { "type": "string" },
    "witness": { "type": "array", "items": { "type": "string" } },
    "document_url": { "type": "string", "format": "uri" },
    "status": { "type": "string", "enum": ["active", "completed", "expired", "breached", "renegotiated"] },
    "breach_occurred": { "type": "boolean" },
    "resolution": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "title", "agreement_type"],
  "_phase1_todo": [
    "Define agreement compliance tracking",
    "Define obligation reminder system",
    "Define dispute resolution framework"
  ]
}
