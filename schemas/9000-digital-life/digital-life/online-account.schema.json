{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Online Account",
  "description": "An online account or digital service account — email, social media, banking app, government portal, etc.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^online_account_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "service_name": { "type": "string" },
    "service_type": { "type": "string", "enum": ["email", "social_media", "banking", "shopping", "streaming", "government_portal", "cloud_storage", "communication", "work", "gaming", "health", "other"] },
    "username": { "type": "string" },
    "email_used": { "type": "string", "format": "email" },
    "phone_used": { "type": "string" },
    "account_url": { "type": "string", "format": "uri" },
    "created_date": { "type": "string", "format": "date" },
    "last_login": { "type": "string", "format": "date-time" },
    "two_factor_enabled": { "type": "boolean" },
    "digital_assets": { "type": "boolean", "description": "Account contains digital assets or value" },
    "death_instructions": { "type": "string", "enum": ["memorialize", "delete", "transfer_to_next_of_kin", "no_instruction"] },
    "subscription_id": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "inactive", "locked", "closed"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "service_name", "service_type"],
  "_phase1_todo": [
    "Define account inventory/audit workflow",
    "Define death/incapacity account handling",
    "Define credential reference security",
    "Define digital estate planning"
  ]
}
