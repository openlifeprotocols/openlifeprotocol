{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Digital Legacy",
  "description": "Instructions for a person's digital life after death — accounts to close, assets to transfer, messages to send, and memorial preferences.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^digital_legacy_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "created_date": { "type": "string", "format": "date" },
    "last_updated": { "type": "string", "format": "date" },
    "executor_id": { "type": "string", "description": "Digital executor" },
    "account_instructions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "account_id": { "type": "string" },
          "instruction": { "type": "string", "enum": ["delete", "memorialize", "transfer", "download_data", "no_action"] },
          "transfer_to_id": { "type": "string" }
        }
      }
    },
    "asset_instructions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "digital_asset_id": { "type": "string" },
          "beneficiary_id": { "type": "string" }
        }
      }
    },
    "final_messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "recipient_id": { "type": "string" },
          "platform": { "type": "string" },
          "send_trigger": { "type": "string", "enum": ["immediately", "on_anniversary", "after_n_days"] },
          "message_document_id": { "type": "string" }
        }
      }
    },
    "social_media_memorial": { "type": "string", "enum": ["memorialize_all", "delete_all", "per_account", "no_instruction"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": [
    "Define digital executor verification",
    "Define memorial account standards per platform",
    "Define posthumous message delivery",
    "Define digital legacy legal standing"
  ]
}
