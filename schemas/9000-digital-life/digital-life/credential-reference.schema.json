{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Credential Reference",
  "description": "A reference to stored credentials — not the credentials themselves. Points to a password manager entry or secure vault, enabling digital estate planning without exposing secrets.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^credential_ref_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "account_id": { "type": "string" },
    "service_name": { "type": "string" },
    "vault": { "type": "string", "description": "Password manager name (e.g., '1Password', 'Bitwarden')" },
    "vault_item_name": { "type": "string", "description": "Name of the item in the vault — no actual passwords stored" },
    "trusted_contact_id": { "type": "string", "description": "Person who can access vault in an emergency" },
    "emergency_instructions": { "type": "string", "description": "Instructions for trusted contact (not credentials)" },
    "notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "service_name", "vault"],
  "_phase1_todo": [
    "Define emergency access workflow",
    "Define trusted contact permissions",
    "Define vault integration API",
    "Define credential handover procedures"
  ]
}
