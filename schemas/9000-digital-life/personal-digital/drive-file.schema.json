{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Drive File",
  "description": "A file stored in cloud storage — Google Drive, iCloud, OneDrive, Dropbox, etc. Metadata only; content is not held in OLP.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^drive_file_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "provider": { "type": "string", "enum": ["google_drive", "icloud_drive", "onedrive", "dropbox", "box", "s3", "other"] },
    "provider_file_id": { "type": "string" },
    "name": { "type": "string" },
    "mime_type": { "type": "string" },
    "extension": { "type": "string" },
    "size_bytes": { "type": "integer" },
    "folder_id": { "type": "string" },
    "path": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "modified_at": { "type": "string", "format": "date-time" },
    "owner_email": { "type": "string", "format": "email" },
    "shared_with": { "type": "array", "items": { "type": "string", "format": "email" } },
    "is_shared": { "type": "boolean" },
    "web_view_link": { "type": "string", "format": "uri" },
    "classification": {
      "type": "string",
      "enum": ["identity_document", "legal", "financial", "medical", "insurance", "property", "employment", "education", "personal", "photo", "work", "other"],
      "description": "OLP-inferred document classification"
    },
    "linked_document_id": { "type": "string", "description": "Link to core OLP Document record if matched" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "provider", "name"],
  "_phase1_todo": [
    "Define document classification from filename and content",
    "Define auto-link drive files to OLP cases",
    "Define shared document access revocation on relationship end",
    "Define drive file estate inventory"
  ]
}
