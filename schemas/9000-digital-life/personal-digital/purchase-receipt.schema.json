{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Purchase Receipt",
  "description": "A purchase receipt — extracted from email, photo, or bank feed. The evidence layer for spending, subscriptions, warranties, and returns.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^receipt_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "source": { "type": "string", "enum": ["email_extracted", "photo_scan", "bank_feed", "manual", "api"] },
    "source_email_message_id": { "type": "string" },
    "source_drive_file_id": { "type": "string" },
    "merchant_name": { "type": "string" },
    "merchant_category": { "type": "string", "enum": ["retail", "food_drink", "travel", "accommodation", "fuel", "utilities", "health", "entertainment", "software", "hardware", "clothing", "groceries", "other"] },
    "transaction_date": { "type": "string", "format": "date" },
    "total_amount": { "type": "number" },
    "currency": { "type": "string" },
    "tax_amount": { "type": "number" },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "quantity": { "type": "number" },
          "unit_price": { "type": "number" },
          "subtotal": { "type": "number" }
        }
      }
    },
    "order_reference": { "type": "string" },
    "warranty_months": { "type": "integer" },
    "warranty_expiry": { "type": "string", "format": "date" },
    "returnable_until": { "type": "string", "format": "date" },
    "payment_method": { "type": "string" },
    "linked_transaction_id": { "type": "string" },
    "linked_subscription_id": { "type": "string" },
    "expense_claimable": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "source", "merchant_name", "transaction_date", "total_amount", "currency"],
  "_phase1_todo": [
    "Define receipt OCR + LLM extraction pipeline",
    "Define receipt-to-transaction matching",
    "Define warranty expiry reminders",
    "Define HMRC expense evidence standard"
  ]
}
