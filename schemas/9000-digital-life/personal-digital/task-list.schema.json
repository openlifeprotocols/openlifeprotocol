{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task List",
  "description": "A task list from a digital task manager — Google Tasks, Apple Reminders, Todoist, Things, etc. Links to OLP Tasks where possible.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^task_list_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "provider": { "type": "string", "enum": ["google_tasks", "apple_reminders", "todoist", "things", "microsoft_todo", "notion", "asana", "other"] },
    "provider_list_id": { "type": "string" },
    "name": { "type": "string" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider_task_id": { "type": "string" },
          "title": { "type": "string" },
          "notes": { "type": "string" },
          "due_date": { "type": "string", "format": "date" },
          "completed": { "type": "boolean" },
          "completed_at": { "type": "string", "format": "date-time" },
          "priority": { "type": "string", "enum": ["none", "low", "medium", "high"] },
          "olp_task_id": { "type": "string", "description": "Linked OLP Task if matched" }
        },
        "required": ["title"]
      }
    },
    "total_tasks": { "type": "integer" },
    "completed_tasks": { "type": "integer" },
    "last_synced": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "provider", "name"],
  "_phase1_todo": [
    "Define bidirectional OLP Task sync",
    "Define overdue task surfacing",
    "Define task-to-case auto-linking",
    "Define task completion triggers"
  ]
}
