{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bundle Document Link",
  "description": "Link between evidence bundle and document.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^bundle_document_link_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "evidence_bundle_id": { "type": "string" },
    "document_id": { "type": "string" },
    "document_role": { "type": "string", "enum": ["required", "supporting", "optional", "reference"] },
    "sequence_number": { "type": "integer" },
    "is_verified": { "type": "boolean" },
    "verification_date": { "type": "string", "format": "date" },
    "notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "evidence_bundle_id"],
  "_phase1_todo": ["Define verification workflow", "Define document staging", "Define quality checks"]
}
