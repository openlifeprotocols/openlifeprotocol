{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Bundle",
  "description": "Collection of documents bundled for specific purpose.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^evidence_bundle_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "bundle_type": { "type": "string", "enum": ["mortgage_application", "tax_filing", "insurance_claim", "court_case", "travel_document", "school_enrollment", "grant_application", "job_application", "other"] },
    "bundle_name": { "type": "string" },
    "bundle_description": { "type": "string" },
    "bundle_status": { "type": "string", "enum": ["draft", "ready", "submitted", "approved", "rejected", "archived"] },
    "documents_included": { "type": "array", "items": { "type": "string" } },
    "document_count": { "type": "integer" },
    "total_size_bytes": { "type": "integer" },
    "created_date": { "type": "string", "format": "date-time" },
    "submitted_date": { "type": "string", "format": "date-time" },
    "submission_recipient": { "type": "string" },
    "response_status": { "type": "string" },
    "response_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define checklist validation", "Define submission tracking", "Define response management"]
}
