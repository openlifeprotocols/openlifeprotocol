{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "School Event",
  "description": "School-related event or activity.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^school_event_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "child_id": { "type": "string" },
    "child_name": { "type": "string" },
    "event_name": { "type": "string" },
    "event_type": { "type": "string", "enum": ["academic", "sports", "arts", "social", "parent_teacher_meeting", "field_trip", "performance", "graduation", "other"] },
    "school_name": { "type": "string" },
    "event_date": { "type": "string", "format": "date" },
    "start_time": { "type": "string", "format": "time" },
    "location": { "type": "string" },
    "description": { "type": "string" },
    "organizer": { "type": "string" },
    "participants": { "type": "array", "items": { "type": "string" } },
    "parent_involvement": { "type": "string", "enum": ["attended", "helped_organize", "volunteered", "did_not_attend"] },
    "outcome_or_result": { "type": "string" },
    "achievements": { "type": "array", "items": { "type": "string" } },
    "memorable_moments": { "type": "string" },
    "photos": { "type": "array", "items": { "type": "string" } },
    "cost": { "type": "number" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "child_name", "event_name"],
  "_phase1_todo": ["Define school calendar sync", "Define achievement portfolio", "Define memory archival"]
}
