{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Care Arrangement",
  "description": "Child care or custody arrangement.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^care_arrangement_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "child_id": { "type": "string" },
    "child_name": { "type": "string" },
    "arrangement_type": { "type": "string", "enum": ["daycare", "preschool", "nanny", "au_pair", "family_care", "school_based", "after_school", "emergency", "other"] },
    "care_provider_name": { "type": "string" },
    "care_provider_organization": { "type": "string" },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "is_active": { "type": "boolean" },
    "hours_per_week": { "type": "number" },
    "schedule": { "type": "string" },
    "cost_per_month": { "type": "number" },
    "payment_frequency": { "type": "string" },
    "contact_phone": { "type": "string" },
    "contact_email": { "type": "string", "format": "email" },
    "location_address": { "type": "string" },
    "child_allergies_communicated": { "type": "array", "items": { "type": "string" } },
    "emergency_contacts_provided": { "type": "boolean" },
    "insurance_or_liability": { "type": "boolean" },
    "satisfactory_rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "child_feedback": { "type": "string" },
    "parent_notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "child_name", "arrangement_type"],
  "_phase1_todo": ["Define care schedule management", "Define payment tracking", "Define satisfaction metrics"]
}
