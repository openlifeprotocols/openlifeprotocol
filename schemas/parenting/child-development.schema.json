{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Child Development",
  "description": "Tracking child development milestones and progress.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^child_development_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "child_id": { "type": "string" },
    "child_name": { "type": "string" },
    "child_birth_date": { "type": "string", "format": "date" },
    "current_age": { "type": "string" },
    "developmental_stage": { "type": "string", "enum": ["infant", "toddler", "preschool", "early_elementary", "late_elementary", "middle_school", "high_school"] },
    "physical_milestones": { "type": "array", "items": { "type": "object", "properties": { "milestone": { "type": "string" }, "achieved_date": { "type": "string", "format": "date" }, "notes": { "type": "string" } } } },
    "cognitive_milestones": { "type": "array", "items": { "type": "object", "properties": { "milestone": { "type": "string" }, "achieved_date": { "type": "string", "format": "date" }, "notes": { "type": "string" } } } },
    "social_emotional_milestones": { "type": "array", "items": { "type": "object", "properties": { "milestone": { "type": "string" }, "achieved_date": { "type": "string", "format": "date" }, "notes": { "type": "string" } } } },
    "language_milestones": { "type": "array", "items": { "type": "object", "properties": { "milestone": { "type": "string" }, "achieved_date": { "type": "string", "format": "date" }, "notes": { "type": "string" } } } },
    "health_checkups": { "type": "array", "items": { "type": "string" } },
    "vaccinations": { "type": "array", "items": { "type": "string" } },
    "interests_and_talents": { "type": "array", "items": { "type": "string" } },
    "challenges_or_concerns": { "type": "array", "items": { "type": "string" } },
    "therapies_or_interventions": { "type": "array", "items": { "type": "string" } },
    "educational_progress": { "type": "string" },
    "personality_traits": { "type": "array", "items": { "type": "string" } },
    "memorable_moments": { "type": "array", "items": { "type": "string" } },
    "photos_and_media": { "type": "array", "items": { "type": "string" } },
    "pediatrician_name": { "type": "string" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "child_name"],
  "_phase1_todo": ["Define milestone alerts", "Define growth tracking", "Define parent comparison (anonymous)"]
}
