{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Journal Entry",
  "description": "A journal entry — diary entry, personal log, dated written reflection on thoughts, feelings, events.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^journal_entry_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "entry_date": { "type": "string", "format": "date" },
    "title": { "type": "string" },
    "content": { "type": "string" },
    "mood": { "type": "string", "enum": ["happy", "sad", "angry", "anxious", "peaceful", "excited", "confused", "neutral"] },
    "length_words": { "type": "integer" },
    "themes": { "type": "array", "items": { "type": "string" } },
    "people_mentioned": { "type": "array", "items": { "type": "string" } },
    "events_described": { "type": "array", "items": { "type": "string" } },
    "gratitude_mentioned": { "type": "array", "items": { "type": "string" } },
    "concerns_mentioned": { "type": "array", "items": { "type": "string" } },
    "privacy_level": { "type": "string", "enum": ["highly_personal", "personal", "semi_public", "sharable"] },
    "written_at": { "type": "string", "format": "time" },
    "revisited": { "type": "boolean" },
    "revisit_notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "entry_date", "content"],
  "_phase1_todo": [
    "Define mood tracking over time",
    "Define pattern detection in journaling",
    "Define private vs. shareable journal management"
  ]
}
