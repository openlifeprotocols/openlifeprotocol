{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chapter",
  "description": "A life chapter — distinct narrative segment with beginning and ending, themes, and resolution.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^chapter_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "title": { "type": "string" },
    "number": { "type": "integer" },
    "narrative": { "type": "string" },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "what_was_happening": { "type": "array", "items": { "type": "string" } },
    "central_challenge": { "type": "string" },
    "how_challenge_resolved": { "type": "string" },
    "theme": { "type": "string" },
    "mood": { "type": "string" },
    "major_events": { "type": "array", "items": { "type": "string" } },
    "key_relationships": { "type": "array", "items": { "type": "string" } },
    "how_ended": { "type": "string" },
    "what_learned": { "type": "string" },
    "how_changed": { "type": "string" },
    "reflection": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "title", "narrative"],
  "_phase1_todo": [
    "Define chapter narrative coherence checking",
    "Define chapter-to-theme mapping",
    "Define chapter sequencing and story arc"
  ]
}
