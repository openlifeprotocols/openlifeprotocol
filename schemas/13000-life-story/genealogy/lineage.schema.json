{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lineage",
  "description": "Family lineage or bloodline tracking.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^lineage_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "lineage_name": { "type": "string" },
    "primary_lineage": { "type": "string" },
    "lineage_origin_country": { "type": "string" },
    "lineage_origin_region": { "type": "string" },
    "earliest_known_ancestor": { "type": "string" },
    "earliest_ancestor_birth_year": { "type": "integer" },
    "lineage_history": { "type": "string" },
    "migration_patterns": { "type": "array", "items": { "type": "object", "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "approximate_date": { "type": "integer" } } } },
    "family_crests": { "type": "array", "items": { "type": "string" } },
    "family_motto": { "type": "string" },
    "genetic_markers": { "type": "array", "items": { "type": "string" } },
    "notable_ancestors": { "type": "array", "items": { "type": "string" } },
    "family_legends": { "type": "array", "items": { "type": "string" } },
    "genealogy_research_level": { "type": "string", "enum": ["basic", "intermediate", "comprehensive", "professional"] },
    "research_sources_used": { "type": "array", "items": { "type": "string" } },
    "dna_test_results": { "type": "array", "items": { "type": "string" } },
    "confirmed_connections": { "type": "integer" },
    "unresolved_mysteries": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "lineage_name"],
  "_phase1_todo": ["Define lineage tree visualization", "Define migration mapping", "Define genealogy research planning"]
}
