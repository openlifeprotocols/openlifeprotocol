{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event Document",
  "description": "Documents associated with life event.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^event_document_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "life_event_id": { "type": "string" },
    "document_id": { "type": "string" },
    "document_type": { "type": "string" },
    "document_role": { "type": "string", "enum": ["certificate", "permit", "license", "contract", "receipt", "photo", "video", "insurance", "legal_document", "other"] },
    "is_required": { "type": "boolean" },
    "is_received": { "type": "boolean" },
    "received_date": { "type": "string", "format": "date" },
    "expiration_date": { "type": "string", "format": "date" },
    "follow_up_action": { "type": "string" },
    "follow_up_deadline": { "type": "string", "format": "date" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "life_event_id"],
  "_phase1_todo": ["Define document checklist", "Define expiration alerts", "Define renewal tracking"]
}
