{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "End of Life Wishes",
  "description": "End of life care and funeral wishes.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^end_of_life_wishes_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "document_date": { "type": "string", "format": "date" },
    "medical_directives": { "type": "string" },
    "advance_directive_location": { "type": "string" },
    "organ_donation": { "type": "string", "enum": ["yes", "no", "partial", "undecided"] },
    "body_donation": { "type": "boolean" },
    "donation_organization": { "type": "string" },
    "burial_preference": { "type": "string", "enum": ["burial", "cremation", "green_burial", "sea_burial", "sky_burial", "natural_composting"] },
    "burial_location_preference": { "type": "string" },
    "cemetery_plot_owner": { "type": "string" },
    "plot_location": { "type": "string" },
    "cremation_preferences": { "type": "string" },
    "ashes_disposition": { "type": "string" },
    "headstone_or_memorial": { "type": "string" },
    "inscription": { "type": "string" },
    "funeral_service_preferences": { "type": "string" },
    "memorial_service_preferences": { "type": "string" },
    "religious_or_spiritual_practices": { "type": "array", "items": { "type": "string" } },
    "music_or_readings": { "type": "array", "items": { "type": "string" } },
    "people_to_speak": { "type": "array", "items": { "type": "string" } },
    "funeral_budget": { "type": "number" },
    "prepaid_arrangements": { "type": "array", "items": { "type": "string" } },
    "funeral_home_preference": { "type": "string" },
    "funeral_home_contact": { "type": "string" },
    "clothing_preference": { "type": "string" },
    "flowers_or_donations": { "type": "string" },
    "charity_donations_in_lieu": { "type": "array", "items": { "type": "string" } },
    "guest_list": { "type": "array", "items": { "type": "string" } },
    "do_not_invite": { "type": "array", "items": { "type": "string" } },
    "social_media_handling": { "type": "string" },
    "obituary_preferences": { "type": "string" },
    "digital_memorial_preferences": { "type": "string" },
    "letters_to_be_opened": { "type": "array", "items": { "type": "string" } },
    "family_heirlooms_distribution": { "type": "object", "additionalProperties": { "type": "string" } },
    "pets_care": { "type": "string" },
    "special_wishes": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define legal review", "Define family notification", "Define executor linking"]
}
