{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Legacy Message",
  "description": "Personal message or letter for legacy.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^legacy_message_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "message_type": { "type": "string", "enum": ["letter", "video_transcript", "voice_note", "final_wishes", "life_lessons", "apology", "gratitude", "instruction", "other"] },
    "intended_recipient": { "type": "string" },
    "recipient_type": { "type": "string", "enum": ["specific_person", "family", "friend", "organization", "public", "future_generations"] },
    "message_date_created": { "type": "string", "format": "date" },
    "delivery_date": { "type": "string", "format": "date" },
    "delivery_method": { "type": "string", "enum": ["upon_death", "on_specific_date", "upon_event", "never", "discretionary"] },
    "content": { "type": "string" },
    "tone": { "type": "string" },
    "key_themes": { "type": "array", "items": { "type": "string" } },
    "personal_stories_included": { "type": "array", "items": { "type": "string" } },
    "values_expressed": { "type": "array", "items": { "type": "string" } },
    "advice_given": { "type": "array", "items": { "type": "string" } },
    "media_attached": { "type": "array", "items": { "type": "string" } },
    "confidential": { "type": "boolean" },
    "executor_or_trustee_aware": { "type": "boolean" },
    "stored_location": { "type": "string" },
    "access_code": { "type": "string" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "message_type"],
  "_phase1_todo": ["Define message encryption", "Define delivery scheduling", "Define estate linking"]
}
