{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Memory Capsule",
  "description": "Personal memory capsule or time capsule.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^memory_capsule_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "capsule_name": { "type": "string" },
    "creation_date": { "type": "string", "format": "date" },
    "creation_year": { "type": "integer" },
    "current_age": { "type": "integer" },
    "life_stage": { "type": "string" },
    "intended_opening_date": { "type": "string", "format": "date" },
    "years_into_future": { "type": "integer" },
    "intended_recipients": { "type": "array", "items": { "type": "string" } },
    "theme": { "type": "string" },
    "description": { "type": "string" },
    "memories_included": { "type": "array", "items": { "type": "string" } },
    "current_hopes_and_dreams": { "type": "array", "items": { "type": "string" } },
    "advice_to_future_self": { "type": "array", "items": { "type": "string" } },
    "favorites_at_this_time": { "type": "object", "properties": { "song": { "type": "string" }, "book": { "type": "string" }, "movie": { "type": "string" }, "food": { "type": "string" }, "person": { "type": "string" }, "place": { "type": "string" } } },
    "most_important_people": { "type": "array", "items": { "type": "string" } },
    "proudest_achievement": { "type": "string" },
    "biggest_challenge": { "type": "string" },
    "letters_to_open": { "type": "array", "items": { "type": "string" } },
    "photos_or_media": { "type": "array", "items": { "type": "string" } },
    "artifacts_included": { "type": "array", "items": { "type": "string" } },
    "wishes_for_the_future": { "type": "array", "items": { "type": "string" } },
    "questions_for_reflection": { "type": "array", "items": { "type": "string" } },
    "physical_storage_location": { "type": "string" },
    "digital_storage_location": { "type": "string" },
    "seal_code": { "type": "string" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "capsule_name"],
  "_phase1_todo": ["Define capsule timeline alerts", "Define reflection prompts", "Define opening ceremony"]
}
