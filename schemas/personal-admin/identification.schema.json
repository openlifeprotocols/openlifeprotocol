{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Identification",
  "description": "Official identity document (passport, ID card, driver's license).",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^identification_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "document_type": { "type": "string", "enum": ["passport", "national_id", "drivers_license", "state_id", "travel_document", "work_permit"] },
    "document_number": { "type": "string" },
    "issuance_country": { "type": "string" },
    "issuance_date": { "type": "string", "format": "date" },
    "expiration_date": { "type": "string", "format": "date" },
    "is_expired": { "type": "boolean" },
    "issuing_authority": { "type": "string" },
    "document_page_count": { "type": "integer" },
    "mrz_line_one": { "type": "string" },
    "mrz_line_two": { "type": "string" },
    "document_id": { "type": "string" },
    "ocr_confidence": { "type": "number" },
    "verification_status": { "type": "string", "enum": ["not_verified", "pending", "verified", "expired"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "document_type"],
  "_phase1_todo": ["Define ID verification", "Define OCR extraction", "Define expiration tracking"]
}
