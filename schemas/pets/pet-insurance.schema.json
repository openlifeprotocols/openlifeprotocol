{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pet Insurance",
  "description": "A pet insurance policy — covering veterinary fees, third-party liability, and loss or death.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^pet_insurance_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "external_ids": {
      "type": "array",
      "items": { "type": "object", "properties": { "system": { "type": "string" }, "id": { "type": "string" } }, "required": ["system", "id"] }
    },
    "pet_id": { "type": "string" },
    "policy_holder_id": { "type": "string" },
    "insurer_id": { "type": "string" },
    "policy_number": { "type": "string" },
    "policy_type": { "type": "string", "enum": ["accident_only", "time_limited", "maximum_benefit", "lifetime"] },
    "vet_fee_limit": { "type": "number" },
    "vet_fee_limit_type": { "type": "string", "enum": ["per_condition_per_year", "per_condition", "annual", "lifetime"] },
    "third_party_liability_limit": { "type": "number" },
    "death_benefit": { "type": "number" },
    "loss_by_theft_benefit": { "type": "number" },
    "currency": { "type": "string" },
    "premium": {
      "type": "object",
      "properties": {
        "amount": { "type": "number" },
        "frequency": { "type": "string", "enum": ["monthly", "annual"] }
      }
    },
    "excess": { "type": "number" },
    "co_payment_percentage": { "type": "number" },
    "start_date": { "type": "string", "format": "date" },
    "renewal_date": { "type": "string", "format": "date" },
    "exclusions": { "type": "array", "items": { "type": "string" } },
    "pre_existing_conditions_excluded": { "type": "boolean" },
    "status": { "type": "string", "enum": ["active", "lapsed", "cancelled", "claimed"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "pet_id", "policy_holder_id", "insurer_id", "policy_number", "policy_type"],
  "_phase1_todo": [
    "Define claim workflow",
    "Define direct vet payment integration",
    "Define policy upgrade on breed change",
    "Define policy continuation after ownership transfer"
  ]
}
