{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Petition",
  "description": "Petition signing or creation.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^petition_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "petition_title": { "type": "string" },
    "issue": { "type": "string" },
    "target_organization": { "type": "string" },
    "requested_action": { "type": "string" },
    "petition_creator": { "type": "string" },
    "platform": { "type": "string", "enum": ["change_org", "avaaz", "care2", "local_government", "other"] },
    "petition_url": { "type": "string", "format": "uri" },
    "created_date_of_petition": { "type": "string", "format": "date" },
    "start_of_signature_collection": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "signature_target": { "type": "integer" },
    "signatures_achieved": { "type": "integer" },
    "signature_goal_reached": { "type": "boolean" },
    "sign_or_create": { "type": "string", "enum": ["signed", "created", "both"] },
    "date_signed": { "type": "string", "format": "date" },
    "reason_for_signing": { "type": "string" },
    "shared_on_social_media": { "type": "boolean" },
    "outcome": { "type": "string" },
    "action_taken_by_target": { "type": "string" },
    "success": { "type": "boolean" },
    "lessons_learned": { "type": "string" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "petition_title"],
  "_phase1_todo": ["Define petition tracking", "Define outcome monitoring", "Define advocacy impact"]
}
