{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sponsorship",
  "description": "Sponsorship or pledge commitment.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^sponsorship_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "sponsored_person_name": { "type": "string" },
    "event_or_cause": { "type": "string" },
    "sponsorship_type": { "type": "string", "enum": ["marathon", "charity_event", "educational", "sports", "arts", "other"] },
    "amount_per_unit": { "type": "number" },
    "unit_type": { "type": "string", "enum": ["mile", "kilometer", "item", "hour", "fixed"] },
    "expected_units": { "type": "number" },
    "expected_total_amount": { "type": "number" },
    "currency": { "type": "string" },
    "actual_amount_due": { "type": "number" },
    "amount_paid": { "type": "number" },
    "payment_deadline": { "type": "string", "format": "date" },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "beneficiary_charity": { "type": "string" },
    "payment_status": { "type": "string", "enum": ["pending", "partial", "paid", "overdue"] },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "sponsored_person_name"],
  "_phase1_todo": ["Define payment reminders", "Define progress tracking", "Define receipt generation"]
}
