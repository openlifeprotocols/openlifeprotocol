{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fundraiser",
  "description": "Personal fundraising campaign.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^fundraiser_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "fundraiser_name": { "type": "string" },
    "cause": { "type": "string" },
    "beneficiary_charity": { "type": "string" },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "target_amount": { "type": "number" },
    "amount_raised": { "type": "number" },
    "currency": { "type": "string" },
    "fundraiser_platform": { "type": "string", "enum": ["justgiving", "gofundme", "kickstarter", "other"] },
    "fundraiser_url": { "type": "string", "format": "uri" },
    "fundraiser_description": { "type": "string" },
    "activity_type": { "type": "string", "enum": ["marathon", "sponsored_challenge", "event", "birthday", "memorial"] },
    "donor_count": { "type": "integer" },
    "status": { "type": "string", "enum": ["active", "completed", "cancelled"] },
    "social_media_promoted": { "type": "boolean" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "fundraiser_name"],
  "_phase1_todo": ["Define platform integration", "Define social sharing", "Define analytics tracking"]
}
