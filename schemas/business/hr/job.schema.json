{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job",
  "description": "A job opening — a vacancy the business is recruiting for.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^job_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "business_id": { "type": "string" },
    "role_id": { "type": "string" },
    "department_id": { "type": "string" },
    "title": { "type": "string" },
    "employment_type": { "type": "string", "enum": ["permanent", "fixed_term", "contract", "internship", "apprenticeship"] },
    "location_id": { "type": "string" },
    "remote_policy": { "type": "string", "enum": ["fully_remote", "hybrid", "on_site"] },
    "salary_min": { "type": "number" },
    "salary_max": { "type": "number" },
    "currency": { "type": "string" },
    "hiring_manager_id": { "type": "string" },
    "recruiter_id": { "type": "string" },
    "posted_date": { "type": "string", "format": "date" },
    "close_date": { "type": "string", "format": "date" },
    "filled_date": { "type": "string", "format": "date" },
    "description": { "type": "string" },
    "requirements": { "type": "array", "items": { "type": "string" } },
    "candidate_ids": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["draft", "open", "on_hold", "filled", "cancelled"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "business_id", "title", "employment_type"],
  "_phase1_todo": ["Define job board integration", "Define blind recruitment flags", "Define salary banding compliance"]
}
