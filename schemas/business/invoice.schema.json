{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Invoice",
  "description": "A commercial invoice for goods or services supplied between businesses or to consumers.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^invoice_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "external_ids": {
      "type": "array",
      "items": { "type": "object", "properties": { "system": { "type": "string" }, "id": { "type": "string" } }, "required": ["system", "id"] }
    },
    "invoice_number": { "type": "string" },
    "supplier_id": { "type": "string" },
    "customer_id": { "type": "string" },
    "issue_date": { "type": "string", "format": "date" },
    "due_date": { "type": "string", "format": "date" },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "quantity": { "type": "number" },
          "unit_price": { "type": "number" },
          "vat_rate": { "type": "number" },
          "subtotal": { "type": "number" }
        }
      }
    },
    "subtotal": { "type": "number" },
    "vat_amount": { "type": "number" },
    "total": { "type": "number" },
    "currency": { "type": "string" },
    "payment_terms": { "type": "string", "examples": ["30 days net", "immediate"] },
    "status": { "type": "string", "enum": ["draft", "sent", "partial", "paid", "overdue", "disputed", "cancelled"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "invoice_number", "supplier_id", "customer_id", "issue_date", "total", "currency"],
  "_phase1_todo": [
    "Define e-invoicing compliance (Peppol)",
    "Define invoice dispute resolution",
    "Define automatic payment reconciliation",
    "Define VAT invoice validation rules"
  ]
}
