{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Objective",
  "description": "A strategic objective — a qualitative goal the business wants to achieve in a period.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^objective_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "business_id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "period": { "type": "string", "description": "e.g., Q2 2026, FY2026" },
    "owner_id": { "type": "string" },
    "parent_objective_id": { "type": "string" },
    "key_result_ids": { "type": "array", "items": { "type": "string" } },
    "initiative_ids": { "type": "array", "items": { "type": "string" } },
    "progress": { "type": "integer", "minimum": 0, "maximum": 100 },
    "status": { "type": "string", "enum": ["on_track", "at_risk", "off_track", "complete"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "business_id", "title", "period"],
  "_phase1_todo": ["Define OKR alignment across levels", "Define objective scoring", "Define quarterly review workflow"]
}
