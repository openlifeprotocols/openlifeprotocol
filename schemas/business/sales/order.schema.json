{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order (Sales)",
  "description": "A confirmed sales order — customer has accepted and the business is committed to deliver.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^sales_order_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "business_id": { "type": "string" },
    "customer_id": { "type": "string" },
    "opportunity_id": { "type": "string" },
    "sales_quote_id": { "type": "string" },
    "commerce_order_id": { "type": "string", "description": "Reference to commerce/order.schema.json" },
    "owner_id": { "type": "string" },
    "order_date": { "type": "string", "format": "date" },
    "required_by_date": { "type": "string", "format": "date" },
    "value": { "type": "number" },
    "currency": { "type": "string" },
    "fulfilment_status": { "type": "string", "enum": ["pending", "in_progress", "partially_fulfilled", "fulfilled", "cancelled"] },
    "status": { "type": "string", "enum": ["confirmed", "processing", "complete", "cancelled"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "business_id", "customer_id", "order_date", "value", "currency"],
  "_phase1_todo": ["Define order-to-cash workflow", "Define fulfilment tracking", "Define revenue recognition on order"]
}
