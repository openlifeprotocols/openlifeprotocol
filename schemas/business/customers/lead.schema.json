{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lead",
  "description": "A sales lead — an individual or company that has shown interest but not yet qualified.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^lead_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "business_id": { "type": "string" },
    "name": { "type": "string" },
    "company": { "type": "string" },
    "email": { "type": "string", "format": "email" },
    "phone": { "type": "string" },
    "source": { "type": "string", "enum": ["website", "referral", "social_media", "event", "cold_outreach", "inbound_call", "paid_ad", "partner", "other"] },
    "source_detail": { "type": "string" },
    "owner_id": { "type": "string" },
    "lead_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "interest": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "converted_at": { "type": "string", "format": "date-time" },
    "converted_to_prospect_id": { "type": "string" },
    "status": { "type": "string", "enum": ["new", "contacted", "qualified", "converted", "disqualified"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "business_id", "name"],
  "_phase1_todo": ["Define lead scoring model", "Define lead routing rules", "Define lead nurture sequences"]
}
