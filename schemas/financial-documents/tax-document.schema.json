{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tax Document",
  "description": "Tax return or tax-related document.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^tax_document_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "tax_year": { "type": "integer" },
    "tax_type": { "type": "string", "enum": ["income_tax", "capital_gains", "property_tax", "sales_tax", "business_tax", "estate_tax", "gift_tax", "other"] },
    "filing_status": { "type": "string", "enum": ["single", "married_filing_jointly", "married_filing_separately", "head_of_household", "qualifying_widow", "other"] },
    "tax_return_form": { "type": "string", "enum": ["1040", "1040_ez", "1040_a", "1120", "1120s", "1065", "990", "other"] },
    "tax_jurisdiction": { "type": "string" },
    "gross_income": { "type": "number" },
    "tax_liability": { "type": "number" },
    "tax_paid": { "type": "number" },
    "refund_amount": { "type": "number" },
    "filing_date": { "type": "string", "format": "date" },
    "filing_method": { "type": "string", "enum": ["e_file", "paper", "representative_filed"] },
    "acceptance_date": { "type": "string", "format": "date" },
    "document_id": { "type": "string" },
    "upload_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define supporting document linkage", "Define audit readiness", "Define tax projection"]
}
