{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Payslip",
  "description": "Employment pay statement or payslip.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^payslip_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "employment_id": { "type": "string" },
    "employer_name": { "type": "string" },
    "pay_period_start": { "type": "string", "format": "date" },
    "pay_period_end": { "type": "string", "format": "date" },
    "payment_date": { "type": "string", "format": "date" },
    "gross_pay": { "type": "number" },
    "net_pay": { "type": "number" },
    "tax_withheld": { "type": "number" },
    "social_security": { "type": "number" },
    "medicare": { "type": "number" },
    "pension_contribution": { "type": "number" },
    "health_insurance": { "type": "number" },
    "deductions": { "type": "array", "items": { "type": "object", "properties": { "description": { "type": "string" }, "amount": { "type": "number" } } } },
    "currency": { "type": "string" },
    "document_id": { "type": "string" },
    "upload_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define income verification", "Define tax document generation", "Define year-to-date tracking"]
}
