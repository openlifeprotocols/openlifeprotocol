{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Emotion",
  "description": "A documented emotion — feeling experienced, trigger, intensity, physical sensations, how it was processed.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^emotion_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "emotion_type": { "type": "string", "enum": ["joy", "sadness", "anger", "fear", "surprise", "disgust", "love", "shame", "guilt", "jealousy", "envy", "hope", "despair", "contentment", "frustration", "anxiety", "peace", "excitement"] },
    "intensity": { "type": "integer", "minimum": 1, "maximum": 10 },
    "date_felt": { "type": "string", "format": "date" },
    "trigger": { "type": "string" },
    "situation": { "type": "string" },
    "duration": { "type": "string" },
    "physical_sensations": { "type": "array", "items": { "type": "string" } },
    "thoughts_during": { "type": "array", "items": { "type": "string" } },
    "actions_taken": { "type": "array", "items": { "type": "string" } },
    "how_expressed": { "type": "string" },
    "who_was_present": { "type": "array", "items": { "type": "string" } },
    "how_processed": { "type": "string" },
    "how_resolved": { "type": "string" },
    "learnings": { "type": "array", "items": { "type": "string" } },
    "linked_event_id": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "emotion_type", "date_felt"],
  "_phase1_todo": [
    "Define emotion pattern analysis over time",
    "Define emotion-to-trigger mapping",
    "Define emotion regulation strategy effectiveness"
  ]
}
