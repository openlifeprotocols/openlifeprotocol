{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pension",
  "description": "A pension scheme membership record — workplace or personal pension.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^pension_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "external_ids": {
      "type": "array",
      "items": { "type": "object", "properties": { "system": { "type": "string" }, "id": { "type": "string" } }, "required": ["system", "id"] }
    },
    "person_id": { "type": "string" },
    "employer_id": { "type": "string" },
    "provider_id": { "type": "string" },
    "pension_type": { "type": "string", "enum": ["defined_contribution", "defined_benefit", "state_pension", "sipp", "annuity"] },
    "scheme_name": { "type": "string" },
    "member_number": { "type": "string" },
    "start_date": { "type": "string", "format": "date" },
    "opted_out_date": { "type": "string", "format": "date" },
    "employee_contribution_rate": { "type": "number", "description": "Percentage of salary" },
    "employer_contribution_rate": { "type": "number" },
    "current_value": { "type": "number" },
    "currency": { "type": "string" },
    "retirement_date": { "type": "string", "format": "date" },
    "beneficiary_ids": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["active", "deferred", "drawing", "closed"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "pension_type", "scheme_name"],
  "_phase1_todo": [
    "Define pension tracing",
    "Define pension consolidation workflows",
    "Define state pension top-up",
    "Define pension on death/divorce procedures"
  ]
}
