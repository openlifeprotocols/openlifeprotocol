{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contact",
  "description": "An individual contact at a customer or prospect organisation.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^contact_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "business_id": { "type": "string" },
    "account_id": { "type": "string" },
    "person_id": { "type": "string" },
    "given_name": { "type": "string" },
    "family_name": { "type": "string" },
    "job_title": { "type": "string" },
    "department": { "type": "string" },
    "email": { "type": "string", "format": "email" },
    "phone": { "type": "string" },
    "linkedin": { "type": "string" },
    "role_in_deal": { "type": "string", "enum": ["decision_maker", "champion", "influencer", "blocker", "user", "economic_buyer", "technical_buyer"] },
    "opted_in_marketing": { "type": "boolean" },
    "owner_id": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "unsubscribed", "bounced", "left_company"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "business_id", "given_name", "family_name"],
  "_phase1_todo": ["Define contact merge/deduplicate", "Define GDPR consent tracking", "Define contact enrichment"]
}
