{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "policy (Compliance Risk)",
  "description": "Business compliance-risk schema for policy.",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "uuid": { "type": "string", "format": "uuid" },
    "business_id": { "type": "string" },
    "name": { "type": "string" },
    "owner_id": { "type": "string" },
    "review_date": { "type": "string", "format": "date" },
    "status": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "business_id", "name"],
  "_phase1_todo": ["Define policy framework", "Define policy review workflow", "Define policy audit trail"]
}
