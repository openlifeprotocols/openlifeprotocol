{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Legal Entity",
  "description": "The legal incorporation details of a business — registration, company number, directors, and statutory obligations.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^legal_entity_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "business_id": { "type": "string" },
    "company_number": { "type": "string" },
    "registered_name": { "type": "string" },
    "entity_type": { "type": "string", "enum": ["private_limited", "public_limited", "llp", "charity", "cic", "sole_trader", "partnership", "other"] },
    "jurisdiction_id": { "type": "string" },
    "incorporation_date": { "type": "string", "format": "date" },
    "dissolution_date": { "type": "string", "format": "date" },
    "registered_address_id": { "type": "string" },
    "vat_number": { "type": "string" },
    "charity_number": { "type": "string" },
    "utr": { "type": "string", "description": "Unique Taxpayer Reference" },
    "paye_reference": { "type": "string" },
    "share_capital": { "type": "number" },
    "currency": { "type": "string" },
    "sic_codes": { "type": "array", "items": { "type": "string" } },
    "filing_deadlines": {
      "type": "object",
      "properties": {
        "confirmation_statement": { "type": "string", "format": "date" },
        "accounts": { "type": "string", "format": "date" },
        "tax_return": { "type": "string", "format": "date" }
      }
    },
    "status": { "type": "string", "enum": ["active", "dormant", "struck_off", "dissolved", "in_liquidation"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "business_id", "entity_type"],
  "_phase1_todo": ["Define Companies House integration", "Define confirmation statement automation", "Define PSC register", "Define group structure"]
}
