{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate",
  "description": "A job candidate — a person being considered for a vacancy.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^candidate_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "business_id": { "type": "string" },
    "job_id": { "type": "string" },
    "person_id": { "type": "string" },
    "given_name": { "type": "string" },
    "family_name": { "type": "string" },
    "email": { "type": "string", "format": "email" },
    "phone": { "type": "string" },
    "source": { "type": "string", "enum": ["job_board", "referral", "linkedin", "agency", "direct_application", "internal", "other"] },
    "cv_document_id": { "type": "string" },
    "application_date": { "type": "string", "format": "date" },
    "interview_ids": { "type": "array", "items": { "type": "string" } },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "offer_made": { "type": "boolean" },
    "offer_accepted": { "type": "boolean" },
    "start_date": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["applied", "screening", "interviewing", "offer", "hired", "rejected", "withdrawn"] },
    "rejection_reason": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "business_id", "job_id", "given_name", "family_name"],
  "_phase1_todo": ["Define GDPR data retention for candidates", "Define diversity monitoring", "Define candidate re-engagement workflow"]
}
