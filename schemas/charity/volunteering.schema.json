{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Volunteering",
  "description": "Volunteer opportunity or position.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^volunteering_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "organization_name": { "type": "string" },
    "volunteer_role": { "type": "string" },
    "role_description": { "type": "string" },
    "volunteer_type": { "type": "string", "enum": ["regular", "one_time_event", "project_based", "skills_based", "mentor"] },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "is_ongoing": { "type": "boolean" },
    "frequency": { "type": "string", "enum": ["daily", "weekly", "bi_weekly", "monthly", "as_needed"] },
    "time_commitment_hours_per_period": { "type": "number" },
    "contact_name": { "type": "string" },
    "contact_email": { "type": "string" },
    "location": { "type": "string" },
    "total_hours_volunteered": { "type": "number" },
    "volunteer_credential_issued": { "type": "boolean" },
    "certificate_document_id": { "type": "string" },
    "impact_description": { "type": "string" },
    "skills_used": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["active", "completed", "on_leave", "ended"] },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "organization_name"],
  "_phase1_todo": ["Define hours tracking", "Define certificate management", "Define impact measurement"]
}
