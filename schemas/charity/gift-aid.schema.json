{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gift Aid",
  "description": "UK Gift Aid tax relief claim.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^gift_aid_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "charity_id": { "type": "string" },
    "charity_name": { "type": "string" },
    "donation_ids": { "type": "array", "items": { "type": "string" } },
    "donation_period_start": { "type": "string", "format": "date" },
    "donation_period_end": { "type": "string", "format": "date" },
    "total_donations": { "type": "number" },
    "tax_relief_amount": { "type": "number" },
    "currency": { "type": "string" },
    "gift_aid_declaration_signed": { "type": "boolean" },
    "declaration_date": { "type": "string", "format": "date" },
    "claim_status": { "type": "string", "enum": ["not_claimed", "claimed", "received", "verified"] },
    "claim_date": { "type": "string", "format": "date" },
    "claim_reference": { "type": "string" },
    "document_id": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "charity_name"],
  "_phase1_todo": ["Define eligibility verification", "Define claim automation", "Define HMRC integration"]
}
