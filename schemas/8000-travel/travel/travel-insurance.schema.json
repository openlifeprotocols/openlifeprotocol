{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Travel Insurance",
  "description": "A travel insurance policy covering medical, cancellation, baggage, and liability during a trip.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^travel_insurance_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "external_ids": {
      "type": "array",
      "items": { "type": "object", "properties": { "system": { "type": "string" }, "id": { "type": "string" } }, "required": ["system", "id"] }
    },
    "policy_holder_id": { "type": "string" },
    "insured_traveller_ids": { "type": "array", "items": { "type": "string" } },
    "trip_id": { "type": "string" },
    "insurer_id": { "type": "string" },
    "policy_number": { "type": "string" },
    "policy_type": { "type": "string", "enum": ["single_trip", "annual_multi_trip", "backpacker", "cruise"] },
    "cover": {
      "type": "object",
      "properties": {
        "medical_emergency_limit": { "type": "number" },
        "cancellation_limit": { "type": "number" },
        "baggage_limit": { "type": "number" },
        "single_item_limit": { "type": "number" },
        "personal_liability_limit": { "type": "number" },
        "travel_delay_hours": { "type": "integer" },
        "travel_delay_payout": { "type": "number" }
      }
    },
    "excess": { "type": "number" },
    "currency": { "type": "string" },
    "premium": { "type": "number" },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "destinations_covered": { "type": "array", "items": { "type": "string" } },
    "pre_existing_conditions_covered": { "type": "boolean" },
    "emergency_phone": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "expired", "claimed", "cancelled"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "policy_holder_id", "insurer_id", "policy_number", "policy_type"],
  "_phase1_todo": [
    "Define emergency assistance integration",
    "Define claim submission workflow",
    "Define FCDO travel advice impact on cover",
    "Define pre-existing condition screening"
  ]
}
