{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Transport",
  "description": "A ground or sea transport leg — train, bus, ferry, taxi, car hire, or transfer.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^transport_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "booking_id": { "type": "string" },
    "trip_id": { "type": "string" },
    "transport_type": { "type": "string", "enum": ["train", "bus_coach", "ferry", "taxi", "rideshare", "car_hire", "private_transfer", "tram", "metro", "cable_car", "bicycle_hire", "other"] },
    "operator": { "type": "string" },
    "booking_reference": { "type": "string" },
    "departure_location": { "type": "string" },
    "arrival_location": { "type": "string" },
    "departure_datetime": { "type": "string", "format": "date-time" },
    "arrival_datetime": { "type": "string", "format": "date-time" },
    "duration_minutes": { "type": "integer" },
    "traveller_ids": { "type": "array", "items": { "type": "string" } },
    "vehicle_class": { "type": "string", "examples": ["first_class", "standard", "economy"] },
    "vehicle_registration": { "type": "string" },
    "cost": { "type": "number" },
    "currency": { "type": "string" },
    "status": { "type": "string", "enum": ["confirmed", "in_progress", "complete", "cancelled", "delayed"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "transport_type", "departure_location", "arrival_location", "departure_datetime"],
  "_phase1_todo": [
    "Define interrail/Eurail pass integration",
    "Define live departure board integration",
    "Define accessibility requirements",
    "Define car hire damage deposit tracking"
  ]
}
