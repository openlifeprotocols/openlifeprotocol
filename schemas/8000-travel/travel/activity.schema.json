{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Activity",
  "description": "A travel activity, tour, or experience — excursion, day trip, attraction visit, or restaurant booking.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^activity_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "trip_id": { "type": "string" },
    "itinerary_day_date": { "type": "string", "format": "date" },
    "name": { "type": "string" },
    "activity_type": { "type": "string", "enum": ["tour", "excursion", "attraction", "adventure_sport", "dining", "show_event", "wellness", "shopping", "sport", "cultural", "volunteering", "other"] },
    "provider": { "type": "string" },
    "booking_reference": { "type": "string" },
    "location": { "type": "string" },
    "start_datetime": { "type": "string", "format": "date-time" },
    "end_datetime": { "type": "string", "format": "date-time" },
    "duration_hours": { "type": "number" },
    "participants": { "type": "array", "items": { "type": "string" } },
    "cost_per_person": { "type": "number" },
    "total_cost": { "type": "number" },
    "currency": { "type": "string" },
    "meeting_point": { "type": "string" },
    "what_to_bring": { "type": "array", "items": { "type": "string" } },
    "min_age": { "type": "integer" },
    "fitness_level": { "type": "string", "enum": ["low", "moderate", "high", "extreme"] },
    "status": { "type": "string", "enum": ["planned", "booked", "complete", "cancelled"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "trip_id", "name", "activity_type", "start_datetime"],
  "_phase1_todo": [
    "Define activity recommendation engine",
    "Define accessibility suitability flags",
    "Define cancellation refund workflow",
    "Define group activity split payment"
  ]
}
