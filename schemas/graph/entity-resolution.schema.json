{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entity Resolution",
  "description": "Resolution of duplicate or conflicting entities.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^entity_resolution_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "entity_type": { "type": "string" },
    "candidate_entities": { "type": "array", "items": { "type": "object", "properties": { "entity_id": { "type": "string" }, "similarity_score": { "type": "number" }, "differences": { "type": "array", "items": { "type": "string" } } } } },
    "resolution_status": { "type": "string", "enum": ["pending", "resolved", "rejected", "manual_review_needed"] },
    "proposed_merge_target": { "type": "string" },
    "resolution_method": { "type": "string", "enum": ["automatic", "user_confirmed", "manual", "system_rule"] },
    "merge_strategy": { "type": "string", "enum": ["keep_first", "keep_newest", "merge_fields", "manual_selection"] },
    "resolution_date": { "type": "string", "format": "date-time" },
    "resolved_by_person_id": { "type": "string" },
    "notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "entity_type"],
  "_phase1_todo": ["Define resolution workflows", "Define conflict handling", "Define audit trail"]
}
