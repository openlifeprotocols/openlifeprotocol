{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Certification",
  "description": "Professional certification or credential.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^certification_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "certification_name": { "type": "string" },
    "issuing_organization": { "type": "string" },
    "certification_number": { "type": "string" },
    "issue_date": { "type": "string", "format": "date" },
    "expiration_date": { "type": "string", "format": "date" },
    "is_active": { "type": "boolean" },
    "renewal_required": { "type": "boolean" },
    "renewal_frequency_months": { "type": "integer" },
    "document_id": { "type": "string" },
    "verification_url": { "type": "string", "format": "uri" },
    "verification_code": { "type": "string" },
    "field_of_study": { "type": "string" },
    "specialization": { "type": "string" },
    "cost": { "type": "number" },
    "renewal_cost": { "type": "number" },
    "maintenance_requirements": { "type": "string" },
    "competency_areas": { "type": "array", "items": { "type": "string" } },
    "associated_credentials": { "type": "array", "items": { "type": "string" } },
    "renewal_alert_sent": { "type": "boolean" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "certification_name"],
  "_phase1_todo": ["Define renewal alerts", "Define verification automation", "Define credential portfolio"]
}
