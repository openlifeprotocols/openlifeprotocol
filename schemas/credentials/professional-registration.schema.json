{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Professional Registration",
  "description": "Professional registration or regulatory board membership.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^professional_registration_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "profession": { "type": "string" },
    "regulatory_body": { "type": "string" },
    "jurisdiction": { "type": "string" },
    "registration_number": { "type": "string" },
    "registration_type": { "type": "string" },
    "registration_date": { "type": "string", "format": "date" },
    "expiration_date": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["active", "inactive", "restricted", "suspended", "revoked"] },
    "standing": { "type": "string", "enum": ["good", "under_review", "under_probation"] },
    "scope_of_practice": { "type": "array", "items": { "type": "string" } },
    "conditions_or_restrictions": { "type": "array", "items": { "type": "string" } },
    "continuing_education_credits": { "type": "integer" },
    "ce_credits_required": { "type": "integer" },
    "ce_tracking_deadline": { "type": "string", "format": "date" },
    "annual_fees": { "type": "number" },
    "complaints_history": { "type": "integer" },
    "verification_url": { "type": "string", "format": "uri" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "profession"],
  "_phase1_todo": ["Define CE tracking automation", "Define standing verification", "Define compliance auditing"]
}
