{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consulting Engagement",
  "description": "A consulting engagement delivered by the person.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^consulting_engagement_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "client_id": { "type": "string" },
    "statement_of_work_id": { "type": "string" },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["pipeline", "active", "completed", "cancelled"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "status"]
}
