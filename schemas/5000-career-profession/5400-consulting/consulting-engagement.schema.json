{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consulting Engagement",
  "description": "A consulting engagement between a professional and a client organisation.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^consulting_engagement_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "client_name": { "type": "string" },
    "scope": { "type": "string" },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "commercial_model": { "type": "string", "enum": ["fixed_fee", "time_and_materials", "retainer", "success_fee"] },
    "status": { "type": "string", "enum": ["prospective", "active", "paused", "completed", "terminated"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "client_name", "status"]
}
