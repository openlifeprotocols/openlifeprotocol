{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Statement of Work",
  "description": "A consulting SOW defining scope, deliverables, and terms for an engagement.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^sow_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "engagement_id": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "deliverables": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "fee_amount": { "type": "number" },
    "currency": { "type": "string" },
    "effective_date": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["draft", "sent", "agreed", "superseded", "cancelled"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "engagement_id", "version", "status"]
}
