{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Professional Referral",
  "description": "A referral passed or received in a professional context.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^professional_referral_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "from_person_id": { "type": "string" },
    "to_person_id": { "type": "string" },
    "referral_type": { "type": "string", "enum": ["job", "client", "investor", "advisor", "collaboration", "other"] },
    "status": { "type": "string", "enum": ["suggested", "introduced", "in_progress", "converted", "closed"] },
    "outcome": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "referral_type", "status"]
}
