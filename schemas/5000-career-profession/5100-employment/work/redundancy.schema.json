{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Redundancy",
  "description": "A redundancy record — the termination of employment because the role no longer exists.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^redundancy_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "employment_id": { "type": "string" },
    "employee_id": { "type": "string" },
    "employer_id": { "type": "string" },
    "redundancy_type": { "type": "string", "enum": ["compulsory", "voluntary", "collective"] },
    "reason": { "type": "string" },
    "at_risk_date": { "type": "string", "format": "date" },
    "notice_given_date": { "type": "string", "format": "date" },
    "effective_date": { "type": "string", "format": "date" },
    "consultation_start": { "type": "string", "format": "date" },
    "statutory_redundancy_pay": { "type": "number" },
    "enhanced_redundancy_pay": { "type": "number" },
    "notice_pay": { "type": "number" },
    "holiday_pay_owed": { "type": "number" },
    "currency": { "type": "string" },
    "payment_date": { "type": "string", "format": "date" },
    "appeal_lodged": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "employment_id", "redundancy_type", "effective_date"],
  "_phase1_todo": [
    "Define collective redundancy (30+ employees) procedures",
    "Define selection criteria fairness checks",
    "Define HMRC redundancy payment notifications",
    "Define redundancy appeal workflows"
  ]
}
