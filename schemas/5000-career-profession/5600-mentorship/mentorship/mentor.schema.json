{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mentor",
  "description": "Mentorship relationship - mentor perspective.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^mentor_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "mentee_name": { "type": "string" },
    "mentee_contact": { "type": "string" },
    "relationship_type": { "type": "string", "enum": ["professional", "personal", "academic", "life_coaching"] },
    "mentorship_focus": { "type": "array", "items": { "type": "string" } },
    "started_date": { "type": "string", "format": "date" },
    "duration_months": { "type": "integer" },
    "meeting_frequency": { "type": "string", "enum": ["weekly", "biweekly", "monthly", "as_needed"] },
    "meeting_format": { "type": "string", "enum": ["in_person", "phone", "video", "email", "mixed"] },
    "mentee_background": { "type": "string" },
    "initial_goals": { "type": "array", "items": { "type": "string" } },
    "achievements": { "type": "array", "items": { "type": "string" } },
    "growth_observed": { "type": "string" },
    "challenges_addressed": { "type": "array", "items": { "type": "string" } },
    "mentee_strengths": { "type": "array", "items": { "type": "string" } },
    "areas_for_development": { "type": "array", "items": { "type": "string" } },
    "resources_shared": { "type": "array", "items": { "type": "string" } },
    "mentorship_satisfaction": { "type": "number", "minimum": 1, "maximum": 5 },
    "would_mentor_again": { "type": "boolean" },
    "impact_on_mentor": { "type": "string" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "mentee_name"],
  "_phase1_todo": ["Define mentorship matching", "Define progress tracking", "Define impact measurement"]
}
