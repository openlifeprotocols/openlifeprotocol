{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recruiter Contact",
  "description": "A recruiter relationship relevant to active or passive job search.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^recruiter_contact_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "recruiter_person_id": { "type": "string" },
    "firm": { "type": "string" },
    "specialism": { "type": "string" },
    "last_contact_date": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["new", "active", "warm", "cold", "closed"] },
    "notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "status"]
}
