{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job Interview",
  "description": "Interview event for a job search process.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^job_interview_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "application_id": { "type": "string", "description": "Reference to opportunities/application" },
    "stage": { "type": "string", "enum": ["screening", "technical", "panel", "final", "informal"] },
    "date": { "type": "string", "format": "date-time" },
    "outcome": { "type": "string", "enum": ["pending", "passed", "failed", "withdrawn"] },
    "notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "stage"]
}
