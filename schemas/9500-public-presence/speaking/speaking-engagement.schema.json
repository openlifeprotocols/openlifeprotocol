{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Speaking Engagement",
  "description": "Public speaking engagement or presentation.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^speaking_engagement_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "event_name": { "type": "string" },
    "event_type": { "type": "string", "enum": ["conference", "workshop", "panel", "keynote", "webinar", "interview", "podcast", "teaching", "other"] },
    "organization": { "type": "string" },
    "event_date": { "type": "string", "format": "date" },
    "location": { "type": "string" },
    "venue_name": { "type": "string" },
    "estimated_audience_size": { "type": "integer" },
    "topic": { "type": "string" },
    "talk_duration_minutes": { "type": "integer" },
    "talk_title": { "type": "string" },
    "talk_description": { "type": "string" },
    "co_speakers": { "type": "array", "items": { "type": "string" } },
    "moderator": { "type": "string" },
    "slides_url": { "type": "string", "format": "uri" },
    "video_url": { "type": "string", "format": "uri" },
    "media_coverage": { "type": "array", "items": { "type": "string" } },
    "social_media_impressions": { "type": "integer" },
    "speaker_fees": { "type": "number" },
    "travel_accommodations_provided": { "type": "boolean" },
    "feedback_received": { "type": "number", "minimum": 1, "maximum": 5 },
    "key_takeaways_shared": { "type": "array", "items": { "type": "string" } },
    "networking_connections": { "type": "array", "items": { "type": "string" } },
    "follow_up_opportunities": { "type": "array", "items": { "type": "string" } },
    "impact_on_reputation": { "type": "string" },
    "would_repeat": { "type": "boolean" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "event_name"],
  "_phase1_todo": ["Define speaking career tracking", "Define impact measurement", "Define opportunity pipeline"]
}
