{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public Profile",
  "description": "Public profile or online presence.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^public_profile_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "profile_name": { "type": "string" },
    "platform": { "type": "string", "enum": ["linkedin", "twitter", "github", "instagram", "blog", "personal_website", "medium", "substack", "other"] },
    "profile_url": { "type": "string", "format": "uri" },
    "username": { "type": "string" },
    "bio": { "type": "string" },
    "profile_picture": { "type": "string" },
    "banner_image": { "type": "string" },
    "followers_count": { "type": "integer" },
    "following_count": { "type": "integer" },
    "engagement_rate": { "type": "number" },
    "profile_views_monthly": { "type": "integer" },
    "verified": { "type": "boolean" },
    "verification_status": { "type": "string" },
    "key_content_themes": { "type": "array", "items": { "type": "string" } },
    "posting_frequency": { "type": "string" },
    "audience_demographics": { "type": "object", "properties": { "age_groups": { "type": "array" }, "geographic_regions": { "type": "array" }, "interests": { "type": "array" } } },
    "brand_partnerships": { "type": "array", "items": { "type": "string" } },
    "sponsored_content": { "type": "integer" },
    "monetization_status": { "type": "string" },
    "income_from_profile": { "type": "number" },
    "professional_goals": { "type": "array", "items": { "type": "string" } },
    "content_calendar": { "type": "boolean" },
    "analytics_tracked": { "type": "boolean" },
    "reputation_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "crisis_incidents": { "type": "array", "items": { "type": "string" } },
    "moderation_policy": { "type": "string" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "platform"],
  "_phase1_todo": ["Define profile analytics", "Define audience growth", "Define engagement optimization"]
}
