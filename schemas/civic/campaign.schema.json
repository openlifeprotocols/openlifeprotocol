{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campaign",
  "description": "Political or civic campaign participation.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^campaign_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "campaign_name": { "type": "string" },
    "campaign_type": { "type": "string", "enum": ["political_candidate", "ballot_measure", "advocacy", "fundraising", "awareness", "other"] },
    "issue_or_candidate": { "type": "string" },
    "organization_or_party": { "type": "string" },
    "campaign_start_date": { "type": "string", "format": "date" },
    "campaign_end_date": { "type": "string", "format": "date" },
    "involvement_level": { "type": "string", "enum": ["voter", "donor", "volunteer", "organizer", "coordinator", "candidate"] },
    "volunteer_hours": { "type": "number" },
    "donation_amount": { "type": "number" },
    "roles_held": { "type": "array", "items": { "type": "string" } },
    "activities_participated": { "type": "array", "items": { "type": "string" } },
    "connections_made": { "type": "array", "items": { "type": "string" } },
    "impact_or_outcome": { "type": "string" },
    "campaign_success": { "type": "boolean" },
    "personal_learning": { "type": "string" },
    "satisfaction_level": { "type": "number", "minimum": 1, "maximum": 5 },
    "would_participate_again": { "type": "boolean" },
    "memories": { "type": "string" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "campaign_name"],
  "_phase1_todo": ["Define civic engagement tracking", "Define impact measurement", "Define cause history"]
}
