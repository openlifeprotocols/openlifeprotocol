{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public Consultation",
  "description": "Participation in public consultation or government feedback.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^public_consultation_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "consultation_name": { "type": "string" },
    "organization": { "type": "string" },
    "government_body": { "type": "string" },
    "policy_area": { "type": "string" },
    "issue_description": { "type": "string" },
    "consultation_date": { "type": "string", "format": "date" },
    "submission_date": { "type": "string", "format": "date" },
    "consultation_type": { "type": "string", "enum": ["public_comment", "survey", "hearing", "focus_group", "online_form", "email", "other"] },
    "participation_method": { "type": "string" },
    "submission_content": { "type": "string" },
    "position_advocated": { "type": "string" },
    "supporting_evidence": { "type": "array", "items": { "type": "string" } },
    "organizations_allied": { "type": "array", "items": { "type": "string" } },
    "outcome_or_response": { "type": "string" },
    "policy_changed": { "type": "boolean" },
    "impact_assessment": { "type": "string" },
    "media_coverage": { "type": "boolean" },
    "networks_formed": { "type": "array", "items": { "type": "string" } },
    "satisfaction_with_process": { "type": "number", "minimum": 1, "maximum": 5 },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "consultation_name"],
  "_phase1_todo": ["Define policy tracking", "Define impact analysis", "Define advocacy history"]
}
