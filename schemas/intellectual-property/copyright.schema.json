{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Copyright",
  "description": "Copyright registration and metadata.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^copyright_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "intellectual_property_id": { "type": "string" },
    "work_title": { "type": "string" },
    "work_type": { "type": "string", "enum": ["literary", "musical", "dramatic", "choreography", "pictorial", "graphic", "sculptural", "audiovisual", "sound_recording", "architectural", "compilation", "derivative"] },
    "registration_number": { "type": "string" },
    "jurisdiction": { "type": "string" },
    "creation_date": { "type": "string", "format": "date" },
    "publication_date": { "type": "string", "format": "date" },
    "registration_date": { "type": "string", "format": "date" },
    "author_names": { "type": "array", "items": { "type": "string" } },
    "copyright_owner": { "type": "string" },
    "copyright_notice": { "type": "string" },
    "duration": { "type": "string", "enum": ["life_plus_70", "work_made_for_hire", "anonymous", "pseudonymous", "other"] },
    "expiration_date": { "type": "string", "format": "date" },
    "renewal_status": { "type": "string", "enum": ["not_required", "renewed", "not_renewed"] },
    "status": { "type": "string", "enum": ["registered", "unregistered", "expired", "abandoned"] },
    "deposit_copies_submitted": { "type": "boolean" },
    "infringement_claims": { "type": "integer" },
    "licensing_revenue": { "type": "number" },
    "currency": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "intellectual_property_id", "work_title"],
  "_phase1_todo": [
    "Define copyright registration tracking",
    "Define copyright infringement monitoring",
    "Define copyright licensing management"
  ]
}
