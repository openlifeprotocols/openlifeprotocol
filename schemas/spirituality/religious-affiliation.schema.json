{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Religious Affiliation",
  "description": "Religious or faith tradition affiliation.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^religious_affiliation_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "religion_name": { "type": "string" },
    "tradition": { "type": "string" },
    "denomination": { "type": "string" },
    "affiliation_date": { "type": "string", "format": "date" },
    "active": { "type": "boolean" },
    "practice_level": { "type": "string", "enum": ["nominal", "observant", "highly_observant", "secular"] },
    "faith_journey": { "type": "string" },
    "clergy_or_spiritual_advisor": { "type": "string" },
    "community_involvement": { "type": "boolean" },
    "core_beliefs": { "type": "array", "items": { "type": "string" } },
    "sacred_texts_studied": { "type": "array", "items": { "type": "string" } },
    "rituals_practiced": { "type": "array", "items": { "type": "string" } },
    "holy_days_observed": { "type": "array", "items": { "type": "string" } },
    "dietary_restrictions": { "type": "array", "items": { "type": "string" } },
    "dress_codes": { "type": "string" },
    "marriage_preferences": { "type": "string" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "religion_name"],
  "_phase1_todo": ["Define interfaith relationships", "Define spiritual evolution tracking", "Define practice analytics"]
}
