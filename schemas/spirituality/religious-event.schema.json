{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Religious Event",
  "description": "Religious ceremony, celebration, or milestone.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^religious_event_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "event_name": { "type": "string" },
    "event_type": { "type": "string", "enum": ["celebration", "rite_of_passage", "pilgrimage", "ceremony", "holiday", "personal_milestone"] },
    "religion": { "type": "string" },
    "date": { "type": "string", "format": "date" },
    "location": { "type": "string" },
    "religious_significance": { "type": "string" },
    "participants": { "type": "array", "items": { "type": "string" } },
    "clergy_involved": { "type": "array", "items": { "type": "string" } },
    "traditions_observed": { "type": "array", "items": { "type": "string" } },
    "symbolic_meaning": { "type": "string" },
    "emotional_significance": { "type": "number", "minimum": 1, "maximum": 10 },
    "life_chapter": { "type": "string" },
    "memories": { "type": "string" },
    "photos": { "type": "array", "items": { "type": "string" } },
    "documents": { "type": "array", "items": { "type": "string" } },
    "gifts_received": { "type": "array", "items": { "type": "string" } },
    "transformations": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "event_name"],
  "_phase1_todo": ["Define milestone tracking", "Define spiritual timeline", "Define ritual documentation"]
}
