{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Season of Life",
  "description": "A named period in a person's life characterised by a distinct set of priorities, constraints or focus.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^season_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "name": { "type": "string", "description": "e.g. Early career, Young children, Sabbatical, Recovery" },
    "description": { "type": "string" },
    "type": { "type": "string", "enum": ["career", "family", "health", "financial", "creative", "transition", "growth", "rest", "custom"] },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "defining_constraints": { "type": "array", "items": { "type": "string" }, "description": "What limits or shapes this season" },
    "primary_focus": { "type": "string" },
    "energy_level": { "type": "string", "enum": ["very-low", "low", "medium", "high", "very-high"] },
    "key_themes": { "type": "array", "items": { "type": "string" } },
    "lessons": { "type": "string" },
    "is_current": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "name", "type"]
}
