{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Time Allocation",
  "description": "A high-level record of how time is distributed across life domains in a given period.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^time_alloc_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "period": { "type": "string", "enum": ["day", "week", "month", "quarter", "year"] },
    "period_start": { "type": "string", "format": "date" },
    "period_end": { "type": "string", "format": "date" },
    "allocations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "domain": { "type": "string" },
          "budgeted_hours": { "type": "number" },
          "actual_hours": { "type": "number" },
          "target_percentage": { "type": "number", "minimum": 0, "maximum": 100 }
        },
        "required": ["domain", "budgeted_hours"]
      }
    },
    "total_waking_hours": { "type": "number" },
    "reflection": { "type": "string" },
    "satisfaction_score": { "type": "integer", "minimum": 1, "maximum": 10 },
    "created_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "period", "period_start", "period_end"]
}
