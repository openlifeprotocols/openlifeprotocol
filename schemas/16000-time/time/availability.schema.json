{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Availability",
  "description": "A recurring or one-off window during which a person is available.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^availability_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "label": { "type": "string", "description": "e.g. Deep work, Open for meetings" },
    "type": { "type": "string", "enum": ["open", "preferred", "conditional", "unavailable"] },
    "recurrence": { "type": "string", "enum": ["once", "daily", "weekly", "monthly", "custom"] },
    "days_of_week": { "type": "array", "items": { "type": "string", "enum": ["monday","tuesday","wednesday","thursday","friday","saturday","sunday"] } },
    "start_time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
    "end_time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
    "timezone": { "type": "string" },
    "valid_from": { "type": "string", "format": "date" },
    "valid_until": { "type": "string", "format": "date" },
    "notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "type", "recurrence"]
}
