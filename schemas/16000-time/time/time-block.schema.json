{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Time Block",
  "description": "A discrete, intentionally allocated block of time for a specific purpose.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^time_block_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "calendar_id": { "type": "string" },
    "label": { "type": "string" },
    "purpose": { "type": "string", "enum": ["deep-work", "shallow-work", "admin", "learning", "health", "family", "social", "rest", "planning", "creative"] },
    "start": { "type": "string", "format": "date-time" },
    "end": { "type": "string", "format": "date-time" },
    "duration_minutes": { "type": "integer", "minimum": 1 },
    "is_protected": { "type": "boolean", "description": "Should not be overridden by meetings" },
    "is_recurring": { "type": "boolean" },
    "recurrence_rule": { "type": "string", "description": "RFC 5545 RRULE string" },
    "linked_project_id": { "type": "string" },
    "linked_goal_id": { "type": "string" },
    "actual_start": { "type": "string", "format": "date-time" },
    "actual_end": { "type": "string", "format": "date-time" },
    "focus_score": { "type": "integer", "minimum": 1, "maximum": 10 },
    "notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "label", "purpose", "start", "end"]
}
