{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Search Result",
  "description": "Cached search result.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^search_result_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "search_query_id": { "type": "string" },
    "document_id": { "type": "string" },
    "relevance_score": { "type": "number" },
    "result_rank": { "type": "integer" },
    "snippet": { "type": "string" },
    "search_date": { "type": "string", "format": "date-time" },
    "cache_expiration_date": { "type": "string", "format": "date-time" },
    "click_through": { "type": "boolean" },
    "user_interaction": { "type": "string", "enum": ["clicked", "bookmarked", "shared", "none"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid"],
  "_phase1_todo": ["Define result caching", "Define click tracking", "Define result freshness"]
}
