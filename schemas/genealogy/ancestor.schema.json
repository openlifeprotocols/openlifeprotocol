{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ancestor",
  "description": "Ancestor or genealogical record.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^ancestor_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "full_name": { "type": "string" },
    "birth_date": { "type": "string", "format": "date" },
    "birth_location": { "type": "string" },
    "death_date": { "type": "string", "format": "date" },
    "death_location": { "type": "string" },
    "nationality": { "type": "string" },
    "generation_removed": { "type": "integer" },
    "lineage_path": { "type": "string" },
    "relationship_description": { "type": "string" },
    "occupation": { "type": "string" },
    "notable_achievements": { "type": "array", "items": { "type": "string" } },
    "biography": { "type": "string" },
    "photos": { "type": "array", "items": { "type": "string" } },
    "documents": { "type": "array", "items": { "type": "string" } },
    "birth_certificate": { "type": "string" },
    "marriage_records": { "type": "array", "items": { "type": "string" } },
    "death_certificate": { "type": "string" },
    "sources_of_information": { "type": "array", "items": { "type": "string" } },
    "ancestry_dna_match": { "type": "string" },
    "interesting_facts": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "full_name"],
  "_phase1_todo": ["Define family tree linking", "Define genealogy research", "Define DNA matching"]
}
