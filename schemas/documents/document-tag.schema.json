{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document Tag",
  "description": "Tagging system for documents.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^document_tag_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "document_id": { "type": "string" },
    "tag_name": { "type": "string" },
    "tag_category": { "type": "string", "enum": ["subject", "person", "entity", "date", "status", "confidentiality", "location", "custom"] },
    "color": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "is_system_tag": { "type": "boolean" },
    "applies_to_document_count": { "type": "integer" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "document_id"],
  "_phase1_todo": ["Define tag hierarchy", "Define tag suggestions", "Define bulk tagging"]
}
