{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Impact Report",
  "description": "Report on achieved impact and outcomes.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^impact_report_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "reporting_period_start": { "type": "string", "format": "date" },
    "reporting_period_end": { "type": "string", "format": "date" },
    "report_type": { "type": "string", "enum": ["monthly", "quarterly", "annual", "project_completion"] },
    "cause_areas": { "type": "array", "items": { "type": "string" } },
    "monetary_contribution_total": { "type": "number" },
    "volunteer_hours_total": { "type": "number" },
    "fundraising_amount": { "type": "number" },
    "people_helped": { "type": "integer" },
    "awareness_reach": { "type": "integer" },
    "key_achievements": { "type": "array", "items": { "type": "string" } },
    "challenges_faced": { "type": "array", "items": { "type": "string" } },
    "lessons_learned": { "type": "array", "items": { "type": "string" } },
    "next_priorities": { "type": "array", "items": { "type": "string" } },
    "testimonials": { "type": "array", "items": { "type": "string" } },
    "metrics_achieved": { "type": "object", "additionalProperties": true },
    "document_id": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define report generation", "Define metrics aggregation", "Define sharing workflows"]
}
