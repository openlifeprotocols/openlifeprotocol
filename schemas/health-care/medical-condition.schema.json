{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Medical Condition",
  "description": "A diagnosed medical condition, disability, or chronic illness — part of a person's health record.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^medical_condition_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "diagnosed_by_id": { "type": "string" },
    "name": { "type": "string" },
    "icd_code": { "type": "string", "description": "ICD-10 or ICD-11 code" },
    "snomed_code": { "type": "string" },
    "onset_date": { "type": "string", "format": "date" },
    "diagnosed_date": { "type": "string", "format": "date" },
    "resolved_date": { "type": "string", "format": "date" },
    "is_chronic": { "type": "boolean" },
    "is_terminal": { "type": "boolean" },
    "severity": { "type": "string", "enum": ["mild", "moderate", "severe", "critical"] },
    "relevant_for_benefits": { "type": "boolean" },
    "relevant_for_driving": { "type": "boolean" },
    "relevant_for_employment": { "type": "boolean" },
    "medication_ids": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["active", "resolved", "in_remission", "suspected"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "name", "diagnosed_date"],
  "_phase1_todo": [
    "Define condition impact on life events",
    "Define condition-based benefit triggers",
    "Define comorbidity relationships",
    "Define genetic condition handling"
  ]
}
