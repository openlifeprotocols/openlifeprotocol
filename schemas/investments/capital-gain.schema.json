{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capital Gain",
  "description": "Realized gain or loss from security sale.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^capital_gain_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "investment_account_id": { "type": "string" },
    "security_id": { "type": "string" },
    "security_name": { "type": "string" },
    "sale_date": { "type": "string", "format": "date" },
    "purchase_date": { "type": "string", "format": "date" },
    "holding_period_days": { "type": "integer" },
    "is_long_term": { "type": "boolean" },
    "quantity_sold": { "type": "number" },
    "cost_basis": { "type": "number" },
    "sale_proceeds": { "type": "number" },
    "realized_gain_loss": { "type": "number" },
    "gain_loss_percentage": { "type": "number" },
    "currency": { "type": "string" },
    "transaction_fees": { "type": "number" },
    "tax_rate_applicable": { "type": "number" },
    "taxes_owed": { "type": "number" },
    "net_proceeds": { "type": "number" },
    "gain_loss_type": { "type": "string", "enum": ["short_term_gain", "short_term_loss", "long_term_gain", "long_term_loss"] },
    "tax_loss_harvesting_eligible": { "type": "boolean" },
    "wash_sale_concern": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "investment_account_id", "security_id", "sale_date"],
  "_phase1_todo": [
    "Define tax loss harvesting detection",
    "Define wash sale tracking",
    "Define capital gains reporting"
  ]
}
