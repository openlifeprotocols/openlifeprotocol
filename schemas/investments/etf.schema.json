{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ETF",
  "description": "Exchange-traded fund security metadata.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^etf_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "ticker_symbol": { "type": "string" },
    "fund_name": { "type": "string" },
    "fund_type": { "type": "string", "enum": ["index", "sector", "bond", "commodity", "international", "fixed_income", "actively_managed", "factor", "other"] },
    "net_asset_value": { "type": "number" },
    "current_price": { "type": "number" },
    "currency": { "type": "string" },
    "expense_ratio": { "type": "number" },
    "dividend_yield": { "type": "number" },
    "distribution_frequency": { "type": "string", "enum": ["monthly", "quarterly", "annually", "irregular"] },
    "assets_under_management": { "type": "number" },
    "number_of_holdings": { "type": "integer" },
    "inception_date": { "type": "string", "format": "date" },
    "one_year_return": { "type": "number" },
    "three_year_return": { "type": "number" },
    "five_year_return": { "type": "number" },
    "ten_year_return": { "type": "number" },
    "top_holdings": { "type": "array", "items": { "type": "string" } },
    "benchmark_index": { "type": "string" },
    "tracking_error": { "type": "number" },
    "last_updated": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "ticker_symbol", "fund_name"],
  "_phase1_todo": [
    "Define ETF performance vs benchmark",
    "Define ETF fee analysis",
    "Define ETF diversification contribution"
  ]
}
