{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Addiction",
  "description": "An addiction or compulsive behavior — substance, behavior, or activity with compulsive use pattern.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^addiction_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "substance_or_behavior": { "type": "string" },
    "addiction_type": { "type": "string", "enum": ["substance", "behavioral", "process", "mixed"] },
    "category": { "type": "string", "enum": ["alcohol", "drugs", "tobacco", "food", "internet", "social_media", "gaming", "shopping", "sex", "work", "exercise", "other"] },
    "severity": { "type": "string", "enum": ["mild", "moderate", "severe", "life_threatening"] },
    "onset_date": { "type": "string", "format": "date" },
    "duration": { "type": "string" },
    "frequency_of_use": { "type": "string" },
    "amount_or_intensity": { "type": "string" },
    "triggers": { "type": "array", "items": { "type": "string" } },
    "negative_consequences": { "type": "array", "items": { "type": "string" } },
    "health_impact": { "type": "string" },
    "relationship_impact": { "type": "string" },
    "financial_impact": { "type": "number" },
    "denial_level": { "type": "string", "enum": ["full_denial", "partial_denial", "acknowledgment", "acceptance"] },
    "recovery_attempts": { "type": "integer" },
    "longest_abstinence": { "type": "string" },
    "current_status": { "type": "string", "enum": ["active", "in_recovery", "abstinent", "relapsed"] },
    "support_systems": { "type": "array", "items": { "type": "string" } },
    "treatment_received": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "substance_or_behavior", "addiction_type"],
  "_phase1_todo": [
    "Define addiction severity scoring",
    "Define recovery progress tracking",
    "Define relapse prevention planning"
  ]
}
