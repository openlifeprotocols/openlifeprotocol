{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wellbeing Event",
  "description": "A wellbeing event — something that positively impacted mental/physical health, self-care, wellness activity.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^wellbeing_event_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "event_name": { "type": "string" },
    "event_type": { "type": "string", "enum": ["exercise", "meditation", "therapy", "social_connection", "nature_time", "creative_activity", "rest_day", "healthy_eating", "accomplishment", "celebration", "time_off", "learning_experience"] },
    "event_date": { "type": "string", "format": "date" },
    "duration_minutes": { "type": "integer" },
    "description": { "type": "string" },
    "wellbeing_impact": { "type": "array", "items": { "type": "string" } },
    "mood_before": { "type": "string" },
    "mood_after": { "type": "string" },
    "energy_before": { "type": "integer", "minimum": 1, "maximum": 10 },
    "energy_after": { "type": "integer", "minimum": 1, "maximum": 10 },
    "physical_benefits": { "type": "array", "items": { "type": "string" } },
    "mental_benefits": { "type": "array", "items": { "type": "string" } },
    "with_whom": { "type": "array", "items": { "type": "string" } },
    "would_repeat": { "type": "boolean" },
    "frequency_achieved": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "event_name", "event_type", "event_date"],
  "_phase1_todo": [
    "Define wellbeing pattern optimization",
    "Define activity recommendation engine",
    "Define wellbeing trajectory and progress tracking"
  ]
}
