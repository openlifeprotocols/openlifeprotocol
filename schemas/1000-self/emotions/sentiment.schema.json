{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sentiment",
  "description": "A sentiment or opinion expressed — how I feel about something, my judgment or view.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^sentiment_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "about": { "type": "string" },
    "sentiment_type": { "type": "string", "enum": ["positive", "negative", "neutral", "ambivalent", "mixed"] },
    "intensity": { "type": "integer", "minimum": 1, "maximum": 10 },
    "opinion": { "type": "string" },
    "reasoning": { "type": "array", "items": { "type": "string" } },
    "evidence_for": { "type": "array", "items": { "type": "string" } },
    "evidence_against": { "type": "array", "items": { "type": "string" } },
    "expressed_date": { "type": "string", "format": "date" },
    "context": { "type": "string" },
    "confidence_level": { "type": "string", "enum": ["uncertain", "somewhat_confident", "confident", "very_confident"] },
    "changed_since": { "type": "boolean" },
    "reasons_for_change": { "type": "string" },
    "strength_of_feeling": { "type": "string", "enum": ["mild", "moderate", "strong", "passionate"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "about", "sentiment_type"],
  "_phase1_todo": [
    "Define sentiment change tracking over time",
    "Define opinion stability assessment",
    "Define bias detection in sentiment reasoning"
  ]
}
