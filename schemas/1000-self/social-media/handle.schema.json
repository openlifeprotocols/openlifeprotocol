{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handle",
  "description": "A social media handle — username or unique identifier on a platform.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^handle_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "social_account_id": { "type": "string" },
    "handle_text": { "type": "string" },
    "platform_id": { "type": "string" },
    "is_primary": { "type": "boolean" },
    "created_date": { "type": "string", "format": "date" },
    "available_since": { "type": "string", "format": "date" },
    "is_verified": { "type": "boolean" },
    "handle_display_style": { "type": "string", "enum": ["@", "#", "url", "no_prefix"] },
    "handle_status": { "type": "string", "enum": ["active", "reserved", "changed", "retired"] },
    "previous_handles": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "social_account_id", "handle_text", "platform_id"],
  "_phase1_todo": [
    "Define handle history tracking",
    "Define handle availability checking",
    "Define handle consistency across platforms"
  ]
}
