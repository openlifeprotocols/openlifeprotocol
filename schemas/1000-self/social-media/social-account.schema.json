{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Social Account",
  "description": "A social media account — user account on a platform with credentials and settings.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^social_account_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "platform_id": { "type": "string" },
    "handle": { "type": "string" },
    "email": { "type": "string", "format": "email" },
    "account_created_date": { "type": "string", "format": "date" },
    "account_status": { "type": "string", "enum": ["active", "inactive", "suspended", "deleted", "archived"] },
    "verification_status": { "type": "string", "enum": ["not_verified", "verified_badge", "official", "other"] },
    "account_type": { "type": "string", "enum": ["personal", "business", "creator", "brand", "organization"] },
    "private_or_public": { "type": "string", "enum": ["public", "private", "friends_only"] },
    "two_factor_enabled": { "type": "boolean" },
    "password_last_changed": { "type": "string", "format": "date" },
    "follower_count": { "type": "integer" },
    "following_count": { "type": "integer" },
    "post_count": { "type": "integer" },
    "bio": { "type": "string" },
    "linked_website": { "type": "string", "format": "uri" },
    "theme_or_niche": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "platform_id", "handle"],
  "_phase1_todo": [
    "Define account health scoring",
    "Define account growth tracking",
    "Define account linking (multiple accounts same person)"
  ]
}
