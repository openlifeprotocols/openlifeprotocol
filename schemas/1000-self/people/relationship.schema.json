{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relationship",
  "description": "A relationship between two or more people or organisations — family, professional, legal, or social.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^relationship_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "external_ids": {
      "type": "array",
      "items": { "type": "object", "properties": { "system": { "type": "string" }, "id": { "type": "string" } }, "required": ["system", "id"] }
    },
    "from_actor_id": { "type": "string" },
    "to_actor_id": { "type": "string" },
    "relationship_type": {
      "type": "string",
      "enum": [
        "parent", "child", "sibling", "spouse", "partner", "grandparent", "grandchild",
        "aunt_uncle", "niece_nephew", "cousin", "guardian", "dependent",
        "employer", "employee", "client", "vendor", "colleague",
        "legal_representative", "power_of_attorney", "trustee", "beneficiary",
        "emergency_contact", "next_of_kin", "carer", "friend"
      ]
    },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "legal_basis": { "type": "string", "description": "e.g., 'marriage_certificate', 'adoption_order'" },
    "document_ids": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["active", "dissolved", "deceased", "suspended"] },
    "jurisdiction_id": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "from_actor_id", "to_actor_id", "relationship_type"],
  "_phase1_todo": [
    "Define bidirectional relationship inference",
    "Define relationship verification",
    "Define relationship dispute process",
    "Define multi-party relationships"
  ]
}
