{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Person Profile",
  "description": "A comprehensive profile for an individual person, extending the core Actor schema with personal details.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^person_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "external_ids": {
      "type": "array",
      "items": { "type": "object", "properties": { "system": { "type": "string" }, "id": { "type": "string" } }, "required": ["system", "id"] }
    },
    "actor_id": { "type": "string", "description": "Reference to core Actor record" },
    "given_names": { "type": "string" },
    "family_name": { "type": "string" },
    "preferred_name": { "type": "string" },
    "date_of_birth": { "type": "string", "format": "date" },
    "place_of_birth": { "type": "string" },
    "nationalities": { "type": "array", "items": { "type": "string", "description": "ISO 3166-1 alpha-3 country code" } },
    "gender": { "type": "string", "enum": ["male", "female", "non_binary", "prefer_not_to_say", "other"] },
    "pronouns": { "type": "string", "examples": ["he/him", "she/her", "they/them"] },
    "marital_status": { "type": "string", "enum": ["single", "married", "civil_partnership", "divorced", "widowed", "separated", "cohabiting"] },
    "languages": { "type": "array", "items": { "type": "string", "description": "BCP 47 language tag" } },
    "address_ids": { "type": "array", "items": { "type": "string" } },
    "contact_point_ids": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "given_names", "family_name"],
  "_phase1_todo": [
    "Define name change history",
    "Define biometric data handling",
    "Define deceased person procedures",
    "Define privacy and data retention"
  ]
}
