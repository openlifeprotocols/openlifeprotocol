{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spiritual Practice",
  "description": "Personal spiritual or contemplative practice.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^spiritual_practice_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "practice_name": { "type": "string" },
    "practice_type": { "type": "string", "enum": ["meditation", "prayer", "yoga", "journaling", "ritual", "study", "contemplation", "other"] },
    "spiritual_tradition": { "type": "string" },
    "description": { "type": "string" },
    "started_date": { "type": "string", "format": "date" },
    "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly", "irregular"] },
    "duration_minutes": { "type": "integer" },
    "time_of_day": { "type": "string" },
    "location": { "type": "string" },
    "sacred_text_reference": { "type": "string" },
    "associated_deity_or_tradition": { "type": "string" },
    "benefits_experienced": { "type": "array", "items": { "type": "string" } },
    "challenges": { "type": "array", "items": { "type": "string" } },
    "teacher_or_guide": { "type": "string" },
    "tools_used": { "type": "array", "items": { "type": "string" } },
    "current_streak_days": { "type": "integer" },
    "lifetime_hours": { "type": "number" },
    "transformations_noted": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "practice_name"],
  "_phase1_todo": ["Define practice tracking", "Define streak management", "Define transformation journaling"]
}
