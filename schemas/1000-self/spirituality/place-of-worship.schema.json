{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Place of Worship",
  "description": "Religious place of worship or spiritual location.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^place_of_worship_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "name": { "type": "string" },
    "religion": { "type": "string" },
    "denomination": { "type": "string" },
    "address_street": { "type": "string" },
    "address_city": { "type": "string" },
    "address_country": { "type": "string" },
    "latitude": { "type": "number" },
    "longitude": { "type": "number" },
    "worship_type": { "type": "string", "enum": ["church", "mosque", "synagogue", "temple", "monastery", "shrine", "spiritual_center", "other"] },
    "attendance_frequency": { "type": "string", "enum": ["weekly", "monthly", "yearly", "occasional", "pilgrimage"] },
    "last_visit_date": { "type": "string", "format": "date" },
    "membership": { "type": "boolean" },
    "membership_since": { "type": "string", "format": "date" },
    "roles_held": { "type": "array", "items": { "type": "string" } },
    "community_involvement": { "type": "array", "items": { "type": "string" } },
    "leader_names": { "type": "array", "items": { "type": "string" } },
    "special_significance": { "type": "string" },
    "accessibility_features": { "type": "array", "items": { "type": "string" } },
    "website": { "type": "string", "format": "uri" },
    "contact_email": { "type": "string", "format": "email" },
    "contact_phone": { "type": "string" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "name"],
  "_phase1_todo": ["Define visit tracking", "Define community directory", "Define spiritual journey mapping"]
}
