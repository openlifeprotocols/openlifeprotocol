{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collectible",
  "description": "Collectible item — watches, cars, memorabilia, etc.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^collectible_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "alternative_asset_id": { "type": "string" },
    "collectible_type": { "type": "string", "enum": ["watch", "car", "vintage_item", "memorabilia", "toy", "sports_card", "figurine", "other"] },
    "item_name": { "type": "string" },
    "brand_manufacturer": { "type": "string" },
    "model": { "type": "string" },
    "serial_number": { "type": "string" },
    "production_year": { "type": "integer" },
    "production_location": { "type": "string" },
    "condition": { "type": "string", "enum": ["mint", "near_mint", "excellent", "very_good", "good", "fair", "poor"] },
    "condition_details": { "type": "string" },
    "rarity": { "type": "string", "enum": ["common", "uncommon", "rare", "very_rare", "extremely_rare", "one_of_kind"] },
    "acquisition_date": { "type": "string", "format": "date" },
    "acquisition_cost": { "type": "number" },
    "current_valuation": { "type": "number" },
    "currency": { "type": "string" },
    "valuation_source": { "type": "string", "enum": ["professional_appraisal", "comparable_sales", "auction_result", "expert_estimate"] },
    "documentation": { "type": "array", "items": { "type": "string" } },
    "insurance_value": { "type": "number" },
    "location": { "type": "string" },
    "marketability": { "type": "string", "enum": ["highly_marketable", "marketable", "limited_market", "niche_market"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "alternative_asset_id", "item_name"],
  "_phase1_todo": [
    "Define collectible market price tracking",
    "Define collectible condition impact on value",
    "Define collectible portfolio analytics"
  ]
}
