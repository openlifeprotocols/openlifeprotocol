{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Servicing Record",
  "description": "Vehicle maintenance and servicing history.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^servicing_record_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "vehicle_id": { "type": "string" },
    "service_date": { "type": "string", "format": "date" },
    "service_type": { "type": "string", "enum": ["routine_maintenance", "major_service", "minor_service", "repair", "oil_change", "tire_replacement", "brake_service", "other"] },
    "mileage_at_service": { "type": "integer" },
    "service_provider": { "type": "string" },
    "service_location": { "type": "string" },
    "cost": { "type": "number" },
    "currency": { "type": "string" },
    "work_completed": { "type": "array", "items": { "type": "string" } },
    "parts_replaced": { "type": "array", "items": { "type": "object", "properties": { "part_name": { "type": "string" }, "quantity": { "type": "integer" }, "cost": { "type": "number" } } } },
    "next_service_date": { "type": "string", "format": "date" },
    "next_service_mileage": { "type": "integer" },
    "warranty_applied": { "type": "boolean" },
    "invoice_document_id": { "type": "string" },
    "technician_name": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "vehicle_id"],
  "_phase1_todo": ["Define maintenance scheduling", "Define service reminder alerts", "Define warranty tracking"]
}
