{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Address History",
  "description": "A chronological record of all addresses a person has lived at, used for identity verification, benefit claims, and legal proceedings.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^address_history_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "address_id": { "type": "string" },
          "from_date": { "type": "string", "format": "date" },
          "to_date": { "type": "string", "format": "date" },
          "is_current": { "type": "boolean" },
          "tenancy_type": { "type": "string", "enum": ["owner_occupier", "private_rented", "social_rented", "family", "other"] },
          "move_id": { "type": "string" }
        },
        "required": ["address_id", "from_date"]
      }
    },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "entries"],
  "_phase1_todo": [
    "Define address gap detection",
    "Define conflicting address data resolution",
    "Define address history for verification",
    "Define address history privacy controls"
  ]
}
