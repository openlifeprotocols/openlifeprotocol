{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parking Permit",
  "description": "Parking permit or resident parking authorization.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^parking_permit_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "vehicle_id": { "type": "string" },
    "person_id": { "type": "string" },
    "permit_type": { "type": "string", "enum": ["resident", "visitor", "business", "disabled", "loading", "on_street", "off_street"] },
    "permit_number": { "type": "string" },
    "issue_date": { "type": "string", "format": "date" },
    "expiration_date": { "type": "string", "format": "date" },
    "issuing_authority": { "type": "string" },
    "parking_area": { "type": "string" },
    "parking_zone": { "type": "string" },
    "registration_number": { "type": "string" },
    "permit_holder_name": { "type": "string" },
    "permit_holder_address": { "type": "string" },
    "cost": { "type": "number" },
    "currency": { "type": "string" },
    "renewal_date": { "type": "string", "format": "date" },
    "digital_permit": { "type": "boolean" },
    "permit_app_details": { "type": "string" },
    "document_id": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "vehicle_id"],
  "_phase1_todo": ["Define permit renewal alerts", "Define violation tracking", "Define permit transfer"]
}
