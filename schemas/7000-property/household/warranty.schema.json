{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Warranty",
  "description": "Product warranty information.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^warranty_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "appliance_id": { "type": "string" },
    "product_name": { "type": "string" },
    "product_type": { "type": "string" },
    "warranty_type": { "type": "string", "enum": ["manufacturer", "extended", "accidental_damage", "performance", "lifetime", "other"] },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "coverage_details": { "type": "string" },
    "warranty_provider": { "type": "string" },
    "policy_number": { "type": "string" },
    "coverage_amount": { "type": "number" },
    "currency": { "type": "string" },
    "deductible": { "type": "number" },
    "claims_available": { "type": "integer" },
    "claims_used": { "type": "integer" },
    "claims_remaining": { "type": "integer" },
    "document_id": { "type": "string" },
    "is_transferable": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid"],
  "_phase1_todo": ["Define warranty claim automation", "Define coverage verification", "Define transfer process"]
}
