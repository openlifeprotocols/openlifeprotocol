{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manual",
  "description": "Product instruction manual or guide.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^manual_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "appliance_id": { "type": "string" },
    "product_name": { "type": "string" },
    "product_type": { "type": "string" },
    "manual_type": { "type": "string", "enum": ["instruction", "user_guide", "quick_start", "service_manual", "parts_list", "warranty_card"] },
    "language": { "type": "string" },
    "document_id": { "type": "string" },
    "document_url": { "type": "string", "format": "uri" },
    "file_format": { "type": "string", "enum": ["pdf", "html", "txt", "image"] },
    "page_count": { "type": "integer" },
    "version": { "type": "string" },
    "publication_date": { "type": "string", "format": "date" },
    "manufacturer_name": { "type": "string" },
    "model_number": { "type": "string" },
    "serial_number_applicable": { "type": "boolean" },
    "contains_warranty": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid"],
  "_phase1_todo": ["Define manual extraction", "Define instruction visualization", "Define troubleshooting guide"]
}
