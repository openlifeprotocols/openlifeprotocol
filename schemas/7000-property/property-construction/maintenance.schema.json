{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Maintenance",
  "description": "A maintenance record — planned, reactive, or preventive work on a property or asset.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^maintenance_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "property_id": { "type": "string" },
    "building_id": { "type": "string" },
    "asset_id": { "type": "string" },
    "maintenance_type": { "type": "string", "enum": ["planned_preventive", "reactive", "emergency", "condition_based", "statutory"] },
    "category": { "type": "string", "enum": ["plumbing", "electrical", "roofing", "decorating", "structural", "heating", "drainage", "windows_doors", "garden", "appliance", "other"] },
    "description": { "type": "string" },
    "reported_by_id": { "type": "string" },
    "reported_date": { "type": "string", "format": "date" },
    "scheduled_date": { "type": "string", "format": "date" },
    "completed_date": { "type": "string", "format": "date" },
    "contractor_id": { "type": "string" },
    "cost": { "type": "number" },
    "currency": { "type": "string" },
    "invoice_id": { "type": "string" },
    "recurrence": { "type": "string", "enum": ["once", "monthly", "quarterly", "annual", "as_needed"] },
    "next_due_date": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["reported", "scheduled", "in_progress", "complete", "cancelled"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "maintenance_type", "category", "description", "reported_date"],
  "_phase1_todo": [
    "Define planned maintenance calendar",
    "Define statutory compliance maintenance (e.g., gas safety)",
    "Define maintenance cost history",
    "Define service charge allocation for flats"
  ]
}
