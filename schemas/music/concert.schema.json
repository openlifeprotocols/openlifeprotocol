{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Concert",
  "description": "Live concert or music performance.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^concert_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "artist_name": { "type": "string" },
    "artist_id": { "type": "string" },
    "venue_name": { "type": "string" },
    "venue_city": { "type": "string" },
    "venue_country": { "type": "string" },
    "concert_date": { "type": "string", "format": "date" },
    "start_time": { "type": "string", "format": "time" },
    "end_time": { "type": "string", "format": "time" },
    "concert_type": { "type": "string", "enum": ["solo", "festival", "tour_stop", "special_event"] },
    "attended": { "type": "boolean" },
    "ticket_price": { "type": "number" },
    "seating_section": { "type": "string" },
    "companions": { "type": "array", "items": { "type": "string" } },
    "setlist": { "type": "array", "items": { "type": "string" } },
    "rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "memories": { "type": "string" },
    "photos": { "type": "array", "items": { "type": "string" } },
    "merchandise_purchased": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "artist_name"],
  "_phase1_todo": ["Define attendance tracking", "Define setlist management", "Define memory archival"]
}
