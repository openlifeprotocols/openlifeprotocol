{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Instrument",
  "description": "Musical instrument owned or played.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^instrument_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "instrument_type": { "type": "string", "enum": ["guitar", "piano", "drums", "violin", "flute", "trumpet", "vocals", "synth", "ukulele", "other"] },
    "instrument_name": { "type": "string" },
    "brand": { "type": "string" },
    "model": { "type": "string" },
    "serial_number": { "type": "string" },
    "acquisition_date": { "type": "string", "format": "date" },
    "purchase_price": { "type": "number" },
    "current_value": { "type": "number" },
    "condition": { "type": "string", "enum": ["poor", "fair", "good", "very_good", "mint"] },
    "proficiency_level": { "type": "string", "enum": ["beginner", "intermediate", "advanced", "professional"] },
    "years_playing": { "type": "number" },
    "lessons_taken": { "type": "integer" },
    "teacher_name": { "type": "string" },
    "tuning": { "type": "string" },
    "storage_location": { "type": "string" },
    "insurance_value": { "type": "number" },
    "maintenance_notes": { "type": "string" },
    "last_maintenance_date": { "type": "string", "format": "date" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "instrument_type"],
  "_phase1_todo": ["Define practice scheduling", "Define lesson tracking", "Define maintenance alerts"]
}
