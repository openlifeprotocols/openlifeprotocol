{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Album",
  "description": "Music album or EP.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^album_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "album_name": { "type": "string" },
    "artist_name": { "type": "string" },
    "artist_id": { "type": "string" },
    "release_date": { "type": "string", "format": "date" },
    "release_year": { "type": "integer" },
    "album_type": { "type": "string", "enum": ["studio", "live", "compilation", "ep", "mixtape", "single"] },
    "genres": { "type": "array", "items": { "type": "string" } },
    "track_count": { "type": "integer" },
    "total_duration_minutes": { "type": "number" },
    "producer_names": { "type": "array", "items": { "type": "string" } },
    "label": { "type": "string" },
    "spotify_album_id": { "type": "string" },
    "apple_music_id": { "type": "string" },
    "description": { "type": "string" },
    "user_rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "favorite": { "type": "boolean" },
    "owned_format": { "type": "string", "enum": ["vinyl", "cd", "digital", "tape", "none"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "album_name", "artist_name"],
  "_phase1_todo": ["Define tracklist expansion", "Define format ownership", "Define listening stats"]
}
