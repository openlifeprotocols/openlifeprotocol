{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Music Practice",
  "description": "Music practice session record.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^music_practice_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "instrument_id": { "type": "string" },
    "instrument_type": { "type": "string" },
    "practice_date": { "type": "string", "format": "date" },
    "start_time": { "type": "string", "format": "time" },
    "duration_minutes": { "type": "integer" },
    "focus_areas": { "type": "array", "items": { "type": "string" } },
    "pieces_practiced": { "type": "array", "items": { "type": "string" } },
    "difficulty_level": { "type": "string", "enum": ["beginner", "intermediate", "advanced"] },
    "mood_before": { "type": "string" },
    "mood_after": { "type": "string" },
    "progress_notes": { "type": "string" },
    "challenges": { "type": "array", "items": { "type": "string" } },
    "breakthroughs": { "type": "array", "items": { "type": "string" } },
    "learning_goal": { "type": "string" },
    "intensity_level": { "type": "integer", "minimum": 1, "maximum": 10 },
    "engagement_level": { "type": "integer", "minimum": 1, "maximum": 10 },
    "practice_quality": { "type": "integer", "minimum": 1, "maximum": 10 },
    "video_recorded": { "type": "boolean" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "practice_date"],
  "_phase1_todo": ["Define practice streak tracking", "Define goal integration", "Define analytics"]
}
