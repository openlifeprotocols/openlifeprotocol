{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Music Collection",
  "description": "Physical music collection (vinyl, CD, etc).",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^music_collection_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "collection_name": { "type": "string" },
    "description": { "type": "string" },
    "format": { "type": "string", "enum": ["vinyl", "cd", "cassette", "minidisc", "digital", "mixed"] },
    "total_items": { "type": "integer" },
    "genres_represented": { "type": "array", "items": { "type": "string" } },
    "estimated_value": { "type": "number" },
    "currency": { "type": "string" },
    "storage_location": { "type": "string" },
    "collection_status": { "type": "string", "enum": ["active", "dormant", "archived", "for_sale"] },
    "condition": { "type": "string", "enum": ["poor", "fair", "good", "very_good", "mint"] },
    "acquired_date": { "type": "string", "format": "date" },
    "insurance_value": { "type": "number" },
    "insurance_document_id": { "type": "string" },
    "rare_items": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "collection_name"],
  "_phase1_todo": ["Define inventory management", "Define condition tracking", "Define valuation updates"]
}
