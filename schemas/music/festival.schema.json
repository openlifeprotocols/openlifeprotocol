{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Festival",
  "description": "Music festival attendance.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^festival_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "festival_name": { "type": "string" },
    "festival_date_start": { "type": "string", "format": "date" },
    "festival_date_end": { "type": "string", "format": "date" },
    "location": { "type": "string" },
    "country": { "type": "string" },
    "genres": { "type": "array", "items": { "type": "string" } },
    "attended": { "type": "boolean" },
    "ticket_price": { "type": "number" },
    "ticket_type": { "type": "string", "enum": ["single_day", "weekend", "full_pass", "vip"] },
    "camping_accommodation": { "type": "string" },
    "companions": { "type": "array", "items": { "type": "string" } },
    "artists_seen": { "type": "array", "items": { "type": "string" } },
    "highlight_performances": { "type": "array", "items": { "type": "string" } },
    "favorite_artist": { "type": "string" },
    "overall_rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "memories": { "type": "string" },
    "photos": { "type": "array", "items": { "type": "string" } },
    "merchandise_purchased": { "type": "array", "items": { "type": "string" } },
    "would_return": { "type": "boolean" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "festival_name"],
  "_phase1_todo": ["Define artist tracking", "Define schedule management", "Define social integration"]
}
