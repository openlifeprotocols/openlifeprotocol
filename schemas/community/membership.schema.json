{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Community Membership",
  "description": "Membership in a community group.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^community_membership_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "community_group_id": { "type": "string" },
    "group_name": { "type": "string" },
    "join_date": { "type": "string", "format": "date" },
    "membership_status": { "type": "string", "enum": ["active", "inactive", "paused", "left"] },
    "member_role": { "type": "string", "enum": ["member", "contributor", "organizer", "admin"] },
    "contribution_type": { "type": "string" },
    "participation_level": { "type": "string", "enum": ["inactive", "occasional", "regular", "very_active"] },
    "last_activity_date": { "type": "string", "format": "date" },
    "events_attended": { "type": "integer" },
    "membership_fee_paid": { "type": "boolean" },
    "membership_fee_amount": { "type": "number" },
    "renewal_date": { "type": "string", "format": "date" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "group_name"],
  "_phase1_todo": ["Define participation metrics", "Define renewal reminders", "Define engagement tracking"]
}
