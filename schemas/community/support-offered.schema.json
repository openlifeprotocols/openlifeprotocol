{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Support Offered",
  "description": "Offer to provide community support.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^support_offered_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "support_type": { "type": "string", "enum": ["physical_help", "skill_share", "childcare", "elder_care", "transportation", "meals", "mentoring", "other"] },
    "description": { "type": "string" },
    "skills_offered": { "type": "array", "items": { "type": "string" } },
    "availability": { "type": "string" },
    "availability_days": { "type": "array", "items": { "type": "string" } },
    "availability_hours_per_week": { "type": "number" },
    "geographic_radius_miles": { "type": "number" },
    "is_active": { "type": "boolean" },
    "times_offered_help": { "type": "integer" },
    "people_helped": { "type": "integer" },
    "average_satisfaction_rating": { "type": "number" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define availability scheduling", "Define skill verification", "Define impact tracking"]
}
