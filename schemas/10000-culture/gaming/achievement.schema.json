{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Achievement",
  "description": "In-game achievement or trophy.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^achievement_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "game_id": { "type": "string" },
    "game_title": { "type": "string" },
    "platform_name": { "type": "string" },
    "achievement_name": { "type": "string" },
    "achievement_description": { "type": "string" },
    "achievement_type": { "type": "string", "enum": ["achievement", "trophy", "badge", "medal"] },
    "rarity_percentage": { "type": "number" },
    "difficulty_level": { "type": "string", "enum": ["easy", "moderate", "hard", "extreme"] },
    "points_earned": { "type": "integer" },
    "unlocked_date": { "type": "string", "format": "date" },
    "hours_to_earn": { "type": "number" },
    "is_hidden": { "type": "boolean" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "game_title"],
  "_phase1_todo": ["Define achievement tracking", "Define stats aggregation", "Define rarity comparison"]
}
