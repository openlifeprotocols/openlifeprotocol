{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clan",
  "description": "Multiplayer game clan or team.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^clan_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "clan_name": { "type": "string" },
    "game_title": { "type": "string" },
    "clan_tag": { "type": "string" },
    "clan_leader": { "type": "string" },
    "founded_date": { "type": "string", "format": "date" },
    "member_count": { "type": "integer" },
    "clan_level": { "type": "integer" },
    "clan_ranking": { "type": "string" },
    "player_role": { "type": "string", "enum": ["member", "officer", "leader", "founder"] },
    "joined_date": { "type": "string", "format": "date" },
    "left_date": { "type": "string", "format": "date" },
    "is_current_member": { "type": "boolean" },
    "competitive_ranking": { "type": "string" },
    "tournament_participation": { "type": "integer" },
    "tournament_wins": { "type": "integer" },
    "platform": { "type": "string" },
    "win_rate_percentage": { "type": "number" },
    "primary_game_mode": { "type": "string" },
    "communication_platform": { "type": "string" },
    "practice_schedule": { "type": "string" },
    "closest_teammates": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "clan_name"],
  "_phase1_todo": ["Define competitive tracking", "Define stats aggregation", "Define tournament history"]
}
