{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game",
  "description": "Video game.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^game_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "game_title": { "type": "string" },
    "release_year": { "type": "integer" },
    "release_date": { "type": "string", "format": "date" },
    "developers": { "type": "array", "items": { "type": "string" } },
    "publishers": { "type": "array", "items": { "type": "string" } },
    "genre": { "type": "string", "enum": ["fps", "rpg", "strategy", "adventure", "puzzle", "sports", "racing", "simulation", "indie", "other"] },
    "platforms": { "type": "array", "items": { "type": "string", "enum": ["pc", "xbox_one", "playstation_4", "playstation_5", "xbox_series_x", "nintendo_switch", "mobile", "other"] } },
    "metacritic_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "description": { "type": "string" },
    "user_rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "favorite": { "type": "boolean" },
    "owned": { "type": "boolean" },
    "on_wishlist": { "type": "boolean" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "game_title"],
  "_phase1_todo": ["Define play history", "Define achievements", "Define library management"]
}
