{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game Save",
  "description": "Game save file or checkpoint.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^game_save_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "game_id": { "type": "string" },
    "game_title": { "type": "string" },
    "platform_name": { "type": "string" },
    "save_name": { "type": "string" },
    "save_date": { "type": "string", "format": "date-time" },
    "playthrough_number": { "type": "integer" },
    "difficulty_level": { "type": "string" },
    "character_name": { "type": "string" },
    "playtime_hours": { "type": "number" },
    "progress_percentage": { "type": "number", "minimum": 0, "maximum": 100 },
    "current_level": { "type": "string" },
    "game_mode": { "type": "string" },
    "is_cloud_synced": { "type": "boolean" },
    "file_size_mb": { "type": "number" },
    "last_played_date": { "type": "string", "format": "date-time" },
    "backup_location": { "type": "string" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "game_title"],
  "_phase1_todo": ["Define save backup", "Define sync management", "Define progress comparison"]
}
