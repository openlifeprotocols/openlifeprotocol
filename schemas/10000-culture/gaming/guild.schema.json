{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guild",
  "description": "Multiplayer game guild or clan.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^guild_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "guild_name": { "type": "string" },
    "game_title": { "type": "string" },
    "guild_leader": { "type": "string" },
    "guild_tag": { "type": "string" },
    "founded_date": { "type": "string", "format": "date" },
    "member_count": { "type": "integer" },
    "total_members_ever": { "type": "integer" },
    "guild_level": { "type": "integer" },
    "primary_faction": { "type": "string" },
    "player_role": { "type": "string", "enum": ["member", "officer", "leader", "founder"] },
    "joined_date": { "type": "string", "format": "date" },
    "left_date": { "type": "string", "format": "date" },
    "is_current_member": { "type": "boolean" },
    "guild_achievements": { "type": "array", "items": { "type": "string" } },
    "pvp_ranking": { "type": "string" },
    "pve_ranking": { "type": "string" },
    "communication_platform": { "type": "string", "enum": ["discord", "teamspeak", "ventrilo", "in_game", "other"] },
    "discord_server_id": { "type": "string" },
    "weekly_raids": { "type": "integer" },
    "total_playtime_with_guild": { "type": "number" },
    "closest_guild_friends": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "guild_name"],
  "_phase1_todo": ["Define member tracking", "Define raiding schedule", "Define guild statistics"]
}
