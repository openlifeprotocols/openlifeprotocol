{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "In-Game Purchase",
  "description": "Virtual item or in-game purchase.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^in_game_purchase_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "game_id": { "type": "string" },
    "game_title": { "type": "string" },
    "purchase_date": { "type": "string", "format": "date-time" },
    "item_name": { "type": "string" },
    "item_type": { "type": "string", "enum": ["cosmetic", "battle_pass", "character_skin", "weapon_skin", "currency", "battle_bundle", "season_pass", "other"] },
    "amount_spent": { "type": "number" },
    "currency": { "type": "string" },
    "platform_name": { "type": "string" },
    "payment_method": { "type": "string" },
    "is_limited_edition": { "type": "boolean" },
    "rarity": { "type": "string", "enum": ["common", "uncommon", "rare", "epic", "legendary"] },
    "still_owned": { "type": "boolean" },
    "reason_purchased": { "type": "string" },
    "satisfaction_rating": { "type": "integer", "minimum": 1, "maximum": 5 },
    "regretted": { "type": "boolean" },
    "value_for_money": { "type": "integer", "minimum": 1, "maximum": 5 },
    "market_value": { "type": "number" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "game_title"],
  "_phase1_todo": ["Define spending analysis", "Define purchase history", "Define regret detection"]
}
