{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game Session",
  "description": "Record of a gaming session.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^game_session_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "game_id": { "type": "string" },
    "game_title": { "type": "string" },
    "platform_id": { "type": "string" },
    "platform_name": { "type": "string" },
    "session_date": { "type": "string", "format": "date" },
    "start_time": { "type": "string", "format": "time" },
    "duration_minutes": { "type": "integer" },
    "location": { "type": "string" },
    "mood_before": { "type": "string" },
    "mood_after": { "type": "string" },
    "multiplayer": { "type": "boolean" },
    "player_count": { "type": "integer" },
    "companions": { "type": "array", "items": { "type": "string" } },
    "difficulty_level": { "type": "string" },
    "progress_made": { "type": "string" },
    "achievements_earned": { "type": "array", "items": { "type": "string" } },
    "score_or_level": { "type": "string" },
    "enjoyment_rating": { "type": "integer", "minimum": 1, "maximum": 10 },
    "session_notes": { "type": "string" },
    "notable_moments": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "game_title"],
  "_phase1_todo": ["Define playtime aggregation", "Define progress tracking", "Define analytics"]
}
