{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Song",
  "description": "Individual song or track.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^song_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "song_title": { "type": "string" },
    "artist_name": { "type": "string" },
    "artist_id": { "type": "string" },
    "album_name": { "type": "string" },
    "album_id": { "type": "string" },
    "release_date": { "type": "string", "format": "date" },
    "genre": { "type": "string" },
    "duration_seconds": { "type": "integer" },
    "track_number": { "type": "integer" },
    "featuring_artists": { "type": "array", "items": { "type": "string" } },
    "composers": { "type": "array", "items": { "type": "string" } },
    "lyricist": { "type": "string" },
    "spotify_track_id": { "type": "string" },
    "apple_music_id": { "type": "string" },
    "youtube_id": { "type": "string" },
    "lyrics": { "type": "string" },
    "user_rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "favorite": { "type": "boolean" },
    "mood_tags": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "song_title", "artist_name"],
  "_phase1_todo": ["Define play history", "Define lyric search", "Define mood matching"]
}
