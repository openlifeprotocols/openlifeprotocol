{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fandom",
  "description": "A fandom — passionate interest in a media franchise, fan community participation, engagement.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^fandom_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "fandom_name": { "type": "string" },
    "media_type": { "type": "string", "enum": ["book_series", "movie_franchise", "tv_series", "music_artist", "video_game", "anime_manga", "comic_books", "sports_team", "other"] },
    "passion_level": { "type": "string", "enum": ["casual_fan", "devoted_fan", "hardcore_fan", "superfan"] },
    "discovered_date": { "type": "string", "format": "date" },
    "how_discovered": { "type": "string" },
    "favorite_characters": { "type": "array", "items": { "type": "string" } },
    "favorite_works": { "type": "array", "items": { "type": "string" } },
    "engaging_in": { "type": "array", "items": { "type": "string", "enum": ["watching", "reading", "gaming", "fan_fiction", "fan_art", "conventions", "discussion_forums", "collecting_merchandise"] } },
    "community_participation": { "type": "string", "enum": ["lurker", "occasional_participant", "active_member", "community_leader"] },
    "merchandise_owned": { "type": "array", "items": { "type": "string" } },
    "theories": { "type": "array", "items": { "type": "string" } },
    "criticisms": { "type": "array", "items": { "type": "string" } },
    "still_active": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "fandom_name", "media_type"],
  "_phase1_todo": [
    "Define fandom community mapping",
    "Define fan content creation tracking",
    "Define fandom evolution timeline"
  ]
}
