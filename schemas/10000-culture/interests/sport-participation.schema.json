{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sport Participation",
  "description": "Sport participation — playing or participating in a sport, athletic activity, exercise session.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^sport_participation_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "sport_name": { "type": "string" },
    "sport_type": { "type": "string", "enum": ["individual", "team", "competitive", "recreational", "contact", "non_contact"] },
    "participation_date": { "type": "string", "format": "date" },
    "duration_minutes": { "type": "integer" },
    "location": { "type": "string" },
    "team_or_group": { "type": "string" },
    "role": { "type": "string" },
    "skill_level": { "type": "string", "enum": ["beginner", "intermediate", "advanced", "competitive"] },
    "performance": { "type": "string", "enum": ["poor", "fair", "good", "excellent", "outstanding"] },
    "result": { "type": "string", "enum": ["won", "lost", "tied", "completed"] },
    "score_or_time": { "type": "string" },
    "injuries_or_issues": { "type": "array", "items": { "type": "string" } },
    "training_focus": { "type": "array", "items": { "type": "string" } },
    "emotional_experience": { "type": "string", "enum": ["frustrating", "neutral", "enjoyable", "exhilarating"] },
    "opponent_or_challenger": { "type": "string" },
    "notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "sport_name", "sport_type", "participation_date"],
  "_phase1_todo": [
    "Define athletic performance tracking",
    "Define injury history and recovery",
    "Define competitive ranking and progression"
  ]
}
