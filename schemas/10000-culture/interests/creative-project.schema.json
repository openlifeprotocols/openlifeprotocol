{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Creative Project",
  "description": "A creative project — artistic creation, craft project, creative endeavor, making something.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^creative_project_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "project_title": { "type": "string" },
    "description": { "type": "string" },
    "project_type": { "type": "string", "enum": ["visual_art", "music", "writing", "crafts", "design", "photography", "video", "performance", "digital_art", "other"] },
    "started_date": { "type": "string", "format": "date" },
    "completed_date": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["in_progress", "completed", "abandoned", "on_hold"] },
    "inspiration_source": { "type": "string" },
    "creative_process": { "type": "string" },
    "materials_or_tools": { "type": "array", "items": { "type": "string" } },
    "collaborators": { "type": "array", "items": { "type": "string" } },
    "estimated_hours": { "type": "number" },
    "personal_satisfaction": { "type": "integer", "minimum": 1, "maximum": 10 },
    "shared_publicly": { "type": "boolean" },
    "public_url": { "type": "string", "format": "uri" },
    "feedback_received": { "type": "array", "items": { "type": "string" } },
    "next_iteration": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "project_title", "project_type"],
  "_phase1_todo": [
    "Define creative portfolio management",
    "Define project-to-growth tracking",
    "Define creative influences and inspirations mapping"
  ]
}
