{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collection",
  "description": "Personal collection of items.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^collection_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "collection_name": { "type": "string" },
    "collection_type": { "type": "string", "enum": ["vinyl", "blu_ray", "books", "games", "trading_cards", "memorabilia", "figurines", "coins", "stamps", "art", "jewelry", "other"] },
    "description": { "type": "string" },
    "total_items": { "type": "integer" },
    "item_condition_average": { "type": "string", "enum": ["poor", "fair", "good", "very_good", "mint"] },
    "collection_status": { "type": "string", "enum": ["active_collecting", "dormant", "completed", "for_sale", "archived"] },
    "start_date": { "type": "string", "format": "date" },
    "estimated_total_value": { "type": "number" },
    "currency": { "type": "string" },
    "storage_locations": { "type": "array", "items": { "type": "string" } },
    "rarest_items": { "type": "array", "items": { "type": "string" } },
    "most_valuable_items": { "type": "array", "items": { "type": "string" } },
    "insurance_value": { "type": "number" },
    "insurance_document_id": { "type": "string" },
    "catalog_url": { "type": "string", "format": "uri" },
    "is_public": { "type": "boolean" },
    "notes": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "collection_name"],
  "_phase1_todo": ["Define collection inventory", "Define valuation tracking", "Define insurance management"]
}
