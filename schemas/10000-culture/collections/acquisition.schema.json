{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acquisition",
  "description": "Record of acquiring a collection item.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^acquisition_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "collection_id": { "type": "string" },
    "collection_item_id": { "type": "string" },
    "item_name": { "type": "string" },
    "acquisition_date": { "type": "string", "format": "date" },
    "acquisition_method": { "type": "string", "enum": ["purchase", "gift", "trade", "inheritance", "found", "commissioned", "other"] },
    "seller_name": { "type": "string" },
    "seller_type": { "type": "string", "enum": ["individual", "dealer", "auction_house", "store", "online_marketplace", "other"] },
    "purchase_price": { "type": "number" },
    "currency": { "type": "string" },
    "sale_platform": { "type": "string", "enum": ["ebay", "depop", "discogs", "auction_house", "local", "online_store", "other"] },
    "condition_upon_acquisition": { "type": "string" },
    "authenticity_verified": { "type": "boolean" },
    "restoration_needed": { "type": "boolean" },
    "restoration_cost": { "type": "number" },
    "story_of_acquisition": { "type": "string" },
    "documentation": { "type": "array", "items": { "type": "string" } },
    "condition_notes": { "type": "string" },
    "satisfaction_level": { "type": "integer", "minimum": 1, "maximum": 10 },
    "would_acquire_again": { "type": "boolean" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "acquisition_date"],
  "_phase1_todo": ["Define acquisition history", "Define authentication tracking", "Define provenance management"]
}
