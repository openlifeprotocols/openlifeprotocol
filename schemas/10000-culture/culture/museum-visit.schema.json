{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Museum Visit",
  "description": "Visit to a museum or gallery.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^museum_visit_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "museum_name": { "type": "string" },
    "location_city": { "type": "string" },
    "location_country": { "type": "string" },
    "visit_date": { "type": "string", "format": "date" },
    "duration_hours": { "type": "number" },
    "admission_price": { "type": "number" },
    "collection_type": { "type": "string", "enum": ["art", "history", "natural_history", "science", "technology", "specialized", "other"] },
    "companions": { "type": "array", "items": { "type": "string" } },
    "exhibitions_viewed": { "type": "array", "items": { "type": "string" } },
    "favorite_artworks": { "type": "array", "items": { "type": "string" } },
    "favorite_rooms": { "type": "array", "items": { "type": "string" } },
    "guided_tour": { "type": "boolean" },
    "audio_guide": { "type": "boolean" },
    "photos_taken": { "type": "boolean" },
    "museum_gift_purchased": { "type": "array", "items": { "type": "string" } },
    "overall_experience_rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "would_return": { "type": "boolean" },
    "memorable_moments": { "type": "array", "items": { "type": "string" } },
    "learned_facts": { "type": "array", "items": { "type": "string" } },
    "museum_membership": { "type": "boolean" },
    "notes": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "museum_name"],
  "_phase1_todo": ["Define exhibition tracking", "Define museum favorites", "Define cultural tourism"]
}
