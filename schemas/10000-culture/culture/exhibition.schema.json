{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exhibition",
  "description": "Museum or gallery exhibition.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^exhibition_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "exhibition_title": { "type": "string" },
    "museum_name": { "type": "string" },
    "location": { "type": "string" },
    "exhibition_type": { "type": "string", "enum": ["permanent", "temporary", "traveling", "special"] },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "curator": { "type": "string" },
    "theme": { "type": "string" },
    "description": { "type": "string" },
    "artist_names": { "type": "array", "items": { "type": "string" } },
    "artwork_count": { "type": "integer" },
    "featured_pieces": { "type": "array", "items": { "type": "string" } },
    "user_rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "visited": { "type": "boolean" },
    "visit_date": { "type": "string", "format": "date" },
    "would_visit_again": { "type": "boolean" },
    "website": { "type": "string", "format": "uri" },
    "exhibition_catalog": { "type": "string" },
    "ticket_price": { "type": "number" },
    "notes": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "exhibition_title"],
  "_phase1_todo": ["Define exhibition calendar", "Define artwork linking", "Define cultural recommendations"]
}
