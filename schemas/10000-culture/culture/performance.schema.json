{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Performance",
  "description": "Artistic performance attendance.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^performance_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "performance_type": { "type": "string", "enum": ["theatre", "dance", "opera", "ballet", "comedy", "standup", "other"] },
    "production_name": { "type": "string" },
    "artist_names": { "type": "array", "items": { "type": "string" } },
    "venue_name": { "type": "string" },
    "venue_city": { "type": "string" },
    "venue_country": { "type": "string" },
    "performance_date": { "type": "string", "format": "date" },
    "start_time": { "type": "string", "format": "time" },
    "end_time": { "type": "string", "format": "time" },
    "attended": { "type": "boolean" },
    "seating_section": { "type": "string" },
    "seat_number": { "type": "string" },
    "ticket_price": { "type": "number" },
    "companions": { "type": "array", "items": { "type": "string" } },
    "overall_rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "performance_quality": { "type": "number", "minimum": 1, "maximum": 5 },
    "memorable_moments": { "type": "array", "items": { "type": "string" } },
    "favorite_scene": { "type": "string" },
    "would_recommend": { "type": "boolean" },
    "would_watch_again": { "type": "boolean" },
    "merchandise_purchased": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "production_name"],
  "_phase1_todo": ["Define performance tracking", "Define artist following", "Define event calendar"]
}
