{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TV Show",
  "description": "Television series.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^tv_show_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "show_title": { "type": "string" },
    "original_title": { "type": "string" },
    "genres": { "type": "array", "items": { "type": "string" } },
    "creators": { "type": "array", "items": { "type": "string" } },
    "cast": { "type": "array", "items": { "type": "string" } },
    "network": { "type": "string" },
    "streaming_service": { "type": "string" },
    "first_aired": { "type": "string", "format": "date" },
    "last_aired": { "type": "string", "format": "date" },
    "total_seasons": { "type": "integer" },
    "total_episodes": { "type": "integer" },
    "episode_runtime_minutes": { "type": "integer" },
    "status": { "type": "string", "enum": ["ongoing", "ended", "cancelled", "upcoming"] },
    "imdb_id": { "type": "string" },
    "imdb_rating": { "type": "number", "minimum": 0, "maximum": 10 },
    "description": { "type": "string" },
    "user_rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "watching": { "type": "boolean" },
    "completed": { "type": "boolean" },
    "current_season": { "type": "integer" },
    "current_episode": { "type": "integer" },
    "on_watchlist": { "type": "boolean" },
    "favorite": { "type": "boolean" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "show_title"],
  "_phase1_todo": ["Define episode tracking", "Define binge history", "Define series completion"]
}
