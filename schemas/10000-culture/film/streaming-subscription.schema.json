{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Streaming Subscription",
  "description": "Streaming service subscription.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^streaming_subscription_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "service_name": { "type": "string", "enum": ["netflix", "amazon_prime", "disney_plus", "hbo_max", "hulu", "apple_tv", "paramount", "peacock", "other"] },
    "subscription_type": { "type": "string", "enum": ["free", "basic", "standard", "premium"] },
    "monthly_cost": { "type": "number" },
    "currency": { "type": "string" },
    "start_date": { "type": "string", "format": "date" },
    "renewal_date": { "type": "string", "format": "date" },
    "is_active": { "type": "boolean" },
    "shared_account": { "type": "boolean" },
    "shared_with": { "type": "array", "items": { "type": "string" } },
    "payment_method": { "type": "string" },
    "auto_renew": { "type": "boolean" },
    "device_limit": { "type": "integer" },
    "ad_supported": { "type": "boolean" },
    "hd_available": { "type": "boolean" },
    "uhd_available": { "type": "boolean" },
    "download_available": { "type": "boolean" },
    "password": { "type": "string" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "service_name"],
  "_phase1_todo": ["Define cost tracking", "Define renewal alerts", "Define service optimization"]
}
