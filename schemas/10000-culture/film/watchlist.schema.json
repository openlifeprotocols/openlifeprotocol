{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Watchlist",
  "description": "Personal film/TV watchlist.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^watchlist_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "watchlist_name": { "type": "string" },
    "description": { "type": "string" },
    "content_items": { "type": "array", "items": { "type": "object", "properties": { "content_id": { "type": "string" }, "title": { "type": "string" }, "added_date": { "type": "string", "format": "date" }, "priority": { "type": "integer" }, "reason": { "type": "string" } } } },
    "total_items": { "type": "integer" },
    "total_estimated_hours": { "type": "number" },
    "genres": { "type": "array", "items": { "type": "string" } },
    "type": { "type": "string", "enum": ["movies", "tv_shows", "mixed"] },
    "is_public": { "type": "boolean" },
    "shared_with": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define item prioritization", "Define collaborative lists", "Define recommendation integration"]
}
