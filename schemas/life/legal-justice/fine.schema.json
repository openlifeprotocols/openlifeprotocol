{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fine",
  "description": "A financial penalty imposed by a court, tribunal, or regulatory body.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^fine_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "legal_matter_id": { "type": "string" },
    "court_case_id": { "type": "string" },
    "imposing_authority": { "type": "string" },
    "fine_type": { "type": "string", "enum": ["criminal_court", "fixed_penalty_notice", "penalty_charge_notice", "regulatory_fine", "civil_penalty", "other"] },
    "offence_or_breach": { "type": "string" },
    "amount": { "type": "number" },
    "currency": { "type": "string" },
    "imposed_date": { "type": "string", "format": "date" },
    "payment_deadline": { "type": "string", "format": "date" },
    "instalments_allowed": { "type": "boolean" },
    "paid_amount": { "type": "number" },
    "paid_date": { "type": "string", "format": "date" },
    "reduced_on_appeal": { "type": "boolean" },
    "appealed": { "type": "boolean" },
    "appeal_outcome": { "type": "string" },
    "enforcement_action": { "type": "string", "enum": ["none", "reminder_sent", "bailiff_instructed", "attachment_of_earnings", "committal_proceedings"] },
    "sensitivity_id": { "type": "string" },
    "status": { "type": "string", "enum": ["outstanding", "partial", "paid", "appealing", "written_off", "enforcing"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "imposing_authority", "fine_type", "amount", "currency", "imposed_date"],
  "_phase1_todo": [
    "Define instalment plan workflow",
    "Define hardship application",
    "Define enforcement escalation timeline",
    "Define fine appeal deadlines"
  ]
}
