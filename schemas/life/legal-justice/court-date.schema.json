{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Court Date",
  "description": "A scheduled court hearing, mention, or tribunal date.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^court_date_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "court_case_id": { "type": "string" },
    "legal_matter_id": { "type": "string" },
    "hearing_type": { "type": "string", "enum": ["mention", "directions", "case_management", "interim_hearing", "main_hearing", "sentencing", "appeal", "costs_assessment", "enforcement", "other"] },
    "scheduled_date": { "type": "string", "format": "date" },
    "scheduled_time": { "type": "string" },
    "court_name": { "type": "string" },
    "court_room": { "type": "string" },
    "attendance_required": { "type": "boolean" },
    "attendees": { "type": "array", "items": { "type": "string" } },
    "remote_hearing": { "type": "boolean" },
    "hearing_link": { "type": "string", "format": "uri" },
    "preparation_tasks": { "type": "array", "items": { "type": "string" } },
    "preparation_deadline": { "type": "string", "format": "date" },
    "outcome_notes": { "type": "string" },
    "next_hearing_id": { "type": "string" },
    "calendar_event_id": { "type": "string" },
    "status": { "type": "string", "enum": ["scheduled", "heard", "adjourned", "vacated", "disposed"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "court_case_id", "hearing_type", "scheduled_date"],
  "_phase1_todo": [
    "Define automatic calendar event creation",
    "Define preparation task generation by hearing type",
    "Define adjournment notification",
    "Define HMCTS hearing bundle deadline"
  ]
}
