{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Safeguarding",
  "description": "A safeguarding concern or referral — protecting adults and children from abuse, neglect, and exploitation. Sealed by default; cross-agency access governed by section 47 / Care Act 2014.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^safeguarding_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string", "description": "Person at risk" },
    "safeguarding_type": { "type": "string", "enum": ["adult_at_risk", "child_protection", "child_in_need", "prevent_referral", "mappa", "marac", "multi_agency_other"] },
    "concern_type": { "type": "string", "enum": ["physical_abuse", "emotional_abuse", "sexual_abuse", "neglect", "financial_abuse", "domestic_violence", "exploitation", "self_harm", "radicalisation", "forced_marriage", "female_genital_mutilation", "modern_slavery", "other"] },
    "referral_source": { "type": "string", "enum": ["police", "social_care", "nhs", "school", "self_referral", "third_party", "probation", "housing", "other"] },
    "referring_organisation": { "type": "string" },
    "referral_date": { "type": "string", "format": "date-time" },
    "s47_enquiry": { "type": "boolean", "description": "Section 47 Children Act 1989 enquiry" },
    "care_act_enquiry": { "type": "boolean", "description": "Care Act 2014 safeguarding enquiry" },
    "case_conference_date": { "type": "string", "format": "date" },
    "protection_plan": { "type": "boolean" },
    "perpetrator_id": { "type": "string" },
    "agencies_involved": { "type": "array", "items": { "type": "string" } },
    "sensitivity_level": { "type": "string", "const": "sealed" },
    "sensitivity_id": { "type": "string" },
    "access_control_id": { "type": "string" },
    "status": { "type": "string", "enum": ["concern_raised", "under_enquiry", "conference_scheduled", "protection_plan_active", "closed"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "safeguarding_type", "concern_type", "referral_date"],
  "_phase1_todo": [
    "Define s47 information sharing gateway",
    "Define MARAC/MAPPA disclosure rules",
    "Define subject access request restrictions for safeguarding data",
    "Define perpetrator record flagging"
  ]
}
