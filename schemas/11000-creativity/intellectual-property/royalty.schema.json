{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Royalty",
  "description": "Royalty payment stream from intellectual property licensing.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^royalty_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "intellectual_property_id": { "type": "string" },
    "licensee_name": { "type": "string" },
    "royalty_type": { "type": "string", "enum": ["sales_royalty", "usage_royalty", "distribution_royalty", "broadcasting", "performance", "mechanical", "print", "other"] },
    "royalty_rate": { "type": "number" },
    "rate_type": { "type": "string", "enum": ["percentage", "per_unit", "per_transaction", "flat_fee"] },
    "minimum_annual_royalty": { "type": "number" },
    "maximum_annual_royalty": { "type": "number" },
    "currency": { "type": "string" },
    "agreement_start_date": { "type": "string", "format": "date" },
    "agreement_end_date": { "type": "string", "format": "date" },
    "renewal_terms": { "type": "string" },
    "total_royalties_received": { "type": "number" },
    "last_payment_date": { "type": "string", "format": "date" },
    "last_payment_amount": { "type": "number" },
    "annual_royalty_estimate": { "type": "number" },
    "payment_frequency": { "type": "string", "enum": ["monthly", "quarterly", "annually", "other"] },
    "accounting_received": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "intellectual_property_id", "licensee_name", "royalty_rate"],
  "_phase1_todo": [
    "Define royalty payment tracking",
    "Define royalty audit process",
    "Define royalty optimization strategies"
  ]
}
