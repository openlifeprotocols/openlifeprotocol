{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Idea",
  "description": "A content idea for creator projects.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^idea_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "creator_profile_id": { "type": "string" },
    "idea_title": { "type": "string" },
    "idea_description": { "type": "string" },
    "idea_type": { "type": "string", "enum": ["video_concept", "podcast_topic", "article_angle", "product_idea", "collaboration_idea", "series_concept"] },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["brainstorm", "developing", "ready_for_production", "in_production", "published", "archived"] },
    "target_audience": { "type": "string" },
    "estimated_effort": { "type": "string", "enum": ["low", "medium", "high", "very_high"] },
    "inspiration_source": { "type": "string" },
    "related_ideas": { "type": "array", "items": { "type": "string" } },
    "production_notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "creator_profile_id", "idea_title", "idea_type"],
  "_phase1_todo": [
    "Define idea validation scoring",
    "Define idea trend analysis",
    "Define idea collaboration suggestions"
  ]
}
