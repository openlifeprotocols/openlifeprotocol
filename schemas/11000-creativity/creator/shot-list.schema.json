{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shot List",
  "description": "A list of shots or scenes to capture for video production.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^shot_list_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "video_id": { "type": "string" },
    "creative_project_id": { "type": "string" },
    "list_title": { "type": "string" },
    "shoot_date": { "type": "string", "format": "date" },
    "location": { "type": "string" },
    "total_shots": { "type": "integer" },
    "shots": { "type": "array", "items": { "type": "object", "properties": { "shot_number": { "type": "integer" }, "description": { "type": "string" }, "duration_seconds": { "type": "number" }, "equipment_needed": { "type": "array", "items": { "type": "string" } }, "is_completed": { "type": "boolean" } } } },
    "estimated_duration": { "type": "integer" },
    "crew_needed": { "type": "array", "items": { "type": "string" } },
    "equipment_list": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "creative_project_id", "list_title"],
  "_phase1_todo": [
    "Define shot list scheduling",
    "Define shot list equipment tracking",
    "Define shot completion progress"
  ]
}
