{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Breed",
  "description": "A breed registry entry — a recognised or informal breed within a species.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^breed_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "species_id": { "type": "string" },
    "name": { "type": "string", "examples": ["Labrador Retriever", "British Shorthair", "Dutch Rabbit"] },
    "recognised_by": { "type": "array", "items": { "type": "string" }, "examples": [["The Kennel Club", "FCI"]] },
    "size_category": { "type": "string", "enum": ["toy", "small", "medium", "large", "giant", "n_a"] },
    "breed_specific_legislation": { "type": "boolean" },
    "legislation_details": { "type": "string" },
    "common_health_conditions": { "type": "array", "items": { "type": "string" } },
    "typical_lifespan_years": { "type": "object", "properties": { "min": { "type": "number" }, "max": { "type": "number" } } },
    "exercise_needs": { "type": "string", "enum": ["low", "moderate", "high", "very_high"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "species_id", "name"],
  "_phase1_todo": [
    "Define breed health testing requirements",
    "Define breed-specific insurance loading",
    "Define working breed licensing",
    "Define Kennel Club registration integration"
  ]
}
