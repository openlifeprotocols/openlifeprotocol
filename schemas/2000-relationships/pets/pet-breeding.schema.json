{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pet Breeding",
  "description": "A breeding record — a planned or actual mating between two animals with litter outcomes.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^pet_breeding_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "dam_id": { "type": "string", "description": "Mother" },
    "sire_id": { "type": "string", "description": "Father" },
    "dam_owner_id": { "type": "string" },
    "sire_owner_id": { "type": "string" },
    "mating_date": { "type": "string", "format": "date" },
    "expected_whelping_date": { "type": "string", "format": "date" },
    "actual_whelping_date": { "type": "string", "format": "date" },
    "litter_size": { "type": "integer" },
    "surviving_pups": { "type": "integer" },
    "offspring_ids": { "type": "array", "items": { "type": "string" } },
    "registered_litter": { "type": "boolean" },
    "registry_name": { "type": "string" },
    "litter_reference": { "type": "string" },
    "health_tests_completed": { "type": "array", "items": { "type": "string" }, "description": "e.g., hip score, eye test" },
    "licence_required": { "type": "boolean" },
    "licence_reference": { "type": "string" },
    "stud_fee": { "type": "number" },
    "currency": { "type": "string" },
    "status": { "type": "string", "enum": ["planned", "confirmed", "whelped", "registered"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "dam_id", "sire_id"],
  "_phase1_todo": [
    "Define breeder licence compliance (Animal Welfare Act)",
    "Define Lucy's Law compliance for England",
    "Define Kennel Club litter registration",
    "Define genetic health testing requirements by breed"
  ]
}
