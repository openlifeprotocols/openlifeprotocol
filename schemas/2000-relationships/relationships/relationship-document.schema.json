{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relationship Document",
  "description": "Documents shared between related people.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^relationship_document_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "relationship_id": { "type": "string" },
    "document_id": { "type": "string" },
    "document_relevance": { "type": "string", "enum": ["both_parties", "person_one_only", "person_two_only", "shared_decision"] },
    "is_shared": { "type": "boolean" },
    "shared_date": { "type": "string", "format": "date-time" },
    "access_level": { "type": "string", "enum": ["view_only", "comment", "edit"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "relationship_id"],
  "_phase1_todo": ["Define sharing permissions", "Define access audit", "Define conflict tracking"]
}
