{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relationship",
  "description": "Relationship between people.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^relationship_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_one_id": { "type": "string" },
    "person_two_id": { "type": "string" },
    "relationship_type": { "type": "string", "enum": ["spouse", "parent", "child", "sibling", "grandparent", "grandchild", "cousin", "extended_family", "friend", "colleague", "professional", "other"] },
    "relationship_status": { "type": "string", "enum": ["active", "estranged", "deceased", "unknown"] },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "is_reciprocal": { "type": "boolean" },
    "relationship_strength": { "type": "string", "enum": ["weak", "moderate", "strong", "very_strong"] },
    "emergency_contact": { "type": "boolean" },
    "beneficiary": { "type": "boolean" },
    "power_of_attorney": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_one_id", "person_two_id"],
  "_phase1_todo": ["Define relationship visualization", "Define genealogy mapping", "Define conflict resolution"]
}
