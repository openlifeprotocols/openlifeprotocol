{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relationship History",
  "description": "Timeline of relationship changes.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^relationship_history_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "relationship_id": { "type": "string" },
    "event_type": { "type": "string", "enum": ["start", "status_change", "breakup", "reunion", "reconciliation", "death", "other"] },
    "event_date": { "type": "string", "format": "date" },
    "event_description": { "type": "string" },
    "document_id": { "type": "string" },
    "notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "relationship_id"],
  "_phase1_todo": ["Define history visualization", "Define milestone tracking", "Define anniversary alerts"]
}
