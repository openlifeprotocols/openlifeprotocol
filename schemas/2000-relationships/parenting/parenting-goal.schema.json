{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parenting Goal",
  "description": "Parenting goal or objective.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^parenting_goal_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "child_id": { "type": "string" },
    "child_name": { "type": "string" },
    "goal_name": { "type": "string" },
    "goal_type": { "type": "string", "enum": ["behavioral", "academic", "health", "emotional", "social", "skill_development", "values", "other"] },
    "description": { "type": "string" },
    "target_behavior_or_skill": { "type": "string" },
    "current_status": { "type": "string" },
    "target_achievement_date": { "type": "string", "format": "date" },
    "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "strategies": { "type": "array", "items": { "type": "string" } },
    "progress_tracking": { "type": "string" },
    "milestones": { "type": "array", "items": { "type": "object", "properties": { "milestone": { "type": "string" }, "target_date": { "type": "string", "format": "date" }, "achieved_date": { "type": "string", "format": "date" } } } },
    "challenges": { "type": "array", "items": { "type": "string" } },
    "resources_needed": { "type": "array", "items": { "type": "string" } },
    "parenting_expert_advice": { "type": "string" },
    "progress_notes": { "type": "string" },
    "success_rate_percentage": { "type": "number", "minimum": 0, "maximum": 100 },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "child_name", "goal_name"],
  "_phase1_todo": ["Define goal tracking", "Define progress alerts", "Define reflection cycle"]
}
