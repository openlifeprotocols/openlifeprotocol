{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Help Request",
  "description": "Request for community help or support.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^help_request_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "request_type": { "type": "string", "enum": ["physical_help", "skills", "childcare", "elder_care", "transportation", "meals", "financial", "emotional_support", "other"] },
    "description": { "type": "string" },
    "urgency": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
    "preferred_date": { "type": "string", "format": "date" },
    "time_commitment_hours": { "type": "number" },
    "location": { "type": "string" },
    "request_date": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["open", "matched", "in_progress", "completed", "cancelled"] },
    "helpers_count": { "type": "integer" },
    "outcome_description": { "type": "string" },
    "resolution_date": { "type": "string", "format": "date" },
    "thank_you_notes_sent": { "type": "boolean" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "request_type"],
  "_phase1_todo": ["Define matching algorithm", "Define notification system", "Define follow-up tracking"]
}
