{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mutual Aid",
  "description": "Mutual aid or community support exchange.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^mutual_aid_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "exchange_type": { "type": "string", "enum": ["skill_share", "tool_lending", "food_share", "childcare", "elder_care", "moving_help", "other"] },
    "provider_person_id": { "type": "string" },
    "recipient_person_id": { "type": "string" },
    "description": { "type": "string" },
    "date_exchanged": { "type": "string", "format": "date" },
    "time_exchanged": { "type": "string", "format": "time" },
    "duration_hours": { "type": "number" },
    "location": { "type": "string" },
    "outcome": { "type": "string" },
    "satisfaction_rating": { "type": "integer", "minimum": 1, "maximum": 5 },
    "follow_up_needed": { "type": "boolean" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define exchange matching", "Define reciprocity tracking", "Define rating system"]
}
