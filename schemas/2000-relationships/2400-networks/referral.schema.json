{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Network Referral",
  "description": "A referral event through the network where one actor introduces or recommends another.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^network_referral_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "network_id": { "type": "string" },
    "referrer_actor_id": { "type": "string" },
    "referred_actor_id": { "type": "string" },
    "recipient_actor_id": { "type": "string" },
    "referral_context": { "type": "string" },
    "status": { "type": "string", "enum": ["proposed", "made", "accepted", "declined", "converted", "closed"] },
    "outcome": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "referrer_actor_id", "referred_actor_id", "status"]
}
