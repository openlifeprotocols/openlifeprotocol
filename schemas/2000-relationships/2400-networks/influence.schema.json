{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Influence Edge",
  "description": "A directional influence relationship indicating where decisions, opportunities, or visibility are shaped.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^influence_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "from_actor_id": { "type": "string" },
    "to_actor_id": { "type": "string" },
    "influence_domain": { "type": "string", "enum": ["career", "business", "capital", "community", "media", "learning", "other"] },
    "level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "from_actor_id", "to_actor_id", "influence_domain", "level"]
}
