{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Development Plan",
  "description": "Personal or professional development plan.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^development_plan_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "plan_name": { "type": "string" },
    "plan_type": { "type": "string", "enum": ["career", "personal", "skill", "health", "education", "financial"] },
    "created_date": { "type": "string", "format": "date-time" },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "overall_vision": { "type": "string" },
    "current_situation": { "type": "string" },
    "strengths_to_leverage": { "type": "array", "items": { "type": "string" } },
    "gaps_to_address": { "type": "array", "items": { "type": "string" } },
    "strategic_objectives": { "type": "array", "items": { "type": "string" } },
    "action_items": { "type": "array", "items": { "type": "object", "properties": { "action": { "type": "string" }, "target_date": { "type": "string", "format": "date" }, "priority": { "type": "string" }, "owner": { "type": "string" }, "status": { "type": "string" } } } },
    "resources_required": { "type": "array", "items": { "type": "string" } },
    "mentors_or_coaches": { "type": "array", "items": { "type": "string" } },
    "success_metrics": { "type": "array", "items": { "type": "string" } },
    "milestone_dates": { "type": "array", "items": { "type": "object", "properties": { "milestone": { "type": "string" }, "target_date": { "type": "string", "format": "date" } } } },
    "review_frequency": { "type": "string" },
    "progress_to_date": { "type": "string" },
    "adjustments_made": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "plan_name"],
  "_phase1_todo": ["Define quarterly reviews", "Define milestone tracking", "Define accomplishment measurement"]
}
