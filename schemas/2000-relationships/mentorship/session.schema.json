{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mentee",
  "description": "Mentorship relationship - mentee perspective.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^mentee_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "mentor_name": { "type": "string" },
    "mentor_contact": { "type": "string" },
    "mentor_expertise": { "type": "array", "items": { "type": "string" } },
    "relationship_type": { "type": "string", "enum": ["professional", "personal", "academic", "life_coaching"] },
    "learning_goals": { "type": "array", "items": { "type": "string" } },
    "started_date": { "type": "string", "format": "date" },
    "duration_months": { "type": "integer" },
    "meeting_frequency": { "type": "string" },
    "meeting_format": { "type": "string" },
    "initial_challenges": { "type": "array", "items": { "type": "string" } },
    "skills_developed": { "type": "array", "items": { "type": "string" } },
    "progress_made": { "type": "string" },
    "mentor_contributions": { "type": "array", "items": { "type": "string" } },
    "advice_that_helped": { "type": "array", "items": { "type": "string" } },
    "doors_opened": { "type": "array", "items": { "type": "string" } },
    "network_expanded": { "type": "string" },
    "confidence_growth": { "type": "number", "minimum": 1, "maximum": 10 },
    "mentorship_satisfaction": { "type": "number", "minimum": 1, "maximum": 5 },
    "most_valuable_insight": { "type": "string" },
    "impact_on_career_or_life": { "type": "string" },
    "would_stay_in_touch": { "type": "boolean" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "mentor_name"],
  "_phase1_todo": ["Define goal tracking", "Define progress check-ins", "Define relationship lifecycle"]
}
