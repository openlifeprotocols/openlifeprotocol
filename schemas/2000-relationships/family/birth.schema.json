{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Birth",
  "description": "A birth registration record, linking a newborn to parents and producing the foundational identity event.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^birth_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "external_ids": {
      "type": "array",
      "items": { "type": "object", "properties": { "system": { "type": "string" }, "id": { "type": "string" } }, "required": ["system", "id"] }
    },
    "child_person_id": { "type": "string" },
    "given_names": { "type": "string" },
    "family_name": { "type": "string" },
    "date_of_birth": { "type": "string", "format": "date" },
    "time_of_birth": { "type": "string", "format": "time" },
    "place_of_birth": {
      "type": "object",
      "properties": {
        "facility_name": { "type": "string" },
        "city": { "type": "string" },
        "country": { "type": "string" }
      }
    },
    "sex_at_birth": { "type": "string", "enum": ["male", "female", "intersex", "unknown"] },
    "parents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "person_id": { "type": "string" },
          "parental_role": { "type": "string", "enum": ["birth_parent", "adoptive_parent", "legal_parent", "other"] }
        },
        "required": ["parental_role"]
      }
    },
    "registration": {
      "type": "object",
      "properties": {
        "registered_at": { "type": "string", "format": "date" },
        "registrar_id": { "type": "string" },
        "registration_number": { "type": "string" },
        "jurisdiction_id": { "type": "string" }
      }
    },
    "event_id": { "type": "string", "description": "Reference to core Event record" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "given_names", "family_name", "date_of_birth"],
  "_phase1_todo": [
    "Define late birth registration",
    "Define birth certificate issuance",
    "Define stateless and undocumented births",
    "Define posthumous birth procedures"
  ]
}
