{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Financial Risk",
  "description": "A personal financial risk such as income loss, over-leverage, currency exposure or fraud.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^financial_risk_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "category": { "type": "string", "enum": ["income-loss", "over-leverage", "concentration", "currency", "fraud", "market", "liquidity", "tax", "counterparty", "dependency"] },
    "likelihood": { "type": "string", "enum": ["rare", "unlikely", "possible", "likely", "almost-certain"] },
    "impact": { "type": "string", "enum": ["minor", "moderate", "significant", "severe", "critical"] },
    "estimated_exposure": { "type": "number" },
    "exposure_currency": { "type": "string" },
    "mitigations": { "type": "array", "items": { "type": "string" } },
    "insurance_coverage": { "type": "boolean" },
    "review_date": { "type": "string", "format": "date" },
    "notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "title", "category", "likelihood", "impact"]
}
