{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Life Event",
  "description": "Major life event (birth, marriage, death, etc).",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^life_event_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "event_type": { "type": "string", "enum": ["birth", "marriage", "divorce", "death", "relocation", "job_change", "education", "accident", "illness", "legal_issue", "other"] },
    "event_date": { "type": "string", "format": "date" },
    "event_location": { "type": "string" },
    "description": { "type": "string" },
    "related_people": { "type": "array", "items": { "type": "string" } },
    "impact_level": { "type": "string", "enum": ["minor", "significant", "major", "life_changing"] },
    "requires_action": { "type": "boolean" },
    "action_items": { "type": "array", "items": { "type": "string" } },
    "documents_related": { "type": "array", "items": { "type": "string" } },
    "photos_or_media": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define action item automation", "Define related document linking", "Define impact analysis"]
}
