{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exit",
  "description": "Startup exit event — acquisition, IPO, or other liquidity event.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^exit_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "startup_id": { "type": "string" },
    "exit_type": { "type": "string", "enum": ["acquisition", "ipo", "merger", "secondary_sale", "liquidation", "other"] },
    "exit_date": { "type": "string", "format": "date" },
    "announcement_date": { "type": "string", "format": "date" },
    "acquirer_name": { "type": "string" },
    "exit_valuation": { "type": "number" },
    "currency": { "type": "string" },
    "price_per_share": { "type": "number" },
    "total_transaction_value": { "type": "number" },
    "cash_component": { "type": "number" },
    "stock_component": { "type": "number" },
    "earnout_potential": { "type": "number" },
    "founder_return": { "type": "number" },
    "investor_return": { "type": "number" },
    "employee_return": { "type": "number" },
    "return_multiple": { "type": "number" },
    "internal_rate_of_return": { "type": "number" },
    "years_to_exit": { "type": "integer" },
    "employee_retention_required": { "type": "boolean" },
    "retention_period_months": { "type": "integer" },
    "earnout_status": { "type": "string", "enum": ["not_applicable", "pending", "partially_achieved", "fully_achieved", "failed"] },
    "post_exit_status": { "type": "string", "enum": ["completed", "in_transition", "cancelled"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "startup_id", "exit_type", "exit_date"],
  "_phase1_todo": [
    "Define exit outcome tracking",
    "Define shareholder payoff distribution",
    "Define post-exit founder transition"
  ]
}
