{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contractor (Business)",
  "description": "A contractor or freelancer engaged by the business — outside IR35 or inside, with statement of work and day rate.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^biz_contractor_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "business_id": { "type": "string" },
    "person_id": { "type": "string" },
    "supplier_id": { "type": "string" },
    "department_id": { "type": "string" },
    "role": { "type": "string" },
    "ir35_status": { "type": "string", "enum": ["inside", "outside", "not_assessed"] },
    "day_rate": { "type": "number" },
    "currency": { "type": "string" },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "purchase_order_id": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "ended", "extended"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "business_id", "role"],
  "_phase1_todo": ["Define IR35 assessment workflow", "Define SOW approval", "Define contractor off-boarding"]
}
