{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "depreciation (Business Assets)",
  "description": "Business asset schema for depreciation. References resources/asset.schema.json where applicable.",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "uuid": { "type": "string", "format": "uuid" },
    "business_id": { "type": "string" },
    "name": { "type": "string" },
    "asset_value": { "type": "number" },
    "currency": { "type": "string" },
    "acquired_date": { "type": "string", "format": "date" },
    "status": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "business_id", "name"],
  "_phase1_todo": ["Define depreciation asset register", "Define depreciation depreciation schedule", "Define depreciation disposal workflow"]
}
