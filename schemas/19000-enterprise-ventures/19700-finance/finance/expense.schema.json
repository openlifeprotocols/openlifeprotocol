{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Expense (Business)",
  "description": "A business expense — an incurred cost submitted for reimbursement or directly coded to a cost centre.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^biz_expense_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "business_id": { "type": "string" },
    "submitted_by_id": { "type": "string" },
    "approved_by_id": { "type": "string" },
    "expense_date": { "type": "string", "format": "date" },
    "category": { "type": "string", "enum": ["travel", "accommodation", "meals", "equipment", "software", "training", "marketing", "professional_fees", "utilities", "other"] },
    "description": { "type": "string" },
    "amount": { "type": "number" },
    "currency": { "type": "string" },
    "vat_reclaimable": { "type": "boolean" },
    "vat_amount": { "type": "number" },
    "project_id": { "type": "string" },
    "cost_centre": { "type": "string" },
    "receipt_document_id": { "type": "string" },
    "reimbursed": { "type": "boolean" },
    "reimbursed_date": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["draft", "submitted", "approved", "rejected", "reimbursed"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "business_id", "submitted_by_id", "expense_date", "category", "amount", "currency"],
  "_phase1_todo": ["Define expense policy rules engine", "Define OCR receipt capture", "Define mileage calculation", "Define per diem rates"]
}
