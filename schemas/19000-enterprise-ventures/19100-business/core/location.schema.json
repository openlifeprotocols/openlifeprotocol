{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Location",
  "description": "A physical or virtual business location — office, warehouse, retail unit, or remote/home.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^location_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "business_id": { "type": "string" },
    "name": { "type": "string" },
    "location_type": { "type": "string", "enum": ["head_office", "branch", "warehouse", "retail", "manufacturing", "data_centre", "remote", "virtual", "home_office", "other"] },
    "address_id": { "type": "string" },
    "is_registered_address": { "type": "boolean" },
    "contact_point_ids": { "type": "array", "items": { "type": "string" } },
    "manager_id": { "type": "string" },
    "employee_count": { "type": "integer" },
    "floor_area_sqm": { "type": "number" },
    "lease_end_date": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["active", "closed", "planned"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "business_id", "name", "location_type"],
  "_phase1_todo": ["Define lease management workflow", "Define location capacity planning", "Define multi-site reporting"]
}
