{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sales Contract",
  "description": "Sales context wrapper for canonical contract records (MSA, SOW, subscription, service agreements).",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^sales_contract_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "business_id": { "type": "string" },
    "customer_id": { "type": "string" },
    "opportunity_id": { "type": "string" },
    "contract_type": { "type": "string", "enum": ["msa", "sow", "nda", "saas_subscription", "service_agreement", "partnership", "reseller", "other"] },
    "title": { "type": "string" },
    "value": { "type": "number" },
    "currency": { "type": "string" },
    "billing_frequency": { "type": "string", "enum": ["monthly", "quarterly", "annual", "one_off", "milestone"] },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "auto_renews": { "type": "boolean" },
    "notice_period_days": { "type": "integer" },
    "signed_date": { "type": "string", "format": "date" },
    "signed_by_ids": { "type": "array", "items": { "type": "string" } },
    "document_id": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "negotiating", "signed", "active", "expired", "terminated"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "business_id", "customer_id", "contract_type", "value", "currency"],
  "_phase1_todo": ["Define contract renewal workflow", "Define contract obligation tracking", "Define early termination penalty"]
}
