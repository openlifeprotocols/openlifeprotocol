{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project",
  "description": "Project within area of focus.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^project_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "area_of_focus_id": { "type": "string" },
    "project_name": { "type": "string" },
    "project_description": { "type": "string" },
    "project_status": { "type": "string", "enum": ["idea", "planning", "in_progress", "on_hold", "completed", "cancelled"] },
    "priority_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "start_date": { "type": "string", "format": "date" },
    "target_completion_date": { "type": "string", "format": "date" },
    "actual_completion_date": { "type": "string", "format": "date" },
    "goals": { "type": "array", "items": { "type": "string" } },
    "action_items": { "type": "array", "items": { "type": "string" } },
    "resources_needed": { "type": "array", "items": { "type": "string" } },
    "progress_percentage": { "type": "number" },
    "outcomes": { "type": "string" },
    "learnings": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define project templates", "Define dependency management", "Define project analytics"]
}
