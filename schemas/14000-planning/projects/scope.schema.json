{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scope",
  "description": "The defined scope of a project — what is included, excluded, and the agreed change control process.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^scope_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "in_scope": { "type": "array", "items": { "type": "string" } },
    "out_of_scope": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "change_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "changed_date": { "type": "string", "format": "date" },
          "description": { "type": "string" },
          "approved_by_id": { "type": "string" },
          "cost_impact": { "type": "number" },
          "time_impact_days": { "type": "integer" }
        }
      }
    },
    "approved_by_ids": { "type": "array", "items": { "type": "string" } },
    "approved_date": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["draft", "approved", "superseded"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "project_id", "in_scope", "out_of_scope"],
  "_phase1_todo": [
    "Define scope creep detection",
    "Define change request workflow",
    "Define scope sign-off procedures",
    "Define scope baseline freeze"
  ]
}
