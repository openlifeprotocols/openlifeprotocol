{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision Review",
  "description": "Retrospective review of a past decision.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^decision_review_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "decision_journal_id": { "type": "string" },
    "decision_name": { "type": "string" },
    "decision_date": { "type": "string", "format": "date" },
    "review_date": { "type": "string", "format": "date" },
    "months_since_decision": { "type": "integer" },
    "decision_outcome": { "type": "string", "enum": ["better_than_expected", "as_expected", "worse_than_expected"] },
    "outcome_description": { "type": "string" },
    "success_metrics": { "type": "object", "properties": { "metric": { "type": "string" }, "target": { "type": "string" }, "actual": { "type": "string" } }, "additionalProperties": true },
    "lessons_learned": { "type": "array", "items": { "type": "string" } },
    "what_went_well": { "type": "array", "items": { "type": "string" } },
    "what_went_wrong": { "type": "array", "items": { "type": "string" } },
    "unexpected_consequences": { "type": "array", "items": { "type": "string" } },
    "would_decide_differently": { "type": "boolean" },
    "alternative_decision_quality": { "type": "string" },
    "factors_that_mattered_most": { "type": "array", "items": { "type": "string" } },
    "factors_that_mattered_least": { "type": "array", "items": { "type": "string" } },
    "biases_identified": { "type": "array", "items": { "type": "string" } },
    "hindsight_bias_adjustment": { "type": "string" },
    "improvement_areas": { "type": "array", "items": { "type": "string" } },
    "confidence_in_past_reasoning": { "type": "number", "minimum": 1, "maximum": 10 },
    "satisfaction_with_outcome": { "type": "number", "minimum": 1, "maximum": 5 },
    "impact_assessment": { "type": "string" },
    "future_decisions_influenced": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "decision_name"],
  "_phase1_todo": ["Define review scheduling", "Define pattern recognition", "Define bias analytics"]
}
