{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision Outcome",
  "description": "Outcome or result from a decision.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^decision_outcome_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "decision_journal_id": { "type": "string" },
    "decision_name": { "type": "string" },
    "original_decision_date": { "type": "string", "format": "date" },
    "outcome_recording_date": { "type": "string", "format": "date" },
    "outcome_status": { "type": "string", "enum": ["in_progress", "complete", "partially_complete", "abandoned", "failed", "pending"] },
    "expected_outcome": { "type": "string" },
    "actual_outcome": { "type": "string" },
    "outcome_vs_expectation": { "type": "string", "enum": ["exceeded", "met", "partially_met", "not_met"] },
    "measurable_results": { "type": "object", "additionalProperties": true },
    "qualitative_assessment": { "type": "string" },
    "financial_impact": { "type": "number" },
    "time_impact": { "type": "string" },
    "relationship_impact": { "type": "string" },
    "health_impact": { "type": "string" },
    "career_impact": { "type": "string" },
    "personal_growth": { "type": "string" },
    "ripple_effects": { "type": "array", "items": { "type": "string" } },
    "unintended_consequences": { "type": "array", "items": { "type": "string" } },
    "opportunity_cost": { "type": "string" },
    "satisfaction_rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "learning_captured": { "type": "array", "items": { "type": "string" } },
    "next_steps": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "decision_name"],
  "_phase1_todo": ["Define outcome tracking", "Define impact analytics", "Define learning extraction"]
}
