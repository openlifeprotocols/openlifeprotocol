{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Affidavit",
  "description": "Sworn statement or affidavit.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^affidavit_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "affiant_person_id": { "type": "string" },
    "affidavit_type": { "type": "string", "enum": ["general", "affidavit_of_service", "affidavit_of_support", "financial_affidavit", "personal_injury", "other"] },
    "subject_matter": { "type": "string" },
    "affidavit_text": { "type": "string" },
    "statements": { "type": "array", "items": { "type": "object", "properties": { "statement_number": { "type": "integer" }, "statement_text": { "type": "string" }, "is_material": { "type": "boolean" } } } },
    "execution_date": { "type": "string", "format": "date" },
    "notary_name": { "type": "string" },
    "notary_license_number": { "type": "string" },
    "notarization_date": { "type": "string", "format": "date" },
    "notarization_location": { "type": "string" },
    "case_number": { "type": "string" },
    "court_name": { "type": "string" },
    "filed_date": { "type": "string", "format": "date" },
    "document_id": { "type": "string" },
    "status": { "type": "string", "enum": ["drafted", "notarized", "filed", "archived"] },
    "penalties_for_perjury": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "affiant_person_id"],
  "_phase1_todo": ["Define affidavit validation", "Define filing tracking", "Define archive management"]
}
