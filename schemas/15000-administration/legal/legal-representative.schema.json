{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Legal Representative",
  "description": "A legal representative — solicitor, barrister, legal guardian, or McKenzie friend — authorised to act for a party.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^legal_rep_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "actor_id": { "type": "string" },
    "representative_type": { "type": "string", "enum": ["solicitor", "barrister", "legal_executive", "licensed_conveyancer", "mckenzie_friend", "pro_bono", "lay_representative", "guardian_ad_litem"] },
    "firm_name": { "type": "string" },
    "sra_number": { "type": "string" },
    "bar_reference": { "type": "string" },
    "representing_actor_id": { "type": "string" },
    "case_ids": { "type": "array", "items": { "type": "string" } },
    "authority_document_id": { "type": "string" },
    "instructed_date": { "type": "string", "format": "date" },
    "terminated_date": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["instructed", "active", "terminated", "withdrawn"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "representative_type", "representing_actor_id"],
  "_phase1_todo": [
    "Define conflict of interest checking",
    "Define legal aid eligibility",
    "Define pro bono referral workflow",
    "Define barrister cab rank rule"
  ]
}
