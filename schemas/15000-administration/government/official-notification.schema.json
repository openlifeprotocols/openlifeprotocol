{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Official Notification",
  "description": "A formal notification from a government or official body — court summons, tax demand, enforcement notice, etc.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^official_notification_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "recipient_id": { "type": "string" },
    "sender_organisation_id": { "type": "string" },
    "notification_type": { "type": "string", "enum": ["tax_demand", "court_summons", "jury_summons", "enforcement_notice", "penalty_charge", "benefit_decision", "planning_decision", "eviction_notice", "immigration_decision", "other"] },
    "reference": { "type": "string" },
    "issued_date": { "type": "string", "format": "date" },
    "deadline": { "type": "string", "format": "date" },
    "response_required": { "type": "boolean" },
    "response_actions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Actions recipient can or must take"
    },
    "document_id": { "type": "string" },
    "read_at": { "type": "string", "format": "date-time" },
    "acknowledged_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["issued", "delivered", "read", "responded", "overdue", "closed"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "recipient_id", "notification_type", "issued_date"],
  "_phase1_todo": [
    "Define legal notice delivery standards",
    "Define notification escalation on no response",
    "Define notification dispute procedures",
    "Define translation rights for official notices"
  ]
}
