{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arrest Record",
  "description": "A record of an arrest — distinct from a charge or conviction. Not evidence of guilt. Sealed by default; accessible only to the subject and authorised bodies.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^arrest_record_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "legal_matter_id": { "type": "string" },
    "arrested_date": { "type": "string", "format": "date-time" },
    "arresting_force": { "type": "string" },
    "grounds_for_arrest": { "type": "string" },
    "custody_location": { "type": "string" },
    "custody_reference": { "type": "string" },
    "detained_hours": { "type": "number" },
    "released_date": { "type": "string", "format": "date-time" },
    "release_type": { "type": "string", "enum": ["released_no_further_action", "released_under_investigation", "bail", "charged", "voluntary_attendance"] },
    "bail_conditions": { "type": "array", "items": { "type": "string" } },
    "bail_expiry": { "type": "string", "format": "date" },
    "charge_id": { "type": "string" },
    "solicitor_present": { "type": "boolean" },
    "duty_solicitor_used": { "type": "boolean" },
    "appropriate_adult_present": { "type": "boolean" },
    "sensitivity_level": { "type": "string", "const": "sealed" },
    "sensitivity_id": { "type": "string" },
    "access_control_id": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "arrested_date", "arresting_force"],
  "_phase1_todo": [
    "Define appropriate adult requirement (children/vulnerable)",
    "Define PACE Code C compliance",
    "Define bail review workflow",
    "Define arrest-to-charge timeline monitoring"
  ]
}
