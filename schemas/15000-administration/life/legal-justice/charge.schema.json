{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Charge",
  "description": "A criminal charge — a formal allegation that a person committed a specific offence.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^charge_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "legal_matter_id": { "type": "string" },
    "court_case_id": { "type": "string" },
    "charge_reference": { "type": "string" },
    "offence_code": { "type": "string", "description": "MoJ offence code" },
    "offence_description": { "type": "string" },
    "offence_category": { "type": "string", "enum": ["summary_only", "either_way", "indictable_only"] },
    "alleged_date_from": { "type": "string", "format": "date" },
    "alleged_date_to": { "type": "string", "format": "date" },
    "charged_date": { "type": "string", "format": "date" },
    "plea": { "type": "string", "enum": ["guilty", "not_guilty", "no_plea_entered", "equivocal"] },
    "plea_date": { "type": "string", "format": "date" },
    "cps_reference": { "type": "string" },
    "sensitivity_level": { "type": "string", "const": "highly_restricted" },
    "sensitivity_id": { "type": "string" },
    "access_control_id": { "type": "string" },
    "status": { "type": "string", "enum": ["pending", "plea_entered", "convicted", "acquitted", "discontinued", "stayed", "nolle_prosequi"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "offence_description", "charged_date"],
  "_phase1_todo": [
    "Define multiple charges on one case",
    "Define lesser included offence tracking",
    "Define disclosure obligations (Criminal Procedure Rules)",
    "Define plea in mitigation documentation"
  ]
}
