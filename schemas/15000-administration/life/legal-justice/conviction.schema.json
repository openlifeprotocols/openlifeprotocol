{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conviction",
  "description": "A criminal conviction — a guilty verdict or guilty plea, with offence, disposal, and spent status.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^conviction_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "charge_id": { "type": "string" },
    "court_case_id": { "type": "string" },
    "conviction_date": { "type": "string", "format": "date" },
    "conviction_type": { "type": "string", "enum": ["guilty_plea", "guilty_verdict", "caution", "conditional_caution", "reprimand", "final_warning"] },
    "offence_description": { "type": "string" },
    "court_name": { "type": "string" },
    "sentence_id": { "type": "string" },
    "is_spent": { "type": "boolean", "description": "Spent under Rehabilitation of Offenders Act 1974" },
    "becomes_spent_date": { "type": "string", "format": "date" },
    "is_protected": { "type": "boolean", "description": "Protected from DBS filtering rules" },
    "appealed": { "type": "boolean" },
    "appeal_outcome": { "type": "string", "enum": ["conviction_upheld", "conviction_quashed", "sentence_reduced", "pending"] },
    "sensitivity_level": { "type": "string", "const": "highly_restricted" },
    "sensitivity_id": { "type": "string" },
    "access_control_id": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "conviction_date", "conviction_type", "offence_description"],
  "_phase1_todo": [
    "Define ROA 1974 rehabilitation period calculator",
    "Define protected conviction filtering (DBS)",
    "Define self-disclosure guidance matrix",
    "Define conviction impact on professional licences"
  ]
}
