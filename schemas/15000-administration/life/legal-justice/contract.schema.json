{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contract (Legal)",
  "description": "A legally binding contract between parties — with terms, obligations, execution, and breach tracking.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^contract_lj_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "legal_matter_id": { "type": "string" },
    "title": { "type": "string" },
    "contract_type": { "type": "string", "enum": ["sale_of_goods", "service_agreement", "employment", "tenancy", "loan", "settlement", "non_disclosure", "partnership", "franchise", "licence", "construction", "other"] },
    "parties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actor_id": { "type": "string" },
          "role": { "type": "string", "enum": ["seller", "buyer", "employer", "employee", "landlord", "tenant", "lender", "borrower", "licensor", "licensee", "contractor", "client", "other"] }
        },
        "required": ["actor_id", "role"]
      }
    },
    "effective_date": { "type": "string", "format": "date" },
    "expiry_date": { "type": "string", "format": "date" },
    "signed_date": { "type": "string", "format": "date" },
    "consideration": { "type": "string", "description": "What each party gives — the consideration" },
    "key_obligations": { "type": "array", "items": { "type": "string" } },
    "termination_clauses": { "type": "array", "items": { "type": "string" } },
    "governing_law": { "type": "string" },
    "dispute_resolution": { "type": "string", "enum": ["english_courts", "arbitration", "mediation", "expert_determination"] },
    "is_breached": { "type": "boolean" },
    "breach_description": { "type": "string" },
    "document_id": { "type": "string" },
    "sensitivity_id": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "negotiating", "executed", "active", "expired", "terminated", "breached", "disputed"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "title", "contract_type", "parties"],
  "_phase1_todo": [
    "Define obligation tracking and reminders",
    "Define breach notification workflow",
    "Define contract amendment process",
    "Define automatic expiry alerts"
  ]
}
