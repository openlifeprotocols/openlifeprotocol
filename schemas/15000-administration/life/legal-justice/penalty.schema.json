{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Penalty",
  "description": "A civil or regulatory penalty — sanction, disqualification, ban, or restriction imposed by a body other than a criminal court.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^penalty_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "legal_matter_id": { "type": "string" },
    "imposing_body": { "type": "string" },
    "penalty_type": { "type": "string", "enum": ["financial", "disqualification", "ban", "restriction", "suspension", "warning", "reprimand", "conditions_imposed", "other"] },
    "reason": { "type": "string" },
    "financial_amount": { "type": "number" },
    "currency": { "type": "string" },
    "imposed_date": { "type": "string", "format": "date" },
    "effective_from": { "type": "string", "format": "date" },
    "effective_to": { "type": "string", "format": "date" },
    "conditions": { "type": "array", "items": { "type": "string" } },
    "appealed": { "type": "boolean" },
    "appeal_outcome": { "type": "string" },
    "sensitivity_id": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "complied", "expired", "appealing", "overturned"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "imposing_body", "penalty_type", "imposed_date"],
  "_phase1_todo": [
    "Define penalty register by professional body",
    "Define penalty impact on licences",
    "Define rehabilitation of offenders intersection",
    "Define penalty disclosure requirements"
  ]
}
