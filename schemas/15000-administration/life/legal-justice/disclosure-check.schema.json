{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Disclosure Check",
  "description": "A DBS or equivalent disclosure and barring check — basic, standard, or enhanced certificate with barred list status.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^disclosure_check_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "check_type": { "type": "string", "enum": ["dbs_basic", "dbs_standard", "dbs_enhanced", "dbs_enhanced_with_barred_list", "acpo_check", "overseas_check", "ds_check_scotland"] },
    "certificate_number": { "type": "string" },
    "issued_date": { "type": "string", "format": "date" },
    "requested_by_organisation": { "type": "string" },
    "requested_for_role": { "type": "string" },
    "workforce": { "type": "string", "enum": ["child", "adult", "both", "other"] },
    "content": { "type": "string", "enum": ["clear", "information_disclosed"], "description": "Whether certificate is clear or contains information" },
    "on_barred_list": { "type": "boolean" },
    "update_service_enrolled": { "type": "boolean" },
    "update_service_status": { "type": "string", "enum": ["current", "changes_since_issue", "not_enrolled"] },
    "document_id": { "type": "string" },
    "sensitivity_level": { "type": "string", "const": "highly_restricted" },
    "sensitivity_id": { "type": "string" },
    "access_control_id": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "check_type", "issued_date", "requested_by_organisation"],
  "_phase1_todo": [
    "Define DBS Update Service integration",
    "Define portability of DBS certificate",
    "Define overseas check requirements matrix",
    "Define re-check trigger rules by sector"
  ]
}
