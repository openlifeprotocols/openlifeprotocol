{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Legal Representative",
  "description": "A legal representative acting on behalf of a person — solicitor, barrister, legal executive, or lay representative. Extends legal/legal-representative.schema.json with legal matter context.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^legal_rep_matter_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "legal_matter_id": { "type": "string" },
    "person_id": { "type": "string", "description": "Person being represented" },
    "representative_actor_id": { "type": "string" },
    "representative_type": { "type": "string", "enum": ["solicitor", "barrister", "legal_executive", "licensed_conveyancer", "costs_lawyer", "mckenzie_friend", "lay_representative", "pro_bono", "duty_solicitor"] },
    "firm_name": { "type": "string" },
    "sra_number": { "type": "string" },
    "instructed_date": { "type": "string", "format": "date" },
    "terminated_date": { "type": "string", "format": "date" },
    "termination_reason": { "type": "string", "enum": ["matter_concluded", "client_changed_solicitor", "conflict_of_interest", "non_payment", "breakdown_of_trust", "other"] },
    "legal_aid": { "type": "boolean" },
    "legal_aid_certificate_id": { "type": "string" },
    "funding_arrangement": { "type": "string", "enum": ["private_pay", "legal_aid", "conditional_fee", "damages_based", "insurance_backed", "pro_bono"] },
    "hourly_rate": { "type": "number" },
    "currency": { "type": "string" },
    "retainer_amount": { "type": "number" },
    "loa_document_id": { "type": "string", "description": "Letter of authority / retainer document" },
    "status": { "type": "string", "enum": ["instructed", "active", "terminated"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "legal_matter_id", "person_id", "representative_type"],
  "_phase1_todo": [
    "Define conflict of interest check",
    "Define legal aid means test",
    "Define CFA/DBA success fee calculation",
    "Define solicitor-client privilege scope"
  ]
}
