{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Settlement",
  "description": "A settlement agreement resolving a dispute or claim — terms, payments, and confidentiality obligations.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^settlement_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "legal_matter_id": { "type": "string" },
    "dispute_id": { "type": "string" },
    "claim_id": { "type": "string" },
    "settlement_type": { "type": "string", "enum": ["full_and_final", "part_settlement", "consent_order", "tomlin_order", "acas_cot3", "mediated", "negotiated"] },
    "parties": { "type": "array", "items": { "type": "string" } },
    "settlement_amount": { "type": "number" },
    "costs_payment": { "type": "number" },
    "currency": { "type": "string" },
    "payment_terms": { "type": "string" },
    "payment_date": { "type": "string", "format": "date" },
    "non_admission_of_liability": { "type": "boolean" },
    "confidentiality_clause": { "type": "boolean" },
    "non_disparagement": { "type": "boolean" },
    "other_terms": { "type": "array", "items": { "type": "string" } },
    "signed_date": { "type": "string", "format": "date" },
    "court_approved": { "type": "boolean" },
    "document_id": { "type": "string" },
    "sensitivity_id": { "type": "string" },
    "status": { "type": "string", "enum": ["negotiating", "agreed", "signed", "payment_pending", "completed", "breached"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "legal_matter_id", "settlement_type", "parties"],
  "_phase1_todo": [
    "Define Tomlin Order stay mechanics",
    "Define settlement payment instalment tracking",
    "Define breach of settlement workflow",
    "Define tax treatment of settlement amounts"
  ]
}
