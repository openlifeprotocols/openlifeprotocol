{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Birth Certificate",
  "description": "Birth certificate vital record.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^birth_certificate_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "certificate_number": { "type": "string" },
    "issuance_date": { "type": "string", "format": "date" },
    "issuance_country": { "type": "string" },
    "issuance_state_or_province": { "type": "string" },
    "issuance_city": { "type": "string" },
    "date_of_birth": { "type": "string", "format": "date" },
    "registered_name": { "type": "string" },
    "birth_order": { "type": "integer" },
    "father_name": { "type": "string" },
    "mother_name": { "type": "string" },
    "mother_maiden_name": { "type": "string" },
    "place_of_birth": { "type": "string" },
    "attending_physician": { "type": "string" },
    "certified_copy": { "type": "boolean" },
    "certified_by": { "type": "string" },
    "document_id": { "type": "string" },
    "verification_status": { "type": "string", "enum": ["not_verified", "pending", "verified"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define birth certificate verification", "Define genealogical linking", "Define amendment tracking"]
}
