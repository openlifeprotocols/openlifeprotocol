{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Passport",
  "description": "Passport document details.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^passport_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "passport_number": { "type": "string" },
    "issuance_country": { "type": "string" },
    "issuance_date": { "type": "string", "format": "date" },
    "expiration_date": { "type": "string", "format": "date" },
    "is_expired": { "type": "boolean" },
    "issuing_authority": { "type": "string" },
    "issuing_city": { "type": "string" },
    "passport_type": { "type": "string", "enum": ["ordinary", "official", "diplomatic", "temporary", "emergency"] },
    "mrz_line_one": { "type": "string" },
    "mrz_line_two": { "type": "string" },
    "visa_pages": { "type": "integer" },
    "visa_expires": { "type": "string", "format": "date" },
    "document_id": { "type": "string" },
    "document_url": { "type": "string", "format": "uri" },
    "renewal_eligible_date": { "type": "string", "format": "date" },
    "lost_or_stolen": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define passport verification", "Define visa tracking", "Define renewal scheduling"]
}
