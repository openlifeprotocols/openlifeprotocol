{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Name Change",
  "description": "Legal name change record.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^name_change_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "previous_name": { "type": "string" },
    "new_name": { "type": "string" },
    "name_change_type": { "type": "string", "enum": ["marriage", "divorce", "court_order", "deed_poll", "religious", "personal_choice", "correction", "other"] },
    "change_date": { "type": "string", "format": "date" },
    "jurisdiction": { "type": "string" },
    "document_id": { "type": "string" },
    "decree_number": { "type": "string" },
    "effective_date": { "type": "string", "format": "date" },
    "registration_number": { "type": "string" },
    "is_legally_binding": { "type": "boolean" },
    "documents_updated": { "type": "array", "items": { "type": "string", "enum": ["passport", "drivers_license", "birth_certificate", "ssn", "bank_accounts", "employer_records"] } },
    "pending_updates": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define name change validation", "Define document update tracking", "Define legal binding verification"]
}
