{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Warranty Claim",
  "description": "Warranty claim submission and tracking.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^warranty_claim_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "warranty_id": { "type": "string" },
    "product_name": { "type": "string" },
    "manufacturer": { "type": "string" },
    "serial_number": { "type": "string" },
    "product_purchase_date": { "type": "string", "format": "date" },
    "warranty_coverage_end_date": { "type": "string", "format": "date" },
    "claim_date": { "type": "string", "format": "date" },
    "defect_description": { "type": "string" },
    "defect_type": { "type": "string", "enum": ["manufacturing_defect", "damage", "failure", "malfunction", "other"] },
    "claim_number": { "type": "string" },
    "status": { "type": "string", "enum": ["submitted", "under_review", "approved", "denied", "in_repair", "replaced", "resolved"] },
    "repair_or_replacement_option": { "type": "string", "enum": ["repair", "replacement", "refund", "pending"] },
    "claim_documents": { "type": "array", "items": { "type": "string" } },
    "submission_date": { "type": "string", "format": "date" },
    "expected_resolution_date": { "type": "string", "format": "date" },
    "resolution_date": { "type": "string", "format": "date" },
    "contact_person": { "type": "string" },
    "contact_phone": { "type": "string" },
    "service_center_location": { "type": "string" },
    "repair_cost": { "type": "number" },
    "refund_amount": { "type": "number" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "warranty_id"],
  "_phase1_todo": ["Define warranty validity checking", "Define claim automation", "Define resolution tracking"]
}
