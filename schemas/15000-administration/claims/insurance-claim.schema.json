{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Insurance Claim",
  "description": "Insurance claim submission and tracking.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^insurance_claim_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "policy_id": { "type": "string" },
    "insurance_provider": { "type": "string" },
    "claim_type": { "type": "string", "enum": ["auto", "home", "health", "life", "disability", "travel", "pet", "other"] },
    "claim_number": { "type": "string" },
    "claim_date": { "type": "string", "format": "date" },
    "incident_date": { "type": "string", "format": "date" },
    "claim_amount_requested": { "type": "number" },
    "claim_amount_approved": { "type": "number" },
    "claim_amount_denied": { "type": "number" },
    "claim_amount_pending": { "type": "number" },
    "currency": { "type": "string" },
    "status": { "type": "string", "enum": ["submitted", "under_review", "approved", "denied", "partially_approved", "appealed", "resolved"] },
    "denial_reason": { "type": "string" },
    "incident_description": { "type": "string" },
    "claim_documents": { "type": "array", "items": { "type": "string" } },
    "adjuster_name": { "type": "string" },
    "adjuster_contact": { "type": "string" },
    "submission_date": { "type": "string", "format": "date" },
    "expected_resolution_date": { "type": "string", "format": "date" },
    "resolution_date": { "type": "string", "format": "date" },
    "appeal_status": { "type": "string" },
    "payout_method": { "type": "string" },
    "payout_date": { "type": "string", "format": "date" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "policy_id"],
  "_phase1_todo": ["Define claim status tracking", "Define appeal workflow", "Define payout verification"]
}
