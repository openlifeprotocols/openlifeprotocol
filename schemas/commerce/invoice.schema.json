{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Invoice",
  "description": "A demand for payment for goods or services delivered. Triggers Payments and flows into revenue/cost accounting.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^invoice_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "external_ids": {
      "type": "array",
      "items": { "type": "object", "properties": { "system": { "type": "string" }, "id": { "type": "string" } }, "required": ["system", "id"] }
    },
    "invoice_number": { "type": "string" },
    "invoice_type": { "type": "string", "enum": ["standard", "credit_note", "debit_note", "pro_forma", "self_billed", "milestone", "recurring"] },
    "supplier_id": { "type": "string" },
    "customer_id": { "type": "string" },
    "order_id": { "type": "string" },
    "project_id": { "type": "string" },
    "issue_date": { "type": "string", "format": "date" },
    "due_date": { "type": "string", "format": "date" },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "quantity": { "type": "number" },
          "unit_price": { "type": "number" },
          "discount_rate": { "type": "number" },
          "tax_rate": { "type": "number" },
          "subtotal": { "type": "number" },
          "product_id": { "type": "string" },
          "service_id": { "type": "string" }
        },
        "required": ["description", "quantity", "unit_price", "subtotal"]
      }
    },
    "subtotal": { "type": "number" },
    "discount_total": { "type": "number" },
    "tax_total": { "type": "number" },
    "total": { "type": "number" },
    "amount_paid": { "type": "number" },
    "amount_due": { "type": "number" },
    "currency": { "type": "string" },
    "payment_terms": { "type": "string", "examples": ["30 days net", "immediate", "50% upfront"] },
    "payment_ids": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["draft", "sent", "partial", "paid", "overdue", "disputed", "written_off", "cancelled"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "invoice_number", "supplier_id", "customer_id", "issue_date", "total", "currency"],
  "_phase1_todo": [
    "Define e-invoicing compliance (Peppol/EN16931)",
    "Define invoice factoring",
    "Define automatic payment matching",
    "Define VAT invoice legal requirements by jurisdiction"
  ]
}
