{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Subscription",
  "description": "A recurring billing relationship — any regular charge for a product or service. Covers personal subscriptions, SaaS, memberships, and recurring B2B contracts.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^subscription_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "external_ids": {
      "type": "array",
      "items": { "type": "object", "properties": { "system": { "type": "string" }, "id": { "type": "string" } }, "required": ["system", "id"] }
    },
    "subscriber_id": { "type": "string" },
    "provider_id": { "type": "string" },
    "product_id": { "type": "string" },
    "service_id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "subscription_type": {
      "type": "string",
      "enum": ["streaming", "software_saas", "news_media", "gym", "box_delivery", "professional_membership", "insurance", "utility", "gaming", "b2b_contract", "maintenance_contract", "other"]
    },
    "billing": {
      "type": "object",
      "properties": {
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly", "quarterly", "annual", "custom"] },
        "next_billing_date": { "type": "string", "format": "date" },
        "billing_day": { "type": "integer", "description": "Day of month or week" },
        "pro_rata": { "type": "boolean" }
      },
      "required": ["amount", "currency", "frequency"]
    },
    "trial": {
      "type": "object",
      "properties": {
        "is_trial": { "type": "boolean" },
        "trial_end_date": { "type": "string", "format": "date" },
        "trial_amount": { "type": "number" }
      }
    },
    "payment_method_id": { "type": "string" },
    "account_id": { "type": "string" },
    "started_date": { "type": "string", "format": "date" },
    "cancelled_date": { "type": "string", "format": "date" },
    "auto_renew": { "type": "boolean" },
    "notice_period_days": { "type": "integer" },
    "cancellation_difficulty": { "type": "string", "enum": ["easy_online", "email_required", "phone_required", "written_notice", "retention_wall"], "description": "How hard is it to cancel?" },
    "shared_with_ids": { "type": "array", "items": { "type": "string" } },
    "annual_equivalent": { "type": "number" },
    "status": { "type": "string", "enum": ["trial", "active", "paused", "notice_given", "cancelled"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "subscriber_id", "name", "billing"],
  "_phase1_todo": [
    "Define subscription audit/money-saving analysis",
    "Define cancellation workflow",
    "Define subscription inheritance on death",
    "Define family plan seat management"
  ]
}
