{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Financial Statement",
  "description": "Bank or investment account statement.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^financial_statement_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "account_id": { "type": "string" },
    "account_type": { "type": "string", "enum": ["checking", "savings", "investment", "retirement", "credit_card", "loan", "mortgage", "other"] },
    "financial_institution": { "type": "string" },
    "statement_date": { "type": "string", "format": "date" },
    "statement_period_start": { "type": "string", "format": "date" },
    "statement_period_end": { "type": "string", "format": "date" },
    "beginning_balance": { "type": "number" },
    "ending_balance": { "type": "number" },
    "total_deposits": { "type": "number" },
    "total_withdrawals": { "type": "number" },
    "interest_earned": { "type": "number" },
    "fees_charged": { "type": "number" },
    "currency": { "type": "string" },
    "document_id": { "type": "string" },
    "upload_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define transaction extraction", "Define balance tracking", "Define reconciliation"]
}
