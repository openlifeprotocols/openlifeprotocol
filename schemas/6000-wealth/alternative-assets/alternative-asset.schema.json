{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alternative Asset",
  "description": "Non-traditional investment asset — collectibles, commodities, tangible items.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^alternative_asset_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "asset_name": { "type": "string" },
    "asset_type": { "type": "string", "enum": ["precious_metal", "artwork", "collectible", "commodity", "wine", "car", "watch", "other"] },
    "description": { "type": "string" },
    "acquisition_date": { "type": "string", "format": "date" },
    "acquisition_cost": { "type": "number" },
    "current_valuation": { "type": "number" },
    "currency": { "type": "string" },
    "valuation_method": { "type": "string", "enum": ["appraised", "market_comparable", "auction_result", "estimate", "insurance_value"] },
    "appraiser_name": { "type": "string" },
    "last_valuation_date": { "type": "string", "format": "date" },
    "location": { "type": "string" },
    "storage_method": { "type": "string", "enum": ["home", "vault", "museum", "storage_facility"] },
    "insurance_coverage": { "type": "number" },
    "insurance_policy_number": { "type": "string" },
    "liquidity": { "type": "string", "enum": ["very_liquid", "liquid", "illiquid", "very_illiquid"] },
    "annual_appreciation_rate": { "type": "number" },
    "maintenance_cost": { "type": "number" },
    "authentication": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "asset_name", "asset_type"],
  "_phase1_todo": [
    "Define alternative asset portfolio tracking",
    "Define collectible value authentication",
    "Define alternative asset tax reporting"
  ]
}
