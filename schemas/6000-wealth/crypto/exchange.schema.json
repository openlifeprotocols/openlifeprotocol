{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exchange",
  "description": "Cryptocurrency exchange account and provider.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^exchange_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "exchange_name": { "type": "string" },
    "exchange_type": { "type": "string", "enum": ["centralized", "decentralized", "broker", "atm"] },
    "website": { "type": "string", "format": "uri" },
    "account_id": { "type": "string" },
    "account_type": { "type": "string", "enum": ["basic", "verified", "professional", "institutional"] },
    "verification_level": { "type": "string", "enum": ["none", "basic", "intermediate", "full"] },
    "account_created_date": { "type": "string", "format": "date" },
    "fiat_supported": { "type": "array", "items": { "type": "string" } },
    "cryptocurrencies_supported": { "type": "integer" },
    "account_balance": { "type": "number" },
    "trading_fee_percentage": { "type": "number" },
    "withdrawal_fee_percentage": { "type": "number" },
    "deposit_fee_percentage": { "type": "number" },
    "withdrawal_limit": { "type": "number" },
    "daily_withdrawal_limit": { "type": "number" },
    "api_available": { "type": "boolean" },
    "two_factor_enabled": { "type": "boolean" },
    "security_rating": { "type": "string", "enum": ["excellent", "good", "fair", "poor"] },
    "regulatory_status": { "type": "string", "enum": ["regulated", "semi_regulated", "unregulated"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "exchange_name", "exchange_type"],
  "_phase1_todo": [
    "Define exchange fee comparison",
    "Define exchange security audit",
    "Define exchange account migration"
  ]
}
