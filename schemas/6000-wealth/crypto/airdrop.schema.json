{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Airdrop",
  "description": "Cryptocurrency airdrop received.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^airdrop_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "wallet_id": { "type": "string" },
    "coin_symbol": { "type": "string" },
    "coin_name": { "type": "string" },
    "quantity_received": { "type": "number" },
    "airdrop_date": { "type": "string", "format": "date" },
    "value_at_airdrop": { "type": "number" },
    "current_value": { "type": "number" },
    "currency": { "type": "string" },
    "airdrop_reason": { "type": "string", "enum": ["fork", "promotion", "staking_reward", "community_reward", "governance", "other"] },
    "claim_deadline": { "type": "string", "format": "date" },
    "is_claimed": { "type": "boolean" },
    "claim_date": { "type": "string", "format": "date" },
    "claim_process": { "type": "string" },
    "blockchain": { "type": "string" },
    "eligibility_requirement": { "type": "string" },
    "tax_implications": { "type": "string" },
    "unrealized_gain_loss": { "type": "number" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "wallet_id", "coin_symbol", "quantity_received"],
  "_phase1_todo": [
    "Define airdrop claim tracking",
    "Define airdrop tax reporting",
    "Define airdrop value estimation"
  ]
}
