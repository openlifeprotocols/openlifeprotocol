{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Yield",
  "description": "Cryptocurrency yield or passive income from DeFi.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^yield_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "wallet_id": { "type": "string" },
    "cryptocurrency_id": { "type": "string" },
    "yield_type": { "type": "string", "enum": ["staking", "liquidity_mining", "lending", "farming", "interest", "other"] },
    "provider": { "type": "string" },
    "protocol": { "type": "string" },
    "blockchain": { "type": "string" },
    "amount_deposited": { "type": "number" },
    "annual_percentage_rate": { "type": "number" },
    "estimated_annual_yield": { "type": "number" },
    "actual_yield_earned": { "type": "number" },
    "yield_currency": { "type": "string" },
    "start_date": { "type": "string", "format": "date" },
    "last_yield_claim": { "type": "string", "format": "date" },
    "claim_frequency": { "type": "string", "enum": ["daily", "weekly", "monthly", "quarterly", "on_demand"] },
    "auto_compound": { "type": "boolean" },
    "is_active": { "type": "boolean" },
    "risk_level": { "type": "string", "enum": ["very_low", "low", "medium", "high", "very_high"] },
    "impermanent_loss_risk": { "type": "boolean" },
    "smart_contract_audited": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "wallet_id", "cryptocurrency_id", "yield_type"],
  "_phase1_todo": [
    "Define yield farming optimization",
    "Define yield strategy diversification",
    "Define yield risk assessment"
  ]
}
