{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wallet",
  "description": "Cryptocurrency wallet or address holder.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^wallet_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "wallet_name": { "type": "string" },
    "wallet_type": { "type": "string", "enum": ["hardware", "software", "paper", "custodian", "exchange", "defi"] },
    "blockchain": { "type": "string" },
    "wallet_address": { "type": "string" },
    "public_key": { "type": "string" },
    "is_multi_signature": { "type": "boolean" },
    "balance": { "type": "number" },
    "currency": { "type": "string" },
    "created_date": { "type": "string", "format": "date" },
    "last_transaction_date": { "type": "string", "format": "date" },
    "transaction_count": { "type": "integer" },
    "security_level": { "type": "string", "enum": ["offline", "secured", "standard", "vulnerable"] },
    "backed_up": { "type": "boolean" },
    "recovery_phrase_stored": { "type": "boolean" },
    "insurance_available": { "type": "boolean" },
    "is_active": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "wallet_name", "blockchain"],
  "_phase1_todo": [
    "Define wallet security audit",
    "Define portfolio aggregation across wallets",
    "Define wallet backup monitoring"
  ]
}
