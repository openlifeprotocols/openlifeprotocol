{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Travel Insurance",
  "description": "Travel insurance policy coverage.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^travel_insurance_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "insurance_policy_id": { "type": "string" },
    "person_id": { "type": "string" },
    "policy_type": { "type": "string", "enum": ["single_trip", "annual_multi_trip", "backpacker", "adventure", "winter_sports"] },
    "coverage_start_date": { "type": "string", "format": "date" },
    "coverage_end_date": { "type": "string", "format": "date" },
    "destinations_covered": { "type": "array", "items": { "type": "string" } },
    "annual_premium": { "type": "number" },
    "single_trip_premium": { "type": "number" },
    "currency": { "type": "string" },
    "medical_coverage": { "type": "number" },
    "luggage_coverage": { "type": "number" },
    "cancellation_coverage": { "type": "number" },
    "delay_coverage": { "type": "number" },
    "emergency_evacuation": { "type": "boolean" },
    "emergency_evacuation_limit": { "type": "number" },
    "adventure_activities_covered": { "type": "array", "items": { "type": "string" } },
    "age_limit": { "type": "integer" },
    "pre_existing_conditions": { "type": "string" },
    "document_id": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define trip registration", "Define claim submission", "Define emergency assistance"]
}
