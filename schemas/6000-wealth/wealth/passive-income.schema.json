{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Passive Income",
  "description": "Income streams not requiring active work — investments, royalties, rentals.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^passive_income_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "income_stream_name": { "type": "string" },
    "income_type": { "type": "string", "enum": ["dividends", "rental_income", "royalties", "interest", "capital_gains", "affiliate", "subscription", "membership", "sponsorship", "other"] },
    "source_asset_id": { "type": "string" },
    "annual_amount": { "type": "number" },
    "currency": { "type": "string" },
    "payment_frequency": { "type": "string", "enum": ["daily", "weekly", "monthly", "quarterly", "annually"] },
    "is_recurring": { "type": "boolean" },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "underlying_asset_value": { "type": "number" },
    "yield_percentage": { "type": "number" },
    "tax_efficiency": { "type": "string", "enum": ["tax_free", "tax_deferred", "taxable"] },
    "growth_rate": { "type": "number" },
    "risk_level": { "type": "string", "enum": ["very_low", "low", "medium", "high", "very_high"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "income_stream_name", "income_type"],
  "_phase1_todo": [
    "Define passive income optimization",
    "Define passive income growth projections",
    "Define passive income diversification"
  ]
}
