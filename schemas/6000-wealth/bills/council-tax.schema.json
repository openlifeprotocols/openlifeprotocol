{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Council Tax",
  "description": "Council tax or property tax bill.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^council_tax_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "property_address": { "type": "string" },
    "council_name": { "type": "string" },
    "property_band": { "type": "string", "enum": ["A", "B", "C", "D", "E", "F", "G", "H"] },
    "financial_year": { "type": "string" },
    "banding_date": { "type": "string", "format": "date" },
    "annual_charge": { "type": "number" },
    "currency": { "type": "string" },
    "payment_method": { "type": "string", "enum": ["full_payment", "monthly_installment", "quarterly_installment"] },
    "number_of_installments": { "type": "integer" },
    "installment_amount": { "type": "number" },
    "discount_percentage": { "type": "number" },
    "disablement_relief": { "type": "boolean" },
    "student_exemption": { "type": "boolean" },
    "bill_date": { "type": "string", "format": "date" },
    "payment_due_dates": { "type": "array", "items": { "type": "string", "format": "date" } },
    "document_id": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define banding appeals", "Define exemption claims", "Define payment plan tracking"]
}
