{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cost",
  "description": "An incurred cost — expense, spend, or charge in a given period. Flows into P&L and project costing.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^cost_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "entity_id": { "type": "string" },
    "project_id": { "type": "string" },
    "cost_type": {
      "type": "string",
      "enum": ["labour", "materials", "equipment", "subcontractor", "professional_fees", "rent", "utilities", "marketing", "technology", "travel", "depreciation", "interest", "tax", "insurance", "other"]
    },
    "description": { "type": "string" },
    "amount": { "type": "number" },
    "currency": { "type": "string" },
    "period": {
      "type": "object",
      "properties": {
        "from": { "type": "string", "format": "date" },
        "to": { "type": "string", "format": "date" }
      }
    },
    "incurred_date": { "type": "string", "format": "date" },
    "is_fixed": { "type": "boolean", "description": "Fixed vs variable cost" },
    "is_direct": { "type": "boolean", "description": "Direct (COGS) vs indirect (overhead)" },
    "invoice_id": { "type": "string" },
    "supplier_id": { "type": "string" },
    "budget_id": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "entity_id", "cost_type", "amount", "currency", "incurred_date"],
  "_phase1_todo": [
    "Define cost allocation to projects/departments",
    "Define cost capitalisation vs expensing",
    "Define cost approval workflow",
    "Define cost forecasting"
  ]
}
