{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quote",
  "description": "A price quotation for goods or services — the commercial offer before an order is placed.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^quote_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "external_ids": {
      "type": "array",
      "items": { "type": "object", "properties": { "system": { "type": "string" }, "id": { "type": "string" } }, "required": ["system", "id"] }
    },
    "quote_number": { "type": "string" },
    "supplier_id": { "type": "string" },
    "customer_id": { "type": "string" },
    "project_id": { "type": "string" },
    "issued_date": { "type": "string", "format": "date" },
    "valid_until": { "type": "string", "format": "date" },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "quantity": { "type": "number" },
          "unit_price": { "type": "number" },
          "tax_rate": { "type": "number" },
          "subtotal": { "type": "number" },
          "product_id": { "type": "string" },
          "service_id": { "type": "string" },
          "is_optional": { "type": "boolean" }
        }
      }
    },
    "subtotal": { "type": "number" },
    "tax_total": { "type": "number" },
    "total": { "type": "number" },
    "currency": { "type": "string" },
    "notes": { "type": "string" },
    "terms": { "type": "string" },
    "accepted_at": { "type": "string", "format": "date-time" },
    "rejected_at": { "type": "string", "format": "date-time" },
    "converted_to_order_id": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "sent", "accepted", "rejected", "expired", "superseded"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "quote_number", "supplier_id", "customer_id", "issued_date", "total", "currency"],
  "_phase1_todo": [
    "Define quote comparison across suppliers",
    "Define quote-to-order conversion",
    "Define quote versioning",
    "Define quote approval workflow"
  ]
}
