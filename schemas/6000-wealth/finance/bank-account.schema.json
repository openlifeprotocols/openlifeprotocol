{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bank Account",
  "description": "A bank or building society account held by a person or organisation.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^bank_account_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "external_ids": {
      "type": "array",
      "items": { "type": "object", "properties": { "system": { "type": "string" }, "id": { "type": "string" } }, "required": ["system", "id"] }
    },
    "holder_ids": { "type": "array", "items": { "type": "string" } },
    "institution_id": { "type": "string" },
    "account_type": { "type": "string", "enum": ["current", "savings", "isa", "fixed_term", "joint", "business", "premium_bonds", "trust"] },
    "sort_code": { "type": "string" },
    "account_number": { "type": "string" },
    "iban": { "type": "string" },
    "bic": { "type": "string" },
    "currency": { "type": "string" },
    "balance": { "type": "number" },
    "balance_date": { "type": "string", "format": "date" },
    "interest_rate": { "type": "number" },
    "overdraft_limit": { "type": "number" },
    "opened_date": { "type": "string", "format": "date" },
    "closed_date": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["active", "dormant", "frozen", "closed"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "holder_ids", "institution_id", "account_type", "currency"],
  "_phase1_todo": [
    "Define account closure workflow",
    "Define deceased account handling",
    "Define account switching procedures",
    "Define dormant account reactivation"
  ]
}
