{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tax",
  "description": "A tax record — self-assessment, corporation tax, VAT, inheritance tax, or other tax obligation.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^tax_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "external_ids": {
      "type": "array",
      "items": { "type": "object", "properties": { "system": { "type": "string" }, "id": { "type": "string" } }, "required": ["system", "id"] }
    },
    "taxpayer_id": { "type": "string" },
    "tax_type": { "type": "string", "enum": ["income_tax", "capital_gains", "inheritance_tax", "corporation_tax", "vat", "council_tax", "stamp_duty", "national_insurance", "customs_duty", "other"] },
    "tax_year": { "type": "string", "description": "e.g., '2024-25'" },
    "jurisdiction_id": { "type": "string" },
    "reference": { "type": "string", "description": "e.g., UTR, NI number" },
    "income_total": { "type": "number" },
    "tax_due": { "type": "number" },
    "tax_paid": { "type": "number" },
    "tax_owed": { "type": "number" },
    "tax_refund": { "type": "number" },
    "currency": { "type": "string" },
    "filing_deadline": { "type": "string", "format": "date" },
    "filed_date": { "type": "string", "format": "date" },
    "payment_deadline": { "type": "string", "format": "date" },
    "paid_date": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["not_filed", "filed", "amended", "paid", "overdue", "under_investigation"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "taxpayer_id", "tax_type", "tax_year"],
  "_phase1_todo": [
    "Define self-assessment calculation",
    "Define HMRC MTD integration",
    "Define tax penalty regime",
    "Define tax investigation procedures"
  ]
}
