{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dividend Income",
  "description": "Dividend or distribution payment received.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^dividend_income_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "holding_id": { "type": "string" },
    "investment_account_id": { "type": "string" },
    "security_id": { "type": "string" },
    "dividend_type": { "type": "string", "enum": ["cash_dividend", "stock_dividend", "capital_gain_distribution", "return_of_capital", "interest_payment"] },
    "payment_date": { "type": "string", "format": "date" },
    "record_date": { "type": "string", "format": "date" },
    "ex_dividend_date": { "type": "string", "format": "date" },
    "amount_per_share": { "type": "number" },
    "quantity_shares": { "type": "number" },
    "total_amount": { "type": "number" },
    "currency": { "type": "string" },
    "tax_withheld": { "type": "number" },
    "net_amount": { "type": "number" },
    "reinvested": { "type": "boolean" },
    "reinvestment_shares": { "type": "number" },
    "reinvestment_price": { "type": "number" },
    "tax_treatment": { "type": "string", "enum": ["ordinary_income", "qualified_dividend", "tax_free", "tax_deferred"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "holding_id", "investment_account_id", "total_amount"],
  "_phase1_todo": [
    "Define dividend income forecasting",
    "Define dividend tax optimization",
    "Define DRIP performance analysis"
  ]
}
