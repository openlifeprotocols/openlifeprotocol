{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stock",
  "description": "Individual stock security metadata.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^stock_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "ticker_symbol": { "type": "string" },
    "company_name": { "type": "string" },
    "sector": { "type": "string" },
    "industry": { "type": "string" },
    "market_cap": { "type": "number" },
    "current_price": { "type": "number" },
    "currency": { "type": "string" },
    "dividend_per_share": { "type": "number" },
    "dividend_yield": { "type": "number" },
    "dividend_frequency": { "type": "string", "enum": ["monthly", "quarterly", "annually", "irregular", "none"] },
    "pe_ratio": { "type": "number" },
    "earnings_per_share": { "type": "number" },
    "price_to_book": { "type": "number" },
    "return_on_equity": { "type": "number" },
    "debt_to_equity": { "type": "number" },
    "fifty_two_week_high": { "type": "number" },
    "fifty_two_week_low": { "type": "number" },
    "average_volume": { "type": "integer" },
    "exchange": { "type": "string" },
    "last_updated": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "ticker_symbol", "company_name"],
  "_phase1_todo": [
    "Define stock valuation analysis",
    "Define stock performance metrics",
    "Define stock correlation with portfolio"
  ]
}
