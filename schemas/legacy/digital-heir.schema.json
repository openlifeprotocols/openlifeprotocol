{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Digital Heir",
  "description": "Digital legacy designee or digital heir.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^digital_heir_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "heir_name": { "type": "string" },
    "heir_email": { "type": "string", "format": "email" },
    "heir_phone": { "type": "string" },
    "heir_relationship": { "type": "string" },
    "appointment_date": { "type": "string", "format": "date" },
    "responsibilities": { "type": "array", "items": { "type": "string" } },
    "account_access_permissions": { "type": "object", "properties": { "email": { "type": "boolean" }, "social_media": { "type": "boolean" }, "cloud_storage": { "type": "boolean" }, "financial": { "type": "boolean" }, "medical": { "type": "boolean" }, "photos_and_memories": { "type": "boolean" } } },
    "memorial_pages_to_manage": { "type": "array", "items": { "type": "string" } },
    "account_closure_preferences": { "type": "array", "items": { "type": "string" } },
    "data_to_delete": { "type": "array", "items": { "type": "string" } },
    "data_to_preserve": { "type": "array", "items": { "type": "string" } },
    "contact_list_to_notify": { "type": "array", "items": { "type": "string" } },
    "special_instructions": { "type": "string" },
    "heir_contact_preferences": { "type": "array", "items": { "type": "string" } },
    "successor_heir": { "type": "string" },
    "compensation_or_gift": { "type": "string" },
    "heir_acknowledgment": { "type": "boolean" },
    "acknowledgment_date": { "type": "string", "format": "date" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "heir_name"],
  "_phase1_todo": ["Define access management", "Define account linking", "Define notification workflows"]
}
