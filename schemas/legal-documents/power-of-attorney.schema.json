{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Power of Attorney",
  "description": "Power of attorney document.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^power_of_attorney_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "principal_person_id": { "type": "string" },
    "poa_type": { "type": "string", "enum": ["general", "limited", "durable", "springing", "healthcare", "financial"] },
    "agent_person_id": { "type": "string" },
    "successor_agents": { "type": "array", "items": { "type": "string" } },
    "powers_granted": { "type": "array", "items": { "type": "string" } },
    "restrictions": { "type": "array", "items": { "type": "string" } },
    "effective_date": { "type": "string", "format": "date" },
    "expiration_date": { "type": "string", "format": "date" },
    "is_durable": { "type": "boolean" },
    "is_springing": { "type": "boolean" },
    "springing_event": { "type": "string" },
    "document_id": { "type": "string" },
    "execution_date": { "type": "string", "format": "date" },
    "is_notarized": { "type": "boolean" },
    "notary_name": { "type": "string" },
    "notarization_date": { "type": "string", "format": "date" },
    "is_recorded": { "type": "boolean" },
    "recording_county": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "suspended", "revoked", "expired"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "principal_person_id"],
  "_phase1_todo": ["Define POA validation", "Define revocation procedures", "Define agent access control"]
}
