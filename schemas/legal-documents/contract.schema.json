{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contract",
  "description": "Legal contract or agreement.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^contract_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "contract_name": { "type": "string" },
    "contract_type": { "type": "string", "enum": ["employment", "service", "purchase", "lease", "partnership", "nda", "license", "vendor", "other"] },
    "party_one_id": { "type": "string" },
    "party_two_id": { "type": "string" },
    "other_parties": { "type": "array", "items": { "type": "string" } },
    "contract_value": { "type": "number" },
    "currency": { "type": "string" },
    "execution_date": { "type": "string", "format": "date" },
    "effective_date": { "type": "string", "format": "date" },
    "expiration_date": { "type": "string", "format": "date" },
    "renewal_terms": { "type": "string" },
    "termination_clause": { "type": "string" },
    "key_obligations": { "type": "array", "items": { "type": "string" } },
    "payment_terms": { "type": "string" },
    "dispute_resolution": { "type": "string", "enum": ["negotiation", "mediation", "arbitration", "litigation"] },
    "governing_law": { "type": "string" },
    "document_id": { "type": "string" },
    "is_signed": { "type": "boolean" },
    "signature_date": { "type": "string", "format": "date" },
    "is_notarized": { "type": "boolean" },
    "status": { "type": "string", "enum": ["draft", "pending_signature", "active", "fulfilled", "terminated", "archived"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "party_one_id"],
  "_phase1_todo": ["Define contract lifecycle", "Define renewal alerts", "Define obligation tracking"]
}
