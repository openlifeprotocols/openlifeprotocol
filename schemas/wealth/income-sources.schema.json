{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Income Sources",
  "description": "Catalog of all ways a person generates income.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^income_sources_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "income_type": { "type": "string", "enum": ["employment", "self_employment", "business_ownership", "investments", "passive_income", "royalties", "rentals", "pensions", "inheritance", "other"] },
    "source_name": { "type": "string" },
    "description": { "type": "string" },
    "annual_amount": { "type": "number" },
    "currency": { "type": "string" },
    "is_active": { "type": "boolean" },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly", "quarterly", "annually", "irregular", "one_time"] },
    "tax_treatment": { "type": "string", "enum": ["earned_income", "investment_income", "passive_income", "capital_gains", "other"] },
    "stability": { "type": "string", "enum": ["very_stable", "stable", "variable", "highly_variable"] },
    "growth_rate": { "type": "number" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "income_type", "source_name"],
  "_phase1_todo": [
    "Define income diversification scoring",
    "Define income growth forecasting",
    "Define income stability analysis"
  ]
}
