{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contact Point",
  "description": "Contact information (email, phone, social, etc.) for reaching an actor or institution. Supports multiple contact methods and preferences.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^contact_[a-zA-Z0-9_-]+$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "external_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "system": { "type": "string" },
          "id": { "type": "string" },
          "type": { "type": "string" }
        },
        "required": ["system", "id"]
      }
    },
    "actor_id": { "type": "string" },
    "contact_type": {
      "type": "string",
      "enum": ["email", "phone", "mobile", "fax", "address", "website", "social_media", "messenger", "other"],
      "description": "Type of contact"
    },
    "value": {
      "type": "string",
      "description": "The actual contact information"
    },
    "label": {
      "type": "string",
      "description": "Optional label (e.g., 'work', 'personal', 'mobile')"
    },
    "verified": {
      "type": "boolean",
      "description": "Whether this contact has been verified"
    },
    "verified_date": {
      "type": "string",
      "format": "date-time"
    },
    "preferred": {
      "type": "boolean",
      "description": "Whether this is the preferred contact method"
    },
    "notification_enabled": {
      "type": "boolean",
      "description": "Whether notifications can be sent to this contact"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["id", "uuid", "actor_id", "contact_type", "value"],
  "_phase1_todo": [
    "Define contact verification methods",
    "Define opt-in/opt-out preferences",
    "Define do-not-contact lists",
    "Define communication consent tracking",
    "Define contact data retention",
    "Define privacy regulations compliance (GDPR, etc.)"
  ]
}
