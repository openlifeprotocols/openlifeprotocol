{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scan Import",
  "description": "Scanned documents import.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^scan_import_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "scanner_device": { "type": "string" },
    "scan_date": { "type": "string", "format": "date-time" },
    "page_count": { "type": "integer" },
    "scan_quality": { "type": "string", "enum": ["high", "medium", "low"] },
    "color_mode": { "type": "string", "enum": ["black_white", "grayscale", "color"] },
    "resolution_dpi": { "type": "integer" },
    "file_format": { "type": "string", "enum": ["pdf", "jpg", "png", "tiff"] },
    "file_size_bytes": { "type": "integer" },
    "ocr_enabled": { "type": "boolean" },
    "ocr_language": { "type": "string" },
    "document_id": { "type": "string" },
    "import_status": { "type": "string", "enum": ["pending", "processing", "completed", "failed"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define batch scanning", "Define quality enhancement", "Define OCR optimization"]
}
