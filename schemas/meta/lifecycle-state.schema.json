{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lifecycle State",
  "description": "Lifecycle state definition for entities.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^lifecycle_state_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "entity_type": { "type": "string" },
    "state_name": { "type": "string" },
    "state_code": { "type": "string" },
    "description": { "type": "string" },
    "is_initial_state": { "type": "boolean" },
    "is_final_state": { "type": "boolean" },
    "is_error_state": { "type": "boolean" },
    "allowed_transitions": { "type": "array", "items": { "type": "object", "properties": { "to_state": { "type": "string" }, "trigger": { "type": "string" }, "conditions": { "type": "array" } } } },
    "entry_actions": { "type": "array", "items": { "type": "string" } },
    "exit_actions": { "type": "array", "items": { "type": "string" } },
    "properties_available": { "type": "array", "items": { "type": "string" } },
    "properties_immutable": { "type": "array", "items": { "type": "string" } },
    "retention_period": { "type": "string" },
    "audit_required": { "type": "boolean" },
    "notification_on_entry": { "type": "boolean" },
    "notification_on_exit": { "type": "boolean" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "entity_type", "state_name"],
  "_phase1_todo": ["Define state machine", "Define transition validation", "Define state audit trail"]
}
