{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Category",
  "description": "Hierarchical category for organizing entities.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^category_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "category_name": { "type": "string" },
    "category_slug": { "type": "string" },
    "description": { "type": "string" },
    "parent_category_id": { "type": "string" },
    "category_level": { "type": "integer" },
    "icon": { "type": "string" },
    "color": { "type": "string" },
    "applicable_entity_types": { "type": "array", "items": { "type": "string" } },
    "is_active": { "type": "boolean" },
    "display_order": { "type": "integer" },
    "item_count": { "type": "integer" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "category_name"],
  "_phase1_todo": ["Define category inheritance", "Define multi-categorization", "Define category analytics"]
}
