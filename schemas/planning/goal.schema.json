{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goal",
  "description": "Goal aligned with area of focus.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^goal_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "area_of_focus_id": { "type": "string" },
    "goal_title": { "type": "string" },
    "goal_description": { "type": "string" },
    "goal_type": { "type": "string", "enum": ["outcome", "behavioral", "learning", "health", "financial", "relational", "creative"] },
    "timeframe": { "type": "string", "enum": ["short_term", "medium_term", "long_term"] },
    "target_date": { "type": "string", "format": "date" },
    "goal_status": { "type": "string", "enum": ["not_started", "in_progress", "paused", "achieved", "abandoned"] },
    "priority_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "measurable_outcomes": { "type": "array", "items": { "type": "string" } },
    "success_metrics": { "type": "array", "items": { "type": "string" } },
    "current_progress": { "type": "number" },
    "obstacles": { "type": "array", "items": { "type": "string" } },
    "supporting_projects": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define goal setting framework", "Define goal tracking", "Define goal review cycles"]
}
