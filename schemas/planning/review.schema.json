{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review",
  "description": "Periodic review of goals, projects, areas.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^review_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "review_type": { "type": "string", "enum": ["weekly", "monthly", "quarterly", "annual", "project_retrospective", "goal_review"] },
    "review_date": { "type": "string", "format": "date" },
    "review_period_start": { "type": "string", "format": "date" },
    "review_period_end": { "type": "string", "format": "date" },
    "areas_reviewed": { "type": "array", "items": { "type": "string" } },
    "goals_progress": { "type": "object", "additionalProperties": { "type": "number" } },
    "projects_status": { "type": "object", "additionalProperties": { "type": "string" } },
    "wins": { "type": "array", "items": { "type": "string" } },
    "challenges": { "type": "array", "items": { "type": "string" } },
    "learnings": { "type": "array", "items": { "type": "string" } },
    "adjustments_made": { "type": "array", "items": { "type": "string" } },
    "next_priorities": { "type": "array", "items": { "type": "string" } },
    "next_review_date": { "type": "string", "format": "date" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define review templates", "Define review insights", "Define trend analysis"]
}
