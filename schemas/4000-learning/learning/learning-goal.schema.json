{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Learning Goal",
  "description": "A learning goal — skill to acquire, topic to master, competency to develop within timeframe.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^learning_goal_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "goal_statement": { "type": "string" },
    "description": { "type": "string" },
    "skill_to_acquire": { "type": "string" },
    "competency_to_develop": { "type": "string" },
    "target_proficiency_level": { "type": "string", "enum": ["novice", "beginner", "intermediate", "advanced", "expert"] },
    "motivation": { "type": "string" },
    "set_date": { "type": "string", "format": "date" },
    "target_completion_date": { "type": "string", "format": "date" },
    "actual_completion_date": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["not_started", "in_progress", "completed", "paused", "abandoned"] },
    "progress_percentage": { "type": "number", "minimum": 0, "maximum": 100 },
    "success_criteria": { "type": "array", "items": { "type": "string" } },
    "planned_learning_activities": { "type": "array", "items": { "type": "string" } },
    "completed_learning_records": { "type": "array", "items": { "type": "string" } },
    "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "aligned_with_goals": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "goal_statement"],
  "_phase1_todo": [
    "Define learning goal achievement tracking",
    "Define milestone tracking within goals",
    "Define goal dependency and sequencing"
  ]
}
