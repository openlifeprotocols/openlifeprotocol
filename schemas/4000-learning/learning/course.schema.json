{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Course",
  "description": "A structured learning course — online or offline, with modules, duration, cost.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^course_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "provider": { "type": "string" },
    "provider_course_id": { "type": "string" },
    "subject_area": { "type": "string" },
    "difficulty_level": { "type": "string", "enum": ["beginner", "intermediate", "advanced", "expert"] },
    "duration_hours": { "type": "number" },
    "format": { "type": "string", "enum": ["online_self_paced", "online_instructor_led", "in_person", "hybrid", "correspondence", "bootcamp"] },
    "cost": { "type": "number" },
    "currency": { "type": "string" },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "url": { "type": "string", "format": "uri" },
    "modules": { "type": "array", "items": { "type": "string" } },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "instructor": { "type": "string" },
    "rating": { "type": "number", "minimum": 0, "maximum": 5 },
    "skills_taught": { "type": "array", "items": { "type": "string" } },
    "language": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "title", "provider"],
  "_phase1_todo": [
    "Define course catalog federation",
    "Define competency framework mapping",
    "Define course recommendation engine"
  ]
}
