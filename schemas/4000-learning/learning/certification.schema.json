{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Certification",
  "description": "A professional or academic certification — credential, issuer, expiry, renewal requirements.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^certification_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "name": { "type": "string" },
    "issuing_body": { "type": "string" },
    "credential_id": { "type": "string" },
    "issue_date": { "type": "string", "format": "date" },
    "expiry_date": { "type": "string", "format": "date" },
    "is_active": { "type": "boolean" },
    "renewal_required": { "type": "boolean" },
    "renewal_frequency_months": { "type": "integer" },
    "verification_url": { "type": "string", "format": "uri" },
    "document_url": { "type": "string", "format": "uri" },
    "certification_type": { "type": "string", "enum": ["professional", "academic", "industry", "government", "vendor", "hobby"] },
    "category": { "type": "string" },
    "skills_certified": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["active", "expired", "suspended", "revoked"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "name", "issuing_body", "issue_date"],
  "_phase1_todo": [
    "Define certification renewal alerts",
    "Define credential verification integration",
    "Define reciprocity tracking across jurisdictions"
  ]
}
