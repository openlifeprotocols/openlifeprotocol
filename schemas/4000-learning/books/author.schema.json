{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Author",
  "description": "Book author or writer.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^author_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "author_name": { "type": "string" },
    "pen_name": { "type": "string" },
    "biography": { "type": "string" },
    "birth_year": { "type": "integer" },
    "death_year": { "type": "integer" },
    "nationality": { "type": "string" },
    "primary_genre": { "type": "string" },
    "genres": { "type": "array", "items": { "type": "string" } },
    "goodreads_id": { "type": "string" },
    "website": { "type": "string", "format": "uri" },
    "twitter_handle": { "type": "string" },
    "instagram_handle": { "type": "string" },
    "books_authored": { "type": "integer" },
    "notable_works": { "type": "array", "items": { "type": "string" } },
    "awards_received": { "type": "array", "items": { "type": "string" } },
    "user_rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "favorite": { "type": "boolean" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "author_name"],
  "_phase1_todo": ["Define bibliography", "Define reading history", "Define recommendation system"]
}
