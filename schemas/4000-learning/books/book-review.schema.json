{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Book Review",
  "description": "Review and critique of a book.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^book_review_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "book_id": { "type": "string" },
    "book_title": { "type": "string" },
    "author_name": { "type": "string" },
    "review_date": { "type": "string", "format": "date" },
    "rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "review_text": { "type": "string" },
    "spoiler_warning": { "type": "boolean" },
    "pros": { "type": "array", "items": { "type": "string" } },
    "cons": { "type": "array", "items": { "type": "string" } },
    "would_recommend": { "type": "boolean" },
    "reread_value": { "type": "string", "enum": ["low", "medium", "high"] },
    "character_rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "plot_rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "writing_style_rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "world_building_rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "favorite_characters": { "type": "array", "items": { "type": "string" } },
    "is_published": { "type": "boolean" },
    "publication_url": { "type": "string", "format": "uri" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "book_title"],
  "_phase1_todo": ["Define review publishing", "Define community ratings", "Define recommendation engine"]
}
