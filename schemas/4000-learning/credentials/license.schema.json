{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "License",
  "description": "Professional license or permit.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^license_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "license_type": { "type": "string", "enum": ["professional", "occupational", "driver", "pilot", "maritime", "firearm", "other"] },
    "license_name": { "type": "string" },
    "issuing_authority": { "type": "string" },
    "issuing_jurisdiction": { "type": "string" },
    "license_number": { "type": "string" },
    "class_or_type": { "type": "string" },
    "issue_date": { "type": "string", "format": "date" },
    "expiration_date": { "type": "string", "format": "date" },
    "is_active": { "type": "boolean" },
    "restrictions": { "type": "array", "items": { "type": "string" } },
    "endorsements": { "type": "array", "items": { "type": "string" } },
    "renewal_required": { "type": "boolean" },
    "renewal_frequency_months": { "type": "integer" },
    "document_id": { "type": "string" },
    "verification_url": { "type": "string", "format": "uri" },
    "cost": { "type": "number" },
    "renewal_cost": { "type": "number" },
    "continuing_education_required": { "type": "boolean" },
    "renewal_alert_sent": { "type": "boolean" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "license_type"],
  "_phase1_todo": ["Define renewal tracking", "Define continuing education tracking", "Define compliance verification"]
}
