{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Certificate",
  "description": "Educational certificate or professional credential.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^certificate_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "certificate_name": { "type": "string" },
    "issuing_organization": { "type": "string" },
    "certificate_type": { "type": "string", "enum": ["degree", "diploma", "certificate", "professional_credential", "license", "badge", "other"] },
    "issue_date": { "type": "string", "format": "date" },
    "expiration_date": { "type": "string", "format": "date" },
    "is_active": { "type": "boolean" },
    "credential_id": { "type": "string" },
    "verification_url": { "type": "string", "format": "uri" },
    "document_id": { "type": "string" },
    "field_of_study": { "type": "string" },
    "grade_or_score": { "type": "string" },
    "skills_demonstrated": { "type": "array", "items": { "type": "string" } },
    "verified": { "type": "boolean" },
    "verification_status": { "type": "string", "enum": ["not_verified", "pending", "verified", "expired"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "certificate_name"],
  "_phase1_todo": ["Define credential verification", "Define skills extraction", "Define certificate renewal tracking"]
}
