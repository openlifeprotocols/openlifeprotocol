{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Education History",
  "description": "Record of educational institution attended.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^education_history_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "institution_name": { "type": "string" },
    "institution_type": { "type": "string", "enum": ["primary_school", "secondary_school", "sixth_form", "university", "college", "vocational", "bootcamp", "online_course", "other"] },
    "country": { "type": "string" },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "field_of_study": { "type": "string" },
    "degree_or_qualification": { "type": "string" },
    "grade_or_score": { "type": "string" },
    "gpa": { "type": "number" },
    "honours_or_distinction": { "type": "string" },
    "transcript_document_id": { "type": "string" },
    "certificate_document_id": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "institution_name"],
  "_phase1_todo": ["Define education verification", "Define transcript extraction", "Define education credentials validation"]
}
