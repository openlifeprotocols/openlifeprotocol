{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile",
  "description": "A social media profile — public profile information, bio, settings, customizations.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^profile_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "social_account_id": { "type": "string" },
    "display_name": { "type": "string" },
    "profile_picture_url": { "type": "string", "format": "uri" },
    "banner_image_url": { "type": "string", "format": "uri" },
    "bio": { "type": "string" },
    "location": { "type": "string" },
    "website_url": { "type": "string", "format": "uri" },
    "pronouns": { "type": "string" },
    "verified": { "type": "boolean" },
    "profile_color_theme": { "type": "string" },
    "interests_listed": { "type": "array", "items": { "type": "string" } },
    "education_history": { "type": "array", "items": { "type": "string" } },
    "work_history": { "type": "array", "items": { "type": "string" } },
    "profile_views": { "type": "integer" },
    "last_profile_update": { "type": "string", "format": "date" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "social_account_id"],
  "_phase1_todo": [
    "Define profile consistency across platforms",
    "Define profile optimization scoring",
    "Define profile-to-audience alignment"
  ]
}
