{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provenance",
  "description": "Complete lineage and history of how data or decisions were created, modified, and used.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^provenance_[a-zA-Z0-9_-]+$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "entity_id": {
      "type": "string",
      "description": "Entity this provenance tracks"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "description": "Sources used to create this entity",
      "items": {
        "type": "object",
        "properties": {
          "source_type": { "type": "string" },
          "source_id": { "type": "string" },
          "truth_tier": {
            "type": "string",
            "enum": ["authoritative", "verified", "claimed", "derived", "generated"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "primary_truth_tier": {
      "type": "string",
      "enum": ["authoritative", "verified", "claimed", "derived", "generated"],
      "description": "Best available source tier for current record state."
    },
    "overall_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Composite confidence score after reconciliation."
    },
    "modifications": {
      "type": "array",
      "description": "History of modifications",
      "items": {
        "type": "object",
        "properties": {
          "modified_at": { "type": "string", "format": "date-time" },
          "modified_by": { "type": "string" },
          "changes": { "type": "object" }
        }
      }
    },
    "used_by": {
      "type": "array",
      "description": "Entities or decisions that use this data",
      "items": { "type": "string" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["id", "uuid", "entity_id", "primary_truth_tier"],
  "_phase1_todo": [
    "Define provenance chain validation",
    "Define provenance data retention",
    "Define provenance graph queries",
    "Define provenance immutability guarantees"
  ]
}
