{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Temporal Context",
  "description": "Standard temporal dimensions for facts, events, and state assertions.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^temporal_context_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "entity_id": { "type": "string" },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_to": { "type": "string", "format": "date-time" },
    "effective_at": { "type": "string", "format": "date-time" },
    "observed_at": { "type": "string", "format": "date-time" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "timezone": { "type": "string" },
    "precision": {
      "type": "string",
      "enum": ["year", "month", "day", "hour", "minute", "second", "unknown"]
    },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "entity_id", "recorded_at"]
}
