{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document Relationship",
  "description": "Links between related documents.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^document_relationship_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "source_document_id": { "type": "string" },
    "related_document_id": { "type": "string" },
    "relationship_type": { "type": "string", "enum": ["supports", "contradicts", "amends", "supersedes", "references", "attached_to", "grouped_with", "version_of"] },
    "relationship_strength": { "type": "string", "enum": ["weak", "medium", "strong", "critical"] },
    "created_date": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string" },
    "is_bidirectional": { "type": "boolean" },
    "notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "source_document_id", "related_document_id"],
  "_phase1_todo": ["Define relationship visualization", "Define transitive relationships", "Define relationship validation"]
}
