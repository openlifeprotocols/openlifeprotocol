{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document Category",
  "description": "Classification or categorization of documents.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^document_category_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "document_id": { "type": "string" },
    "primary_category": { "type": "string", "enum": ["financial", "legal", "medical", "personal", "professional", "identity", "property", "vehicle", "insurance", "education", "employment", "household", "other"] },
    "secondary_category": { "type": "string" },
    "tertiary_category": { "type": "string" },
    "classification_confidence": { "type": "number" },
    "auto_classified": { "type": "boolean" },
    "user_verified": { "type": "boolean" },
    "classification_date": { "type": "string", "format": "date-time" },
    "retention_period_days": { "type": "integer" },
    "retention_rule": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "document_id"],
  "_phase1_todo": ["Define ML classification", "Define category rules", "Define compliance mapping"]
}
