{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Service",
  "description": "A service offered or engaged — professional, trade, care, creative, or support.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^service_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "provider_id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "service_type": { "type": "string", "enum": ["professional", "trade", "care", "creative", "technology", "consulting", "maintenance", "logistics", "other"] },
    "category": { "type": "string" },
    "pricing_model": { "type": "string", "enum": ["fixed", "hourly", "daily", "per_unit", "retainer", "milestone", "subscription"] },
    "unit_price": { "type": "number" },
    "currency": { "type": "string" },
    "minimum_hours": { "type": "number" },
    "typical_duration_days": { "type": "integer" },
    "qualifications_required": { "type": "array", "items": { "type": "string" } },
    "deliverables": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["active", "discontinued", "draft"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "provider_id", "name", "service_type", "pricing_model"],
  "_phase1_todo": [
    "Define service SLAs",
    "Define service level tiers",
    "Define service delivery verification",
    "Define service complaints procedure"
  ]
}
