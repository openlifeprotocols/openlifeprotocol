{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asset (Resource)",
  "description": "A physical or intangible asset owned by a person or organisation — equipment, vehicle, machinery, IP, or goodwill.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^asset_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "external_ids": {
      "type": "array",
      "items": { "type": "object", "properties": { "system": { "type": "string" }, "id": { "type": "string" } }, "required": ["system", "id"] }
    },
    "owner_id": { "type": "string" },
    "name": { "type": "string" },
    "asset_class": { "type": "string", "enum": ["equipment", "vehicle", "machinery", "furniture", "it_hardware", "intangible_ip", "intangible_goodwill", "investment", "property", "other"] },
    "description": { "type": "string" },
    "acquisition_date": { "type": "string", "format": "date" },
    "acquisition_cost": { "type": "number" },
    "currency": { "type": "string" },
    "useful_life_years": { "type": "number" },
    "depreciation_method": { "type": "string", "enum": ["straight_line", "reducing_balance", "sum_of_years", "units_of_production"] },
    "annual_depreciation": { "type": "number" },
    "net_book_value": { "type": "number" },
    "net_book_value_date": { "type": "string", "format": "date" },
    "disposal_date": { "type": "string", "format": "date" },
    "disposal_proceeds": { "type": "number" },
    "location_id": { "type": "string" },
    "insurance_policy_id": { "type": "string" },
    "serial_number": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "impaired", "disposed", "fully_depreciated"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "owner_id", "name", "asset_class", "acquisition_date", "acquisition_cost", "currency"],
  "_phase1_todo": [
    "Define asset register integration",
    "Define impairment testing",
    "Define asset tagging and tracking",
    "Define capital allowances calculation"
  ]
}
