{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inventory Item",
  "description": "A stock record — the quantity of a product or material held at a location at a point in time.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^inventory_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "product_id": { "type": "string" },
    "material_id": { "type": "string" },
    "location_id": { "type": "string" },
    "quantity_on_hand": { "type": "number" },
    "quantity_allocated": { "type": "number" },
    "quantity_available": { "type": "number" },
    "quantity_on_order": { "type": "number" },
    "unit_of_measure": { "type": "string" },
    "unit_cost": { "type": "number" },
    "currency": { "type": "string" },
    "reorder_point": { "type": "number" },
    "reorder_quantity": { "type": "number" },
    "min_stock": { "type": "number" },
    "max_stock": { "type": "number" },
    "last_counted_date": { "type": "string", "format": "date" },
    "valuation_method": { "type": "string", "enum": ["fifo", "lifo", "weighted_average", "specific_identification"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "quantity_on_hand", "unit_of_measure"],
  "_phase1_todo": [
    "Define stock adjustment workflow",
    "Define automatic reorder triggers",
    "Define stock take procedure",
    "Define wastage tracking"
  ]
}
