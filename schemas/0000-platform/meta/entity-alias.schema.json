{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entity Alias",
  "description": "Aliases or alternative names for entities.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^entity_alias_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "canonical_entity_id": { "type": "string" },
    "entity_type": { "type": "string" },
    "primary_name": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "object", "properties": { "alias": { "type": "string" }, "type": { "type": "string", "enum": ["nickname", "abbreviation", "historical", "regional", "informal", "formal"] }, "context": { "type": "string" } } } },
    "name_variations": { "type": "array", "items": { "type": "string" } },
    "spelling_variations": { "type": "array", "items": { "type": "string" } },
    "language_variations": { "type": "object", "additionalProperties": { "type": "string" } },
    "disambiguation_notes": { "type": "string" },
    "preferred_alias": { "type": "string" },
    "deprecation_status": { "type": "string" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "canonical_entity_id"],
  "_phase1_todo": ["Define alias resolution", "Define deduplication", "Define entity matching"]
}
