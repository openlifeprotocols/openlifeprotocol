{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Life Area Map",
  "description": "User-facing life areas mapped to account codes for product and AI orchestration.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^life_area_map_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "version": { "type": "string" },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "account_codes": {
            "type": "array",
            "items": { "type": "string", "pattern": "^\\d{4,5}$" }
          }
        },
        "required": ["name", "account_codes"]
      }
    }
  },
  "required": ["id", "uuid", "version", "areas"]
}
