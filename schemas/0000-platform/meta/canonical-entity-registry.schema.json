{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Entity Registry",
  "description": "Governed catalog of ontology concepts and their authoritative schema definitions.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^canonical_entity_registry_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "version": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "concept": { "type": "string" },
          "ontology_type": {
            "type": "string",
            "enum": ["canonical", "extension", "specialisation", "view"]
          },
          "authoritative_schema": { "type": "string" },
          "extends": { "type": ["string", "null"] },
          "description": { "type": "string" },
          "owner_account": { "type": "string", "pattern": "^\\d{4,5}$" },
          "status": {
            "type": "string",
            "enum": ["active", "proposed", "deprecated", "superseded"]
          },
          "notes": { "type": "string" }
        },
        "required": [
          "concept",
          "ontology_type",
          "authoritative_schema",
          "description",
          "owner_account",
          "status"
        ]
      }
    },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "version", "entries"]
}
