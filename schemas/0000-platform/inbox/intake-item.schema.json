{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intake Item",
  "description": "Item in intake queue awaiting processing.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^intake_item_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "source": { "type": "string", "enum": ["email", "document_scan", "form", "api", "web", "mobile", "manual", "import"] },
    "source_identifier": { "type": "string" },
    "source_timestamp": { "type": "string", "format": "date-time" },
    "item_title": { "type": "string" },
    "item_description": { "type": "string" },
    "item_content": { "type": "string" },
    "attachments": { "type": "array", "items": { "type": "string" } },
    "sender_or_source": { "type": "string" },
    "received_date": { "type": "string", "format": "date-time" },
    "inbox_status": { "type": "string", "enum": ["new", "in_queue", "in_triage", "processing", "completed", "archived"] },
    "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "suggested_category": { "type": "string" },
    "processing_notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define auto-categorization", "Define deduplication", "Define batch processing"]
}
