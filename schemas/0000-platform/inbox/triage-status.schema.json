{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Triage Status",
  "description": "Triage categorization and routing for intake items.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^triage_status_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "intake_item_id": { "type": "string" },
    "triage_category": { "type": "string", "enum": ["actionable", "informational", "duplicate", "spam", "defer", "delegate", "delete", "archive"] },
    "triage_decision_date": { "type": "string", "format": "date-time" },
    "triaged_by_person_id": { "type": "string" },
    "assigned_to_person_id": { "type": "string" },
    "target_entity_type": { "type": "string" },
    "target_entity_id": { "type": "string" },
    "processing_workflow": { "type": "string" },
    "estimated_effort_hours": { "type": "number" },
    "deadline": { "type": "string", "format": "date" },
    "triage_notes": { "type": "string" },
    "is_duplicate_of": { "type": "string" },
    "automation_rule_applied": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "intake_item_id"],
  "_phase1_todo": ["Define triage rules", "Define workflow routing", "Define triage metrics"]
}
