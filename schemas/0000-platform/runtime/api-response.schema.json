{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API Response",
  "description": "Standard response wrapper for API calls with status, data, and error information.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^api_response_[a-zA-Z0-9_-]+$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["success", "error", "partial", "pending"]
    },
    "http_status": {
      "type": "integer"
    },
    "data": {
      "type": "object",
      "description": "Response data payload"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "details": { "type": "object" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "processing_time_ms": { "type": "integer" },
        "api_version": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "required": ["id", "uuid", "status", "http_status"],
  "_phase1_todo": [
    "Define response pagination",
    "Define response filtering",
    "Define response caching",
    "Define response compression"
  ]
}
