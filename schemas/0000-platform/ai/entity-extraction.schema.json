{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entity Extraction",
  "description": "AI-extracted entities from document.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^entity_extraction_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "document_id": { "type": "string" },
    "extraction_model": { "type": "string" },
    "model_version": { "type": "string" },
    "extracted_entities": { "type": "array", "items": { "type": "object", "properties": { "entity_text": { "type": "string" }, "entity_type": { "type": "string" }, "confidence_score": { "type": "number" }, "start_position": { "type": "integer" }, "end_position": { "type": "integer" }, "linked_entity_id": { "type": "string" } } } },
    "entity_types_found": { "type": "array", "items": { "type": "string" } },
    "extraction_date": { "type": "string", "format": "date-time" },
    "is_user_reviewed": { "type": "boolean" },
    "manual_corrections": { "type": "array", "items": { "type": "object" } },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "document_id"],
  "_phase1_todo": ["Define entity linking workflow", "Define extraction feedback", "Define extraction accuracy tracking"]
}
