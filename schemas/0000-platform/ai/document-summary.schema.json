{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document Summary",
  "description": "AI-generated summary of document.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^document_summary_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "document_id": { "type": "string" },
    "summary_model": { "type": "string" },
    "model_version": { "type": "string" },
    "summary_type": { "type": "string", "enum": ["extractive", "abstractive", "bullet_points", "key_takeaways"] },
    "summary_text": { "type": "string" },
    "summary_length_tokens": { "type": "integer" },
    "original_length_tokens": { "type": "integer" },
    "compression_ratio": { "type": "number" },
    "key_topics": { "type": "array", "items": { "type": "string" } },
    "sentiment": { "type": "string", "enum": ["positive", "neutral", "negative", "mixed"] },
    "generation_date": { "type": "string", "format": "date-time" },
    "is_user_reviewed": { "type": "boolean" },
    "user_feedback": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "document_id"],
  "_phase1_todo": ["Define summary regeneration", "Define summary customization", "Define multi-language summaries"]
}
