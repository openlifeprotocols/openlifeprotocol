{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Question Answer",
  "description": "Question-answer pair generated from document.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^question_answer_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "document_id": { "type": "string" },
    "question": { "type": "string" },
    "answer": { "type": "string" },
    "answer_type": { "type": "string", "enum": ["factual", "procedural", "definitional", "comparative", "predictive"] },
    "confidence_score": { "type": "number" },
    "supporting_text": { "type": "string" },
    "generation_model": { "type": "string" },
    "generation_date": { "type": "string", "format": "date-time" },
    "is_user_validated": { "type": "boolean" },
    "user_feedback": { "type": "string" },
    "question_category": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "document_id"],
  "_phase1_todo": ["Define QA dataset creation", "Define QA search indexing", "Define QA feedback loop"]
}
