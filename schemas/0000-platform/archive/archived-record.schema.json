{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archived Record",
  "description": "Archived or cold-storage record.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^archived_record_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "owner_id": { "type": "string" },
    "record_type": { "type": "string" },
    "original_document_id": { "type": "string" },
    "archive_date": { "type": "string", "format": "date-time" },
    "archived_by": { "type": "string" },
    "archive_reason": { "type": "string", "enum": ["retention_policy", "user_requested", "inactivity", "space_management", "legal_hold_expired", "other"] },
    "storage_location": { "type": "string", "enum": ["cloud_cold_storage", "archive_tier", "physical_storage", "offline_backup"] },
    "access_available": { "type": "boolean" },
    "retrieval_time_estimate_hours": { "type": "integer" },
    "cost_per_month": { "type": "number" },
    "retention_until_date": { "type": "string", "format": "date" },
    "encryption_key_id": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "owner_id"],
  "_phase1_todo": ["Define retrieval workflow", "Define cost tracking", "Define retention compliance"]
}
