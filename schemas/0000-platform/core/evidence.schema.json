{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence",
  "description": "Supporting evidence used to justify decisions, verify claims, or support case outcomes. Links documents, data points, and verification records.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evidence_[a-zA-Z0-9_-]+$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "external_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "system": { "type": "string" },
          "id": { "type": "string" },
          "type": { "type": "string" }
        },
        "required": ["system", "id"]
      }
    },
    "case_id": { "type": "string" },
    "decision_id": { "type": "string" },
    "evidence_type": {
      "type": "string",
      "enum": ["document", "data_point", "testimony", "expert_opinion", "verification", "precedent", "rule", "calculation"],
      "description": "Type of evidence"
    },
    "description": { "type": "string" },
    "source": {
      "type": "object",
      "description": "Where the evidence came from",
      "properties": {
        "type": { "type": "string" },
        "reference": { "type": "string" },
        "date": { "type": "string", "format": "date-time" }
      }
    },
    "reliability": {
      "type": "string",
      "enum": ["high", "medium", "low", "unknown"],
      "description": "Reliability/credibility rating"
    },
    "supporting_documents": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["id", "uuid", "evidence_type"],
  "_phase1_todo": [
    "Define evidence standards by jurisdiction",
    "Define chain of custody for evidence",
    "Define evidence authenticity verification",
    "Define evidence retention periods",
    "Define evidence conflict resolution",
    "Define evidence weighting in decision logic"
  ]
}
