{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entity Mention",
  "description": "Mention of entity within content.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^entity_mention_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "source_document_id": { "type": "string" },
    "mentioned_entity_id": { "type": "string" },
    "mentioned_entity_type": { "type": "string" },
    "mention_text": { "type": "string" },
    "mention_context": { "type": "string" },
    "context_start_position": { "type": "integer" },
    "context_end_position": { "type": "integer" },
    "mention_confidence": { "type": "number" },
    "mention_type": { "type": "string", "enum": ["explicit", "implicit", "inferred"] },
    "extraction_method": { "type": "string" },
    "extraction_date": { "type": "string", "format": "date-time" },
    "is_confirmed": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "source_document_id"],
  "_phase1_todo": ["Define mention deduplication", "Define mention clustering", "Define mention importance scoring"]
}
