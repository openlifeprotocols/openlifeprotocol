{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Search Index",
  "description": "Search index for full-text search.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^search_index_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "document_id": { "type": "string" },
    "indexed_text": { "type": "string" },
    "language": { "type": "string" },
    "indexed_date": { "type": "string", "format": "date-time" },
    "last_updated": { "type": "string", "format": "date-time" },
    "index_version": { "type": "string" },
    "text_preview": { "type": "string" },
    "word_count": { "type": "integer" },
    "searchable": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "document_id"],
  "_phase1_todo": ["Define index updating", "Define relevance scoring", "Define index maintenance"]
}
