{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Saved Search",
  "description": "Saved search query for quick retrieval.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^saved_search_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "search_name": { "type": "string" },
    "search_query": { "type": "string" },
    "search_filters": { "type": "array", "items": { "type": "object", "properties": { "field": { "type": "string" }, "operator": { "type": "string" }, "value": { "type": "string" } } } },
    "search_scope": { "type": "string", "enum": ["all", "documents", "images", "videos", "emails", "messages", "custom"] },
    "sort_by": { "type": "string" },
    "sort_order": { "type": "string", "enum": ["ascending", "descending"] },
    "result_limit": { "type": "integer" },
    "created_date": { "type": "string", "format": "date-time" },
    "last_executed": { "type": "string", "format": "date-time" },
    "execution_count": { "type": "integer" },
    "favorite": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define search suggestions", "Define query optimization", "Define alert triggers"]
}
