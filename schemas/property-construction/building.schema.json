{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Building",
  "description": "A constructed building on a parcel of land — with physical characteristics, EPC, and occupancy.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^building_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "land_id": { "type": "string" },
    "address_id": { "type": "string" },
    "uprn": { "type": "string" },
    "name": { "type": "string" },
    "building_type": { "type": "string", "enum": ["residential_detached", "residential_semi", "residential_terraced", "flat_apartment", "commercial_office", "commercial_retail", "industrial", "mixed_use", "other"] },
    "construction_year": { "type": "integer" },
    "storeys": { "type": "integer" },
    "gross_internal_area_sqm": { "type": "number" },
    "net_internal_area_sqm": { "type": "number" },
    "epc_rating": { "type": "string", "enum": ["A", "B", "C", "D", "E", "F", "G"] },
    "epc_score": { "type": "integer" },
    "epc_expiry": { "type": "string", "format": "date" },
    "construction_type": { "type": "string", "examples": ["brick_and_block", "timber_frame", "steel_frame", "concrete"] },
    "listing_grade": { "type": "string", "enum": ["unlisted", "grade_2", "grade_2_star", "grade_1", "category_a", "category_b"] },
    "heritage_risk": { "type": "boolean" },
    "room_ids": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "building_type"],
  "_phase1_todo": [
    "Define building safety regulations (Building Safety Act 2022)",
    "Define fire risk assessment linkage",
    "Define building passport/log book",
    "Define mandatory EPC triggers"
  ]
}
