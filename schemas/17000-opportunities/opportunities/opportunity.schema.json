{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opportunity",
  "description": "A personal opportunity that has been identified and is being evaluated or pursued.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^opportunity_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "type": { "type": "string", "enum": ["career", "business", "investment", "collaboration", "learning", "relationship", "creative", "civic", "other"] },
    "source": { "type": "string", "description": "Where or who this came from" },
    "introduced_by_person_id": { "type": "string" },
    "status": { "type": "string", "enum": ["identified", "evaluating", "pursuing", "committed", "won", "lost", "deferred", "declined"] },
    "probability": { "type": "integer", "minimum": 0, "maximum": 100 },
    "potential_value": { "type": "string", "description": "Qualitative or quantitative upside" },
    "deadline": { "type": "string", "format": "date" },
    "decision_date": { "type": "string", "format": "date" },
    "next_action": { "type": "string" },
    "next_action_due": { "type": "string", "format": "date" },
    "notes": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "title", "type", "status"]
}
