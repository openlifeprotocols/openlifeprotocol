{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Introduction",
  "description": "A record of a connection made between two people, or a connection made to the subject.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^intro_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "introduced_by_person_id": { "type": "string" },
    "introduced_to_person_id": { "type": "string" },
    "context": { "type": "string", "description": "Why this introduction was made" },
    "purpose": { "type": "string", "enum": ["job", "collaboration", "investment", "advice", "friendship", "business", "creative", "other"] },
    "medium": { "type": "string", "enum": ["email", "in-person", "message", "phone", "social", "event"] },
    "date": { "type": "string", "format": "date" },
    "followed_up": { "type": "boolean" },
    "follow_up_date": { "type": "string", "format": "date" },
    "outcome": { "type": "string" },
    "converted_to_opportunity_id": { "type": "string" },
    "notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "date"]
}
