{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Idea",
  "description": "A nascent personal idea that may become an opportunity, project or decision.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^idea_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "domain": { "type": "string", "enum": ["career", "business", "creative", "financial", "personal", "social", "learning", "health", "community", "other"] },
    "status": { "type": "string", "enum": ["raw", "developing", "validated", "parked", "abandoned", "converted"] },
    "converted_to": { "type": "string", "description": "ID of the opportunity, project or goal this became" },
    "inspiration_source": { "type": "string" },
    "potential_impact": { "type": "string", "enum": ["low", "medium", "high", "transformative"] },
    "effort_estimate": { "type": "string", "enum": ["quick-win", "small", "medium", "large", "moonshot"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "title", "domain", "status"]
}
