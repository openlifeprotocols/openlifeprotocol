{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prospect",
  "description": "A personal prospect — a potential employer, collaborator, investor or partner being cultivated.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^prospect_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "target_person_id": { "type": "string" },
    "target_organisation": { "type": "string" },
    "type": { "type": "string", "enum": ["employer", "investor", "collaborator", "client", "partner", "advisor", "mentor"] },
    "status": { "type": "string", "enum": ["identified", "researching", "warming", "in-contact", "active", "converted", "cold", "dropped"] },
    "connection_strength": { "type": "string", "enum": ["none", "weak", "warm", "strong", "deep"] },
    "last_contact_date": { "type": "string", "format": "date" },
    "next_touch_date": { "type": "string", "format": "date" },
    "linked_opportunity_id": { "type": "string" },
    "notes": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "type", "status"]
}
