{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offer Letter",
  "description": "Job offer letter from employer.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^offer_letter_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "company_name": { "type": "string" },
    "job_title": { "type": "string" },
    "department": { "type": "string" },
    "reporting_to": { "type": "string" },
    "offer_date": { "type": "string", "format": "date" },
    "start_date": { "type": "string", "format": "date" },
    "salary": { "type": "number" },
    "currency": { "type": "string" },
    "salary_frequency": { "type": "string", "enum": ["hourly", "annual", "monthly"] },
    "bonus_structure": { "type": "string" },
    "benefits_summary": { "type": "array", "items": { "type": "string" } },
    "employment_type": { "type": "string", "enum": ["full_time", "part_time", "contract", "temporary", "internship"] },
    "location": { "type": "string" },
    "remote_policy": { "type": "string", "enum": ["on_site", "hybrid", "remote"] },
    "acceptance_deadline": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["pending", "accepted", "rejected", "expired", "withdrawn"] },
    "document_id": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "company_name"],
  "_phase1_todo": ["Define offer negotiation tracking", "Define benefits comparison", "Define acceptance workflow"]
}
