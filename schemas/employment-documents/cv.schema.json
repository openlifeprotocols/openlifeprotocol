{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CV",
  "description": "Curriculum Vitae or resume document.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^cv_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "version": { "type": "integer" },
    "format": { "type": "string", "enum": ["pdf", "docx", "doc", "txt", "html"] },
    "document_url": { "type": "string", "format": "uri" },
    "document_id": { "type": "string" },
    "creation_date": { "type": "string", "format": "date" },
    "last_updated": { "type": "string", "format": "date-time" },
    "professional_summary": { "type": "string" },
    "years_of_experience": { "type": "integer" },
    "key_skills": { "type": "array", "items": { "type": "string" } },
    "languages": { "type": "array", "items": { "type": "object", "properties": { "language": { "type": "string" }, "proficiency": { "type": "string" } } } },
    "certifications": { "type": "array", "items": { "type": "string" } },
    "is_current": { "type": "boolean" },
    "purpose": { "type": "string", "enum": ["general", "specific_role", "industry", "location"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": ["Define CV parsing", "Define skills extraction", "Define ATS compatibility checking"]
}
