{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Employment Contract",
  "description": "Employment agreement contract.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^employment_contract_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "company_name": { "type": "string" },
    "job_title": { "type": "string" },
    "contract_type": { "type": "string", "enum": ["permanent", "fixed_term", "temporary", "apprenticeship", "probationary"] },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "duration_months": { "type": "integer" },
    "salary": { "type": "number" },
    "currency": { "type": "string" },
    "salary_frequency": { "type": "string", "enum": ["hourly", "annual", "monthly"] },
    "working_hours_per_week": { "type": "number" },
    "notice_period_days": { "type": "integer" },
    "probation_period_months": { "type": "integer" },
    "confidentiality_clause": { "type": "boolean" },
    "non_compete_clause": { "type": "boolean" },
    "non_compete_duration_months": { "type": "integer" },
    "ip_ownership": { "type": "string" },
    "remote_work_allowed": { "type": "boolean" },
    "document_id": { "type": "string" },
    "signed_date": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["active", "ended", "suspended", "terminated"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "company_name"],
  "_phase1_todo": ["Define contract terms extraction", "Define compliance checking", "Define contract renewal alerts"]
}
