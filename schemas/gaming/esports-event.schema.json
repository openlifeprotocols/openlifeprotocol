{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Esports Event",
  "description": "Esports tournament or competition.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^esports_event_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "event_name": { "type": "string" },
    "game_title": { "type": "string" },
    "event_type": { "type": "string", "enum": ["online", "offline", "hybrid", "local_lan"] },
    "event_date": { "type": "string", "format": "date" },
    "start_time": { "type": "string", "format": "time" },
    "location": { "type": "string" },
    "tournament_format": { "type": "string" },
    "entry_fee": { "type": "number" },
    "prize_pool": { "type": "number" },
    "participated": { "type": "boolean" },
    "team_name": { "type": "string" },
    "team_members": { "type": "array", "items": { "type": "string" } },
    "placement": { "type": "integer" },
    "matches_won": { "type": "integer" },
    "matches_lost": { "type": "integer" },
    "prize_won": { "type": "number" },
    "spectated": { "type": "boolean" },
    "favorite_match": { "type": "string" },
    "memorable_moments": { "type": "array", "items": { "type": "string" } },
    "vod_links": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "event_name"],
  "_phase1_todo": ["Define tournament tracking", "Define VOD management", "Define career stats"]
}
