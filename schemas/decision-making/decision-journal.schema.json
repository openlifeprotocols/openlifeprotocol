{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision Journal",
  "description": "Decision journal entry for decision tracking.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^decision_journal_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "decision_date": { "type": "string", "format": "date" },
    "decision_name": { "type": "string" },
    "decision_category": { "type": "string", "enum": ["career", "personal", "financial", "health", "relationship", "education", "other"] },
    "context": { "type": "string" },
    "problem_statement": { "type": "string" },
    "decision_options": { "type": "array", "items": { "type": "object", "properties": { "option": { "type": "string" }, "pros": { "type": "array" }, "cons": { "type": "array" }, "risk_level": { "type": "string" } } } },
    "key_information_considered": { "type": "array", "items": { "type": "string" } },
    "information_gaps": { "type": "array", "items": { "type": "string" } },
    "people_consulted": { "type": "array", "items": { "type": "string" } },
    "frameworks_used": { "type": "array", "items": { "type": "string" } },
    "gut_feeling": { "type": "string" },
    "emotional_state": { "type": "string" },
    "time_pressure": { "type": "string", "enum": ["urgent", "moderate", "flexible", "no_deadline"] },
    "decision_made": { "type": "string" },
    "reasoning": { "type": "string" },
    "confidence_level": { "type": "number", "minimum": 1, "maximum": 10 },
    "decision_reversible": { "type": "boolean" },
    "committed_to_decision": { "type": "boolean" },
    "action_plan": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "decision_name"],
  "_phase1_todo": ["Define decision tracking", "Define bias detection", "Define decision review scheduling"]
}
