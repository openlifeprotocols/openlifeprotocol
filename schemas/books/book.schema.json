{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Book",
  "description": "Published book.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^book_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "author_names": { "type": "array", "items": { "type": "string" } },
    "publication_year": { "type": "integer" },
    "publication_date": { "type": "string", "format": "date" },
    "publisher": { "type": "string" },
    "isbn": { "type": "string" },
    "genre": { "type": "string", "enum": ["fiction", "non_fiction", "mystery", "romance", "sci_fi", "fantasy", "biography", "history", "other"] },
    "language": { "type": "string" },
    "page_count": { "type": "integer" },
    "edition": { "type": "string" },
    "goodreads_rating": { "type": "number", "minimum": 0, "maximum": 5 },
    "goodreads_id": { "type": "string" },
    "description": { "type": "string" },
    "series_name": { "type": "string" },
    "series_number": { "type": "number" },
    "user_rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "favorite": { "type": "boolean" },
    "on_wishlist": { "type": "boolean" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "title"],
  "_phase1_todo": ["Define reading history", "Define review management", "Define series linking"]
}
