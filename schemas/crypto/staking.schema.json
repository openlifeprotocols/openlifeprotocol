{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Staking",
  "description": "Cryptocurrency staking arrangement and rewards.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^staking_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "cryptocurrency_id": { "type": "string" },
    "wallet_id": { "type": "string" },
    "stake_amount": { "type": "number" },
    "coin_symbol": { "type": "string" },
    "blockchain": { "type": "string" },
    "staking_provider": { "type": "string" },
    "staking_type": { "type": "string", "enum": ["proof_of_stake", "defi_pool", "exchange_staking", "validator"] },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "lock_period_days": { "type": "integer" },
    "annual_percentage_rate": { "type": "number" },
    "estimated_annual_rewards": { "type": "number" },
    "actual_rewards_earned": { "type": "number" },
    "rewards_frequency": { "type": "string", "enum": ["daily", "weekly", "monthly", "quarterly", "at_end"] },
    "last_reward_date": { "type": "string", "format": "date" },
    "auto_compound": { "type": "boolean" },
    "is_active": { "type": "boolean" },
    "early_withdrawal_allowed": { "type": "boolean" },
    "early_withdrawal_penalty": { "type": "number" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "cryptocurrency_id", "stake_amount"],
  "_phase1_todo": [
    "Define staking return optimization",
    "Define staking risk analysis",
    "Define staking tax tracking"
  ]
}
