{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cryptocurrency",
  "description": "A cryptocurrency holding in a wallet.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^cryptocurrency_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "wallet_id": { "type": "string" },
    "coin_symbol": { "type": "string" },
    "coin_name": { "type": "string" },
    "quantity": { "type": "number" },
    "current_price": { "type": "number" },
    "current_value": { "type": "number" },
    "currency": { "type": "string" },
    "market_cap": { "type": "number" },
    "circulating_supply": { "type": "number" },
    "all_time_high": { "type": "number" },
    "all_time_low": { "type": "number" },
    "fifty_two_week_high": { "type": "number" },
    "fifty_two_week_low": { "type": "number" },
    "price_change_24h": { "type": "number" },
    "volume_24h": { "type": "number" },
    "blockchain": { "type": "string" },
    "purchase_price_average": { "type": "number" },
    "total_cost_basis": { "type": "number" },
    "unrealized_gain_loss": { "type": "number" },
    "last_price_update": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "wallet_id", "coin_symbol", "coin_name"],
  "_phase1_todo": [
    "Define crypto portfolio tracking",
    "Define price alert thresholds",
    "Define tax reporting for crypto"
  ]
}
