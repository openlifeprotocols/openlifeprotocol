{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Estimate",
  "description": "A cost or time estimate for a project or phase — the forecast before actuals are known.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^estimate_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string" },
    "prepared_by_id": { "type": "string" },
    "estimate_type": { "type": "string", "enum": ["rough_order_of_magnitude", "budgetary", "definitive", "firm_fixed_price"] },
    "estimate_date": { "type": "string", "format": "date" },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": { "type": "string" },
          "description": { "type": "string" },
          "quantity": { "type": "number" },
          "unit_of_measure": { "type": "string" },
          "unit_rate": { "type": "number" },
          "subtotal": { "type": "number" }
        }
      }
    },
    "subtotal": { "type": "number" },
    "contingency_rate": { "type": "number", "description": "e.g., 0.1 for 10%" },
    "contingency_amount": { "type": "number" },
    "total": { "type": "number" },
    "currency": { "type": "string" },
    "accuracy_range": {
      "type": "object",
      "properties": {
        "low_percentage": { "type": "number" },
        "high_percentage": { "type": "number" }
      }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "exclusions": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["draft", "approved", "superseded"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "project_id", "estimate_type", "estimate_date", "total", "currency"],
  "_phase1_todo": [
    "Define estimate vs actuals tracking",
    "Define estimate revision history",
    "Define benchmarking against similar projects",
    "Define estimating uncertainty modelling"
  ]
}
