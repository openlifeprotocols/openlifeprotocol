{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Care Provider",
  "description": "An organisation or individual providing care services — GP surgery, hospital, care home, domiciliary care agency.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^care_provider_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "external_ids": {
      "type": "array",
      "items": { "type": "object", "properties": { "system": { "type": "string" }, "id": { "type": "string" } }, "required": ["system", "id"] }
    },
    "actor_id": { "type": "string" },
    "name": { "type": "string" },
    "provider_type": { "type": "string", "enum": ["gp_surgery", "hospital", "care_home", "nursing_home", "domiciliary_care", "mental_health", "pharmacy", "dentist", "optician", "specialist", "hospice", "other"] },
    "registration_body": { "type": "string", "description": "e.g., CQC, GMC" },
    "registration_number": { "type": "string" },
    "cqc_rating": { "type": "string", "enum": ["outstanding", "good", "requires_improvement", "inadequate", "not_rated"] },
    "address_id": { "type": "string" },
    "contact_point_ids": { "type": "array", "items": { "type": "string" } },
    "specialties": { "type": "array", "items": { "type": "string" } },
    "accepting_new_patients": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "name", "provider_type"],
  "_phase1_todo": [
    "Define provider inspection records",
    "Define provider capacity management",
    "Define cross-provider care coordination",
    "Define provider deregistration procedures"
  ]
}
