{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Disability",
  "description": "A disability record — a physical, sensory, cognitive, or mental health impairment affecting daily life.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^disability_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "disability_type": { "type": "string", "enum": ["physical", "sensory_vision", "sensory_hearing", "cognitive", "mental_health", "neurological", "chronic_illness", "multiple", "other"] },
    "description": { "type": "string" },
    "diagnosed_date": { "type": "string", "format": "date" },
    "is_progressive": { "type": "boolean" },
    "is_variable": { "type": "boolean" },
    "legally_protected": { "type": "boolean", "description": "Meets Equality Act 2010 definition" },
    "adjustments_required": { "type": "array", "items": { "type": "string" } },
    "dla_pip_claim_id": { "type": "string" },
    "blue_badge": {
      "type": "object",
      "properties": {
        "number": { "type": "string" },
        "expiry": { "type": "string", "format": "date" }
      }
    },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "disability_type"],
  "_phase1_todo": [
    "Define workplace adjustments workflow",
    "Define disability benefit entitlement",
    "Define disability and travel (Blue Badge)",
    "Define disability disclosure preferences"
  ]
}
