{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Medication",
  "description": "A medication record — prescribed or over-the-counter, with dosage and administration details.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^medication_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "prescriber_id": { "type": "string" },
    "name": { "type": "string" },
    "generic_name": { "type": "string" },
    "form": { "type": "string", "enum": ["tablet", "capsule", "liquid", "injection", "inhaler", "patch", "cream", "drops", "other"] },
    "strength": { "type": "string", "examples": ["20mg", "500mg/5ml"] },
    "dosage_instructions": { "type": "string" },
    "frequency": { "type": "string", "examples": ["once daily", "twice daily", "as required"] },
    "route": { "type": "string", "enum": ["oral", "topical", "inhalation", "injection", "sublingual", "other"] },
    "indication": { "type": "string" },
    "prescribed_date": { "type": "string", "format": "date" },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "repeat_prescription": { "type": "boolean" },
    "allergies_checked": { "type": "boolean" },
    "status": { "type": "string", "enum": ["active", "completed", "on_hold", "cancelled"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "name", "prescribed_date"],
  "_phase1_todo": [
    "Define drug interaction checking",
    "Define controlled drug special handling",
    "Define medication adherence tracking",
    "Define prescription history portability"
  ]
}
