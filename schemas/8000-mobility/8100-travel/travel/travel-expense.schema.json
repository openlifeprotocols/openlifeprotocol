{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Travel Expense",
  "description": "A single expense incurred during a trip — meal, taxi, entrance fee, or purchase.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^travel_expense_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "trip_id": { "type": "string" },
    "travel_budget_id": { "type": "string" },
    "incurred_by_id": { "type": "string" },
    "expense_date": { "type": "string", "format": "date" },
    "category": { "type": "string", "enum": ["food_drink", "transport", "accommodation", "activities", "shopping", "medical", "communication", "laundry", "tips", "emergency", "other"] },
    "description": { "type": "string" },
    "local_amount": { "type": "number" },
    "local_currency": { "type": "string" },
    "converted_amount": { "type": "number" },
    "base_currency": { "type": "string" },
    "exchange_rate": { "type": "number" },
    "paid_by_id": { "type": "string" },
    "shared_with_ids": { "type": "array", "items": { "type": "string" } },
    "split_amount": { "type": "number", "description": "Your share if split" },
    "receipt_document_id": { "type": "string" },
    "reimbursable": { "type": "boolean", "description": "True for business travel expenses" },
    "reimbursed": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "trip_id", "incurred_by_id", "expense_date", "category", "local_amount", "local_currency"],
  "_phase1_todo": [
    "Define receipt OCR capture",
    "Define group expense splitting and settlement",
    "Define business expense policy compliance",
    "Define multi-currency reconciliation"
  ]
}
