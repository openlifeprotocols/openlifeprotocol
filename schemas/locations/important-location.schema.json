{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Important Location",
  "description": "Important places and landmarks.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^important_location_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "location_name": { "type": "string" },
    "location_type": { "type": "string", "enum": ["home", "work", "family_home", "hospital", "school", "favorite_restaurant", "emergency_shelter", "favorite_spot", "other"] },
    "street_address": { "type": "string" },
    "city": { "type": "string" },
    "state_province": { "type": "string" },
    "postal_code": { "type": "string" },
    "country": { "type": "string" },
    "latitude": { "type": "number" },
    "longitude": { "type": "number" },
    "phone_number": { "type": "string" },
    "email": { "type": "string" },
    "website": { "type": "string", "format": "uri" },
    "hours_of_operation": { "type": "string" },
    "access_instructions": { "type": "string" },
    "parking_information": { "type": "string" },
    "accessibility_notes": { "type": "string" },
    "associated_person_id": { "type": "string" },
    "distance_from_home_miles": { "type": "number" },
    "average_travel_time_minutes": { "type": "integer" },
    "frequency_visited": { "type": "string", "enum": ["daily", "weekly", "monthly", "occasionally", "rarely"] },
    "last_visited_date": { "type": "string", "format": "date" },
    "notes": { "type": "string" },
    "photos": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "location_name"],
  "_phase1_todo": ["Define location routing", "Define arrival alerts", "Define location search"]
}
