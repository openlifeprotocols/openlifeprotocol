{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Geofenced Reminder",
  "description": "Location-based reminders and alerts.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^geofenced_reminder_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "reminder_name": { "type": "string" },
    "reminder_description": { "type": "string" },
    "location_id": { "type": "string" },
    "latitude": { "type": "number" },
    "longitude": { "type": "number" },
    "geofence_radius_meters": { "type": "number" },
    "trigger_type": { "type": "string", "enum": ["entering", "leaving", "near"] },
    "reminder_content": { "type": "string" },
    "reminder_action": { "type": "string", "enum": ["notification", "task_creation", "automation_trigger", "phone_call", "sms"] },
    "associated_task_id": { "type": "string" },
    "associated_automation_id": { "type": "string" },
    "notification_delay_seconds": { "type": "integer" },
    "is_recurring": { "type": "boolean" },
    "recurrence_pattern": { "type": "string" },
    "is_active": { "type": "boolean" },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "times_triggered": { "type": "integer" },
    "last_triggered_date": { "type": "string", "format": "date-time" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "latitude", "longitude"],
  "_phase1_todo": ["Define geofence optimization", "Define reminder delivery", "Define privacy considerations"]
}
