{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Award",
  "description": "Award, honor, or recognition received.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^award_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "award_name": { "type": "string" },
    "award_type": { "type": "string", "enum": ["professional", "academic", "community", "personal", "industry", "lifetime_achievement", "other"] },
    "awarding_organization": { "type": "string" },
    "award_date": { "type": "string", "format": "date" },
    "award_year": { "type": "integer" },
    "award_category": { "type": "string" },
    "nomination_process": { "type": "string" },
    "reason_for_award": { "type": "string" },
    "award_criteria": { "type": "array", "items": { "type": "string" } },
    "significance": { "type": "string", "enum": ["local", "regional", "national", "international"] },
    "prestige_level": { "type": "string", "enum": ["low", "moderate", "high", "very_high"] },
    "prize_or_monetary_value": { "type": "number" },
    "award_certificate": { "type": "string" },
    "award_artifact": { "type": "string" },
    "photo_with_award": { "type": "string" },
    "media_coverage": { "type": "array", "items": { "type": "string" } },
    "ceremony_details": { "type": "string" },
    "guests_present": { "type": "array", "items": { "type": "string" } },
    "speech_given": { "type": "string" },
    "career_impact": { "type": "string" },
    "doors_opened": { "type": "array", "items": { "type": "string" } },
    "legacy_significance": { "type": "string" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "award_name"],
  "_phase1_todo": ["Define achievement portfolio", "Define recognition timeline", "Define career milestone tracking"]
}
