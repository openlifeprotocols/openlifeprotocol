{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Media Mention",
  "description": "Mention in media or press coverage.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^media_mention_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "mention_date": { "type": "string", "format": "date" },
    "media_outlet": { "type": "string" },
    "media_type": { "type": "string", "enum": ["newspaper", "magazine", "online_news", "blog", "podcast", "tv", "radio", "social_media", "other"] },
    "article_or_story_title": { "type": "string" },
    "article_url": { "type": "string", "format": "uri" },
    "journalist_name": { "type": "string" },
    "mention_type": { "type": "string", "enum": ["feature", "quote", "reference", "photo", "interview", "profile", "opinion"] },
    "topic": { "type": "string" },
    "sentiment": { "type": "string", "enum": ["positive", "neutral", "negative"] },
    "prominence_level": { "type": "string", "enum": ["prominent", "moderate", "minor"] },
    "reach_estimate": { "type": "number" },
    "excerpt": { "type": "string" },
    "full_article_location": { "type": "string" },
    "impact": { "type": "string" },
    "opportunities_generated": { "type": "array", "items": { "type": "string" } },
    "contacts_made": { "type": "array", "items": { "type": "string" } },
    "media_kit_used": { "type": "boolean" },
    "follow_up_interviews": { "type": "array", "items": { "type": "string" } },
    "satisfaction_with_coverage": { "type": "number", "minimum": 1, "maximum": 5 },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "mention_date"],
  "_phase1_todo": ["Define media monitoring", "Define reputation tracking", "Define opportunity pipeline"]
}
