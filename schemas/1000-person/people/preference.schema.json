{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Preference",
  "description": "A person's stated preferences for communication, accessibility, language, and service delivery.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^preference_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "communication": {
      "type": "object",
      "properties": {
        "preferred_channel": { "type": "string", "enum": ["email", "sms", "post", "phone", "in_person", "app"] },
        "preferred_language": { "type": "string", "description": "BCP 47 language tag" },
        "preferred_format": { "type": "string", "enum": ["digital", "paper", "large_print", "braille", "audio"] },
        "opt_out_marketing": { "type": "boolean" },
        "contact_hours": { "type": "string", "examples": ["09:00-17:00 Mon-Fri"] }
      }
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "needs_interpreter": { "type": "boolean" },
        "interpreter_language": { "type": "string" },
        "hearing_impaired": { "type": "boolean" },
        "visual_impairment": { "type": "boolean" },
        "mobility_limitations": { "type": "boolean" },
        "additional_needs": { "type": "string" }
      }
    },
    "dietary": {
      "type": "array",
      "items": { "type": "string", "examples": ["vegetarian", "halal", "gluten_free"] }
    },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id"],
  "_phase1_todo": [
    "Define preference propagation to services",
    "Define preference change history",
    "Define preference inheritance for dependents",
    "Define preference verification"
  ]
}
