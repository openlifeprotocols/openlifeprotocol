{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal Preference",
  "description": "Personal defaults and preferences.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^personal_preference_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "preference_category": { "type": "string", "enum": ["food", "drink", "entertainment", "travel", "health", "fitness", "fashion", "other"] },
    "preference_name": { "type": "string" },
    "preference_value": { "type": "string" },
    "preference_priority": { "type": "integer", "minimum": 1, "maximum": 10 },
    "allergens_or_restrictions": { "type": "array", "items": { "type": "string" } },
    "favorability_score": { "type": "integer", "minimum": 1, "maximum": 10 },
    "last_experienced_date": { "type": "string", "format": "date" },
    "frequency": { "type": "string", "enum": ["rarely", "occasionally", "regularly", "frequently", "always"] },
    "notes": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "is_active": { "type": "boolean" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "preference_category"],
  "_phase1_todo": ["Define preference recommendations", "Define preference matching", "Define social preference sharing"]
}
