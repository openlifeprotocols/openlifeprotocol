{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Life Role",
  "description": "A life role — primary identity facet, social role, personal role one plays.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^life_role_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "role_name": { "type": "string" },
    "description": { "type": "string" },
    "role_type": { "type": "string", "enum": ["family", "professional", "social", "community", "creative", "spiritual", "athletic", "educational"] },
    "importance_to_identity": { "type": "string", "enum": ["peripheral", "moderate", "central", "defining"] },
    "started_date": { "type": "string", "format": "date" },
    "expected_duration": { "type": "string" },
    "primary_responsibilities": { "type": "array", "items": { "type": "string" } },
    "people_involved": { "type": "array", "items": { "type": "string" } },
    "satisfaction_level": { "type": "integer", "minimum": 1, "maximum": 10 },
    "challenges": { "type": "array", "items": { "type": "string" } },
    "rewards": { "type": "array", "items": { "type": "string" } },
    "balance_with_other_roles": { "type": "string" },
    "would_continue": { "type": "boolean" },
    "role_evolution": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "role_name", "role_type"],
  "_phase1_todo": [
    "Define role conflict resolution",
    "Define role satisfaction and wellbeing correlation",
    "Define role transition planning"
  ]
}
