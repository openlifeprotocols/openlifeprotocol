{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dependency",
  "description": "A dependency — emotional, financial, or relational reliance on another person, place, or thing.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^dependency_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "dependency_name": { "type": "string" },
    "description": { "type": "string" },
    "dependency_type": { "type": "string", "enum": ["emotional", "financial", "physical", "relational", "codependent", "toxic"] },
    "person_or_entity": { "type": "string" },
    "nature_of_dependency": { "type": "string" },
    "when_established": { "type": "string", "format": "date" },
    "severity": { "type": "string", "enum": ["mild", "moderate", "significant", "critical"] },
    "healthy_or_unhealthy": { "type": "string", "enum": ["healthy_interdependence", "mild_imbalance", "moderate_dependency", "unhealthy_codependency", "toxic"] },
    "why_dependent": { "type": "array", "items": { "type": "string" } },
    "consequences": { "type": "array", "items": { "type": "string" } },
    "impact_on_autonomy": { "type": "string" },
    "impact_on_relationship": { "type": "string" },
    "awareness": { "type": "string", "enum": ["unconscious", "partially_aware", "fully_aware", "actively_working_on"] },
    "attempts_to_reduce": { "type": "array", "items": { "type": "string" } },
    "progress": { "type": "string", "enum": ["none", "minimal", "moderate", "significant"] },
    "what_would_help": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "dependency_name", "dependency_type"],
  "_phase1_todo": [
    "Define dependency health assessment",
    "Define codependency pattern detection",
    "Define healthy autonomy building plan"
  ]
}
