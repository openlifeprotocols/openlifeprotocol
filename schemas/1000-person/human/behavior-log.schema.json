{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Behavior Log",
  "description": "A behavior log entry — documented instance of behavior, action taken, context and outcomes.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^behavior_log_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "behavior_date": { "type": "string", "format": "date" },
    "behavior_time": { "type": "string", "format": "time" },
    "behavior_description": { "type": "string" },
    "behavior_type": { "type": "string", "enum": ["positive", "neutral", "negative", "reactive", "proactive"] },
    "antecedent": { "type": "string" },
    "trigger": { "type": "string" },
    "emotional_state_before": { "type": "string" },
    "context": { "type": "string" },
    "people_involved": { "type": "array", "items": { "type": "string" } },
    "action_taken": { "type": "string" },
    "immediate_consequence": { "type": "string" },
    "emotional_state_after": { "type": "string" },
    "satisfaction_with_response": { "type": "integer", "minimum": 1, "maximum": 10 },
    "would_do_differently": { "type": "boolean" },
    "alternative_responses": { "type": "array", "items": { "type": "string" } },
    "pattern_recognized": { "type": "string" },
    "learning": { "type": "string" },
    "linked_habit_id": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "behavior_date", "behavior_description"],
  "_phase1_todo": [
    "Define behavior pattern clustering",
    "Define trigger-response mapping",
    "Define behavior change protocol tracking"
  ]
}
