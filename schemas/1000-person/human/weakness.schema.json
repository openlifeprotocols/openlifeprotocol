{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weakness",
  "description": "A personal weakness — limitation, area of difficulty, capability gap, what I struggle with.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^weakness_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "weakness_name": { "type": "string" },
    "description": { "type": "string" },
    "weakness_type": { "type": "string", "enum": ["skill_gap", "knowledge_gap", "trait_challenge", "limiting_belief", "capability_limitation"] },
    "domain": { "type": "string" },
    "severity": { "type": "string", "enum": ["minor", "moderate", "significant", "critical"] },
    "impact": { "type": "string" },
    "contexts_where_manifests": { "type": "array", "items": { "type": "string" } },
    "origin": { "type": "string" },
    "acknowledged_since": { "type": "string", "format": "date" },
    "acceptance_level": { "type": "string", "enum": ["denial", "acknowledgment", "acceptance", "active_management"] },
    "attempts_to_improve": { "type": "array", "items": { "type": "string" } },
    "progress": { "type": "string", "enum": ["none", "minimal", "moderate", "significant", "resolved"] },
    "workarounds_used": { "type": "array", "items": { "type": "string" } },
    "delegation_strategy": { "type": "string" },
    "connected_to_strength": { "type": "string" },
    "irrelevant_to_goals": { "type": "boolean" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "weakness_name"],
  "_phase1_todo": [
    "Define weakness-gap analysis",
    "Define weakness mitigation strategies",
    "Define weakness-compensating strength identification"
  ]
}
