{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Film Review",
  "description": "Review and critique of film or TV show.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^film_review_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "content_id": { "type": "string" },
    "content_type": { "type": "string", "enum": ["movie", "tv_show", "episode"] },
    "title": { "type": "string" },
    "review_date": { "type": "string", "format": "date" },
    "rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "review_text": { "type": "string" },
    "spoiler_warning": { "type": "boolean" },
    "pros": { "type": "array", "items": { "type": "string" } },
    "cons": { "type": "array", "items": { "type": "string" } },
    "would_recommend": { "type": "boolean" },
    "rewatch_value": { "type": "string", "enum": ["low", "medium", "high"] },
    "favorite_scenes": { "type": "array", "items": { "type": "string" } },
    "is_published": { "type": "boolean" },
    "publication_url": { "type": "string", "format": "uri" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "title"],
  "_phase1_todo": ["Define review publishing", "Define community ratings", "Define spoiler management"]
}
