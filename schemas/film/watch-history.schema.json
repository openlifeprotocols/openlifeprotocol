{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Watch History",
  "description": "Record of film/TV viewing activity.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^watch_history_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "person_id": { "type": "string" },
    "content_id": { "type": "string" },
    "content_type": { "type": "string", "enum": ["movie", "tv_episode", "special"] },
    "title": { "type": "string" },
    "watch_date": { "type": "string", "format": "date-time" },
    "platform": { "type": "string", "enum": ["netflix", "amazon_prime", "disney_plus", "hbo", "cinema", "dvd", "other"] },
    "device": { "type": "string" },
    "location": { "type": "string" },
    "companions": { "type": "array", "items": { "type": "string" } },
    "completed": { "type": "boolean" },
    "watch_duration_minutes": { "type": "integer" },
    "rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "mood_before": { "type": "string" },
    "mood_after": { "type": "string" },
    "was_enjoyable": { "type": "boolean" },
    "rewatch": { "type": "boolean" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "person_id", "title"],
  "_phase1_todo": ["Define streaming sync", "Define mood correlation", "Define recommendation engine"]
}
