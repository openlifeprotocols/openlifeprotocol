{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Episode",
  "description": "Television episode.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^episode_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "show_id": { "type": "string" },
    "show_title": { "type": "string" },
    "season_number": { "type": "integer" },
    "episode_number": { "type": "integer" },
    "episode_title": { "type": "string" },
    "air_date": { "type": "string", "format": "date" },
    "runtime_minutes": { "type": "integer" },
    "directors": { "type": "array", "items": { "type": "string" } },
    "writers": { "type": "array", "items": { "type": "string" } },
    "description": { "type": "string" },
    "imdb_rating": { "type": "number", "minimum": 0, "maximum": 10 },
    "user_rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "watched": { "type": "boolean" },
    "watch_date": { "type": "string", "format": "date" },
    "rewatch_count": { "type": "integer" },
    "favorite_episode": { "type": "boolean" },
    "notes": { "type": "string" },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "show_title"],
  "_phase1_todo": ["Define watch tracking", "Define episode sequencing", "Define review integration"]
}
