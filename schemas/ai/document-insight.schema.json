{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document Insight",
  "description": "AI-generated insights about document.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^document_insight_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "document_id": { "type": "string" },
    "insight_type": { "type": "string", "enum": ["action_required", "risk_identified", "opportunity", "anomaly", "recommendation", "pattern", "correlation"] },
    "insight_title": { "type": "string" },
    "insight_description": { "type": "string" },
    "priority_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "related_entities": { "type": "array", "items": { "type": "string" } },
    "suggested_actions": { "type": "array", "items": { "type": "string" } },
    "confidence_score": { "type": "number" },
    "generation_model": { "type": "string" },
    "generation_date": { "type": "string", "format": "date-time" },
    "is_user_acknowledged": { "type": "boolean" },
    "user_action_taken": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "document_id"],
  "_phase1_todo": ["Define insight templates", "Define insight ranking", "Define insight notifications"]
}
