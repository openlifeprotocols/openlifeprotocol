{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collection Item",
  "description": "Individual item in a collection.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^collection_item_[a-zA-Z0-9_-]+$" },
    "uuid": { "type": "string", "format": "uuid" },
    "collection_id": { "type": "string" },
    "collection_type": { "type": "string" },
    "item_name": { "type": "string" },
    "item_description": { "type": "string" },
    "artist_creator": { "type": "string" },
    "manufacturer": { "type": "string" },
    "year_released": { "type": "integer" },
    "release_date": { "type": "string", "format": "date" },
    "edition_info": { "type": "string" },
    "rarity": { "type": "string", "enum": ["common", "uncommon", "rare", "very_rare", "ultra_rare"] },
    "condition": { "type": "string", "enum": ["poor", "fair", "good", "very_good", "mint", "sealed"] },
    "acquisition_date": { "type": "string", "format": "date" },
    "acquisition_price": { "type": "number" },
    "current_value": { "type": "number" },
    "currency": { "type": "string" },
    "serial_number": { "type": "string" },
    "catalog_number": { "type": "string" },
    "location_in_collection": { "type": "string" },
    "photos": { "type": "array", "items": { "type": "string" } },
    "document_id": { "type": "string" },
    "provenance": { "type": "string" },
    "authenticity_verified": { "type": "boolean" },
    "certification_url": { "type": "string", "format": "uri" },
    "notes": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_date": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["id", "uuid", "collection_id", "item_name"],
  "_phase1_todo": ["Define item cataloging", "Define valuation tracking", "Define condition monitoring"]
}
